{%- comment -%}
  E-sellers Testimonials Masonry - E-sellers One (v5.0.0)

  Testimonial quotes laid out in a CSS multi-column masonry (cards flow top to
  bottom then wrap to the next column, so mixed-length quotes tile tightly
  instead of leaving ragged row gaps).
{%- endcomment -%}

{%- liquid
  assign es_tm_cards = section.blocks | where: 'type', 'testimonial'
-%}

{%- if es_tm_cards.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --es-tmm-cols: {{ section.settings.columns_desktop | default: 3 }};
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #shopify-section-{{ section.id }} .es-tmm__masonry {
      column-count: 1;
      column-gap: {{ section.settings.column_gap | default: 20 }}px;
    }
    @media screen and (min-width: 600px) {
      #shopify-section-{{ section.id }} .es-tmm__masonry { column-count: 2; }
    }
    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .es-tmm__masonry { column-count: var(--es-tmm-cols); }
    }

    #shopify-section-{{ section.id }} .es-tmm__card {
      break-inside: avoid;
      margin-bottom: {{ section.settings.row_gap | default: 20 }}px;
      background: var(--es-surface);
      border-radius: var(--es-radius-lg);
      padding: var(--es-space-5);
      display: flex;
      flex-direction: column;
      gap: var(--es-space-3);
    }

    #shopify-section-{{ section.id }} .es-tmm__stars { display: flex; gap: 2px; color: #f5a623; }
    #shopify-section-{{ section.id }} .es-tmm__stars svg { width: 14px; height: 14px; }
    #shopify-section-{{ section.id }} .es-tmm__quote { font-size: var(--es-text-base); line-height: var(--es-leading-relaxed); }
    #shopify-section-{{ section.id }} .es-tmm__author-row { display: flex; align-items: center; gap: var(--es-space-2); }
    #shopify-section-{{ section.id }} .es-tmm__avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    #shopify-section-{{ section.id }} .es-tmm__author { font-weight: 650; font-size: var(--es-text-sm); }
    #shopify-section-{{ section.id }} .es-tmm__bio { font-size: var(--es-text-xs); color: var(--es-fg-muted); }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.heading_alignment -%}

    <div class="es-tmm__masonry">
      {%- for block in es_tm_cards -%}
        <div class="es-tmm__card" {{ block.shopify_attributes }}>
          {%- assign es_tmm_rating = block.settings.rating | default: 5 -%}
          <span class="es-tmm__stars" role="img" aria-label="{{ es_tmm_rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="{% if i > es_tmm_rating %}opacity:.25;{% endif %}"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
            {%- endfor -%}
          </span>
          {%- if block.settings.text != blank -%}
            <div class="es-tmm__quote">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <div class="es-tmm__author-row">
              {%- if block.settings.avatar != blank -%}
                {%- assign es_tmm_alt = block.settings.author | escape -%}
                {{ block.settings.avatar | image_url: width: 80 | image_tag: class: 'es-tmm__avatar', loading: 'lazy', alt: es_tmm_alt }}
              {%- endif -%}
              <div>
                <div class="es-tmm__author">{{ block.settings.author | escape }}</div>
                {%- if block.settings.bio != blank -%}<div class="es-tmm__bio">{{ block.settings.bio | escape }}</div>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add testimonial blocks to populate this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Testimonials Masonry",
  "tag": "section",
  "class": "shopify-section--es-testimonials-masonry",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [{ "value": "start", "label": "Left" }, { "value": "center", "label": "Center" }],
      "default": "center"
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "row_gap", "label": "Row gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "richtext", "id": "text", "label": "Quote", "default": "<p>This product changed the way we shop.</p>" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "bio", "label": "Bio / role" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "E-sellers Testimonials Masonry",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
