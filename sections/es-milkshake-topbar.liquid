{% render 'es-section-style', section: section %}

<style>
  #Topbar-{{ section.id }} {
    --tb-bg: {{ section.settings.topbar_bg | default: '#1f1d1b' }};
    --tb-text: {{ section.settings.topbar_text_color | default: '#ffffff' }};
    --tb-muted: {{ section.settings.topbar_muted_color | default: '#a8a29e' }};
    --tb-hover: {{ section.settings.topbar_hover_color | default: '#ffffff' }};
    --tb-py: {{ section.settings.padding_vertical | default: 6 }}px;
    --tb-font-size: {{ section.settings.font_size | default: '11px' }};
    --tb-letter-spacing: {{ section.settings.letter_spacing | default: '0.15em' }};
    background-color: var(--tb-bg);
    color: var(--tb-text);
  }

  #Topbar-{{ section.id }} a,
  #Topbar-{{ section.id }} button {
    color: inherit;
    transition: color 0.2s ease;
  }

  #Topbar-{{ section.id }} a:hover,
  #Topbar-{{ section.id }} button:hover {
    color: var(--tb-hover);
  }

  #Topbar-{{ section.id }} .tb-divider {
    color: var(--tb-muted);
    opacity: 0.5;
  }

  /* Marquee animation */
  @keyframes es-tb-marquee-anim {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  #Topbar-{{ section.id }} .es-tb-marquee-track {
    display: inline-flex;
    white-space: nowrap;
    animation: es-tb-marquee-anim {{ section.settings.marquee_speed | default: 25 }}s linear infinite;
  }

  {% if section.settings.pause_on_hover %}
    #Topbar-{{ section.id }}:hover .es-tb-marquee-track {
      animation-play-state: paused;
    }
  {% endif %}
</style>

<div id="Topbar-{{ section.id }}" class="section-{{ section.id }}-settings text-on-primary py-[var(--tb-py)] overflow-hidden">
  <div class="{% if section.settings.container_width == 'full' %}w-full px-4 sm:px-6 lg:px-8{% elsif section.settings.container_width == 'narrow' %}max-w-[1000px] mx-auto px-margin{% else %}max-w-[1440px] mx-auto px-margin{% endif %} flex items-center justify-between font-label-sm text-[var(--tb-font-size)] tracking-[var(--tb-letter-spacing)] {% if section.settings.text_transform == 'uppercase' %}uppercase{% elsif section.settings.text_transform == 'none' %}normal-case{% endif %}">
    
    <!-- Desktop / Tablet Announcements -->
    {% if section.settings.announcement_mode == 'marquee' %}
      <!-- Full Marquee Bar Mode -->
      <div class="relative overflow-hidden w-full flex-1 mr-4">
        <div class="es-tb-marquee-track flex items-center gap-space-xl text-[var(--tb-muted)]">
          {% for i in (1..2) %}
            <div class="flex items-center gap-space-lg shrink-0">
              {% if section.blocks.size > 0 %}
                {% for block in section.blocks %}
                  {% if forloop.index > 1 %}
                    <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
                  {% endif %}
                  <div class="inline-flex items-center gap-1.5" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != 'none' and block.settings.icon != blank %}
                      <span class="material-symbols-outlined text-[14px]">{{ block.settings.icon }}</span>
                    {% endif %}
                    {% if block.settings.highlight_badge != blank %}
                      <span class="bg-primary-container text-on-primary-container px-1.5 py-0.2 rounded text-[9px] font-bold">{{ block.settings.highlight_badge }}</span>
                    {% endif %}
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                    {% else %}
                      <span>{{ block.settings.text }}</span>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                {% if section.settings.shipping_text != blank %}
                  <span class="inline-flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                    {{ section.settings.shipping_text }}
                  </span>
                {% endif %}
                {% if section.settings.delivery_text != blank %}
                  <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
                  <span class="inline-flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[14px]">verified</span>
                    {{ section.settings.delivery_text }}
                  </span>
                {% endif %}
                {% if section.settings.chat_text != blank %}
                  <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
                  <a class="inline-flex items-center gap-1.5" href="{{ section.settings.chat_link | default: '#' }}">
                    <span class="material-symbols-outlined text-[14px]">support_agent</span>
                    {{ section.settings.chat_text }}
                  </a>
                {% endif %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <!-- Standard Static List Mode -->
      <div class="{% if section.settings.mobile_behavior == 'hide' %}hidden md:flex{% elsif section.settings.mobile_behavior == 'first_only' %}flex [&>*:nth-child(n+3)]:hidden md:[&>*:nth-child(n+3)]:flex{% else %}flex overflow-x-auto no-scrollbar{% endif %} items-center gap-space-lg text-[var(--tb-muted)]">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if forloop.index > 1 %}
              <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
            {% endif %}
            <div class="inline-flex items-center gap-1.5 shrink-0" {{ block.shopify_attributes }}>
              {% if block.settings.icon != 'none' and block.settings.icon != blank %}
                <span class="material-symbols-outlined text-[14px]">{{ block.settings.icon }}</span>
              {% endif %}
              {% if block.settings.highlight_badge != blank %}
                <span class="bg-primary-container text-on-primary-container px-1.5 py-0.2 rounded text-[9px] font-bold">{{ block.settings.highlight_badge }}</span>
              {% endif %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {% else %}
                <span>{{ block.settings.text }}</span>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          {% if section.settings.shipping_text != blank %}
            <span class="shrink-0">{{ section.settings.shipping_text }}</span>
          {% endif %}
          {% if section.settings.delivery_text != blank %}
            <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
            <span class="shrink-0">{{ section.settings.delivery_text }}</span>
          {% endif %}
          {% if section.settings.chat_text != blank %}
            <span class="tb-divider">{{ section.settings.divider_char | default: '•' }}</span>
            <a class="shrink-0" href="{{ section.settings.chat_link | default: '#' }}">
              {{ section.settings.chat_text }}
            </a>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}

    <!-- Right Side Utilities (Currency & Language) -->
    <div class="flex items-center gap-space-md ml-auto shrink-0">
      {% if section.settings.show_currency and section.settings.currency_text != blank %}
        <button type="button" class="transition-colors cursor-pointer bg-transparent border-0 p-0">
          {{ section.settings.currency_text }}
        </button>
      {% endif %}
      {% if section.settings.show_lang and section.settings.lang_text != blank %}
        {% if section.settings.show_currency and section.settings.currency_text != blank %}
          <span class="tb-divider">|</span>
        {% endif %}
        <button type="button" class="transition-colors cursor-pointer bg-transparent border-0 p-0">
          {{ section.settings.lang_text }}
        </button>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Milkshake Topbar",
  "tag": "section",
  "class": "es-milkshake-topbar-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Announcements"
    },
    {
      "type": "select",
      "id": "announcement_mode",
      "label": "Announcement display mode",
      "options": [
        {
          "value": "static",
          "label": "Static list"
        },
        {
          "value": "marquee",
          "label": "Scrolling ticker (Marquee)"
        }
      ],
      "default": "static"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee scroll duration",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause marquee on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_char",
      "label": "Item divider symbol",
      "options": [
        {
          "value": "•",
          "label": "Bullet (•)"
        },
        {
          "value": "|",
          "label": "Pipe (|)"
        },
        {
          "value": "/",
          "label": "Slash (/)"
        },
        {
          "value": "–",
          "label": "En dash (–)"
        }
      ],
      "default": "•"
    },
    {
      "type": "select",
      "id": "mobile_behavior",
      "label": "Mobile display behavior",
      "options": [
        {
          "value": "hide",
          "label": "Hide announcements on mobile"
        },
        {
          "value": "first_only",
          "label": "Show primary announcement only"
        },
        {
          "value": "scroll",
          "label": "Horizontal swipeable list"
        }
      ],
      "default": "hide"
    },
    {
      "type": "paragraph",
      "content": "Add Announcement blocks below to override the default text items."
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping announcement (Default)",
      "default": "FREE Shipping above 2499 EGP"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery announcement (Default)",
      "default": "Express Delivery Egypt"
    },
    {
      "type": "text",
      "id": "chat_text",
      "label": "Chat link label (Default)",
      "default": "Chat with Specialist"
    },
    {
      "type": "url",
      "id": "chat_link",
      "label": "Chat link"
    },
    {
      "type": "header",
      "content": "Utilities (Right side)"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_text",
      "label": "Currency label",
      "default": "EGP (ج.م)"
    },
    {
      "type": "checkbox",
      "id": "show_lang",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "text",
      "id": "lang_text",
      "label": "Language label",
      "default": "العربية"
    },
    {
      "type": "header",
      "content": "Styling and Colors"
    },
    {
      "type": "color",
      "id": "topbar_bg",
      "label": "Bar background color",
      "default": "#1f1d1b"
    },
    {
      "type": "color",
      "id": "topbar_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "topbar_muted_color",
      "label": "Muted text & divider color",
      "default": "#a8a29e"
    },
    {
      "type": "color",
      "id": "topbar_hover_color",
      "label": "Link hover color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 8
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Font size",
      "options": [
        {
          "value": "10px",
          "label": "Extra Small (10px)"
        },
        {
          "value": "11px",
          "label": "Small (11px)"
        },
        {
          "value": "12px",
          "label": "Medium (12px)"
        }
      ],
      "default": "11px"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "0.05em",
          "label": "Normal"
        },
        {
          "value": "0.1em",
          "label": "Wider"
        },
        {
          "value": "0.15em",
          "label": "Widest"
        }
      ],
      "default": "0.15em"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "none",
          "label": "Standard (as typed)"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Responsive Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS rules",
      "info": "Write CSS targeting #Topbar-{{ section.id }} or child classes"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Complimentary Salon Consultation on orders over 1500 EGP"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (optional)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "local_shipping",
              "label": "Shipping Truck"
            },
            {
              "value": "verified",
              "label": "Verified Badge"
            },
            {
              "value": "support_agent",
              "label": "Headset / Support"
            },
            {
              "value": "percent",
              "label": "Discount / Percent"
            },
            {
              "value": "sparkles",
              "label": "Sparkles / Luxury"
            },
            {
              "value": "star",
              "label": "Star / Award"
            }
          ],
          "default": "sparkles"
        },
        {
          "type": "text",
          "id": "highlight_badge",
          "label": "Highlight badge (e.g. NEW, GIFT)",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Milkshake Topbar"
    }
  ]
}
{% endschema %}
