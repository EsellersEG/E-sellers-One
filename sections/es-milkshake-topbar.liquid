{% render 'es-section-style', section: section %}
<div class="bg-primary text-on-primary py-space-xs section-{{ section.id }}-settings">
  <div class="max-w-[1440px] mx-auto px-margin flex items-center justify-between font-label-sm text-label-sm tracking-widest uppercase">
    <div class="hidden md:flex items-center gap-space-lg text-neutral-300">
      {%- if section.settings.shipping_text != blank -%}
        <span>{{ section.settings.shipping_text }}</span>
      {%- endif -%}
      {%- if section.settings.delivery_text != blank -%}
        <span class="opacity-40">•</span>
        <span>{{ section.settings.delivery_text }}</span>
      {%- endif -%}
      {%- if section.settings.chat_text != blank -%}
        <span class="opacity-40">•</span>
        <a class="hover:text-on-primary transition-colors" href="{{ section.settings.chat_link | default: '#' }}">
          {{ section.settings.chat_text }}
        </a>
      {%- endif -%}
    </div>
    <div class="flex items-center gap-space-md ml-auto">
      {%- if section.settings.currency_text != blank -%}
        <button type="button" class="hover:text-neutral-300 transition-colors">
          {{ section.settings.currency_text }}
        </button>
      {%- endif -%}
      {%- if section.settings.lang_text != blank -%}
        <span class="opacity-40">|</span>
        <button type="button" class="hover:text-neutral-300 transition-colors">
          {{ section.settings.lang_text }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Milkshake Topbar",
  "tag": "section",
  "class": "es-milkshake-topbar-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping announcement",
      "default": "FREE Shipping above 2499 EGP"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery announcement",
      "default": "Express Delivery Egypt"
    },
    {
      "type": "text",
      "id": "chat_text",
      "label": "Chat link label",
      "default": "Chat with Specialist"
    },
    {
      "type": "url",
      "id": "chat_link",
      "label": "Chat link"
    },
    {
      "type": "text",
      "id": "currency_text",
      "label": "Currency label",
      "default": "EGP (ج.م)"
    },
    {
      "type": "text",
      "id": "lang_text",
      "label": "Language label",
      "default": "العربية"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors and Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Border and Radius"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Desktop)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Mobile and Tablet)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS rules",
      "info": "Write CSS targeting .section-{{ section.id }}-settings or child classes"
    }
  ],
  "presets": [
    {
      "name": "Milkshake Topbar"
    }
  ]
}
{% endschema %}
