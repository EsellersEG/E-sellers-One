{%- comment -%}
  E-sellers Newsletter Popup Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- unless request.page_type == 'captcha' or section.settings.show_only_on_index and request.page_type != 'index' -%}
  {%- unless section.settings.show_only_for_visitors and customer -%}

    {%- style -%}
      .es-popup-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(6px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
        opacity: 0;
        transition: opacity 0.35s ease;
      }

      .es-popup-backdrop.is-visible {
        display: flex;
        opacity: 1;
      }

      .es-popup-card {
        max-width: 520px;
        width: 100%;
        background-color: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.25);
        border: 1px solid #e2e8f0;
        position: relative;
        transform: translateY(20px) scale(0.96);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
      }

      .es-popup-backdrop.is-visible .es-popup-card {
        transform: translateY(0) scale(1);
      }

      .es-popup-close-btn {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        border: 1px solid #e2e8f0;
        color: #0f172a;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .es-popup-close-btn:hover {
        background: #ffffff;
        transform: scale(1.08);
      }

      .es-popup-media {
        width: 100%;
        max-height: 220px;
        overflow: hidden;
        background: #f1f5f9;
      }

      .es-popup-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .es-popup-content {
        padding: 32px 28px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .es-popup-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
      }

      .es-popup-subtext {
        font-size: 0.95rem;
        line-height: 1.55;
        color: #64748b;
        margin: 0;
      }

      .es-popup-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 4px;
      }

      .es-popup-input {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #0f172a;
        outline: none;
        box-sizing: border-box;
        text-align: center;
        transition: border-color 0.2s ease;
      }

      .es-popup-input:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
      }

      .es-popup-submit {
        width: 100%;
        padding: 14px 20px;
        background-color: #0f172a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.2s ease, transform 0.2s ease;
      }

      .es-popup-submit:hover {
        background-color: #1e293b;
        transform: translateY(-1px);
      }

      .es-popup-success {
        padding: 16px;
        border-radius: 8px;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        font-weight: 600;
        font-size: 0.95rem;
      }

      .es-popup-error {
        padding: 12px;
        border-radius: 8px;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 0.85rem;
      }
    {%- endstyle -%}

    <div
      id="EsNewsletterPopup-{{ section.id }}"
      class="es-popup-backdrop"
      data-delay="{{ section.settings.apparition_delay | default: 5 }}"
      data-only-once="{{ section.settings.show_only_once }}"
      role="dialog"
      aria-modal="true"
    >
      <div class="es-popup-card">
        <button type="button" class="es-popup-close-btn" aria-label="Close popup" onclick="closeEsNewsletterPopup('{{ section.id }}')">
          &times;
        </button>

        {%- if section.settings.image != blank -%}
          <div class="es-popup-media">
            {%- assign es_tagarg_1 = section.settings.title | default: 'Newsletter' | escape -%}{{ section.settings.image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              alt: es_tagarg_1}}
          </div>
        {%- endif -%}

        <div class="es-popup-content">
          {%- if section.settings.title != blank -%}
            <h2 class="es-popup-title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.subtext != blank -%}
            <p class="es-popup-subtext">{{ section.settings.subtext }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'es-popup-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              <div class="es-popup-success" role="status">
                {{ 'general.newsletter.subscribed_successfully' | t | default: 'Thank you for subscribing! Check your inbox for exclusive perks.' }}
              </div>
              <script>
                localStorage.setItem('es-newsletter-subscribed', 'true');
              </script>
            {%- else -%}
              {%- if form.errors -%}
                <div class="es-popup-error" role="alert">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </div>
              {%- endif -%}

              <input
                type="email"
                name="contact[email]"
                class="es-popup-input"
                placeholder="{{ 'general.newsletter.email_placeholder' | t | default: 'Enter your email address' }}"
                value="{{ form.email | default: customer.email }}"
                autocomplete="email"
                required
              >

              <button type="submit" class="es-popup-submit">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span>{{ section.settings.button_text | default: 'Subscribe & Save' }}</span>
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>

    <script>
      (function() {
        const popupId = 'EsNewsletterPopup-{{ section.id }}';
        const popupEl = document.getElementById(popupId);
        if (!popupEl) return;

        const onlyOnce = popupEl.getAttribute('data-only-once') === 'true';
        const delaySec = parseInt(popupEl.getAttribute('data-delay') || '5', 10);

        if (onlyOnce && (localStorage.getItem('es-newsletter-dismissed') === 'true' || localStorage.getItem('es-newsletter-subscribed') === 'true')) {
          return;
        }

        window.closeEsNewsletterPopup = function(secId) {
          const el = document.getElementById('EsNewsletterPopup-' + secId);
          if (el) {
            el.classList.remove('is-visible');
            if (onlyOnce) {
              localStorage.setItem('es-newsletter-dismissed', 'true');
            }
          }
        };

        // Close on clicking backdrop outside card
        popupEl.addEventListener('click', function(e) {
          if (e.target === popupEl) {
            window.closeEsNewsletterPopup('{{ section.id }}');
          }
        });

        // Close on ESC
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            window.closeEsNewsletterPopup('{{ section.id }}');
          }
        });

        // Open after timer
        setTimeout(() => {
          popupEl.classList.add('is-visible');
        }, delaySec * 1000);
      })();
    </script>

  {%- endunless -%}
{%- endunless -%}

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "shopify-section--popup",
  "settings": [
    {
      "type": "paragraph",
      "content": "Subscribed visitors are automatically tagged with 'newsletter' in your Shopify admin."
    },
    {
      "type": "range",
      "id": "apparition_delay",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Delay before popup appears",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_only_on_index",
      "label": "Show only on homepage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_for_visitors",
      "label": "Disable for logged-in accounts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_once",
      "label": "Show once per visitor (uses browser storage)",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup header image",
      "info": "1000 x 600px recommended"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Get 15% Off Your First Order"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext description",
      "default": "Join our VIP club for exclusive early drops, special private sales, and member discounts."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Unlock My 15% Off"
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
