      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Image corner radius",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "image_hover_zoom",
      "label": "Enable subtle image hover zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ambient_shape",
      "label": "Show ambient decorative background shape",
      "default": true
    },
    {
