      "default": "split"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left aligned"
        },
        {
          "value": "center",
          "label": "Center aligned"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "hero_min_height",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Minimum section height",
      "default": 600
