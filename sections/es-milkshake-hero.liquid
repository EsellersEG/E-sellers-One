      "label": "Floating Card Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "floating_card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Floating Card Corner Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Editorial Content"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show eyebrow badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_icon",
