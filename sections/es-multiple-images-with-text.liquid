{%- comment -%}
  E-sellers Multiple Images with Text Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    color: {{ section.settings.text_color | default: '#0f172a' }};
  }

  .es-multi-img-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .es-multi-img-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* Image Visual Area */
  .es-multi-img-media-box {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Layout Modes */
  .es-multi-img-card {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 36px -4px rgba(0, 0, 0, 0.12);
    border: 1px solid #e2e8f0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .es-multi-img-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Stacked Layout */
  .es-layout-stacked .es-multi-img-card {
    position: absolute;
    width: 75%;
    aspect-ratio: 4 / 5;
  }

  .es-layout-stacked .es-multi-img-card:nth-child(1) {
    transform: rotate(-3deg) scale(0.95);
    z-index: 1;
    top: 10px;
    left: 10px;
  }

  .es-layout-stacked .es-multi-img-card:nth-child(2) {
    transform: rotate(2deg) scale(0.98);
    z-index: 2;
    top: 20px;
    right: 15px;
  }

  .es-layout-stacked .es-multi-img-card:nth-child(3) {
    transform: rotate(0deg) scale(1);
    z-index: 3;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .es-layout-stacked .es-multi-img-card.is-active {
    z-index: 10 !important;
    transform: scale(1.03) !important;
    box-shadow: 0 20px 48px -4px rgba(0, 0, 0, 0.2);
  }

  /* Collage Layout */
  .es-layout-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
  }

  .es-layout-collage .es-multi-img-card {
    aspect-ratio: 4 / 5;
    position: static;
  }

  .es-layout-collage .es-multi-img-card:nth-child(2) {
    margin-top: 32px;
  }

  /* Content Column */
  .es-multi-img-content-box {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .es-multi-img-slide {
    display: none;
    flex-direction: column;
    gap: 16px;
    animation: esFadeIn 0.35s ease forwards;
  }

  .es-multi-img-slide.is-active {
    display: flex;
  }

  @keyframes esFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .es-multi-img-subheading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: #64748b;
    margin: 0;
  }

  .es-multi-img-heading {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: inherit;
  }

  .es-multi-img-body {
    font-size: 1rem;
    line-height: 1.65;
    opacity: 0.85;
    margin: 0;
  }

  .es-multi-img-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 28px;
    border-radius: 8px;
    background-color: {{ section.settings.button_background | default: '#0f172a' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    align-self: flex-start;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .es-multi-img-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Navigation Controls */
  .es-multi-img-nav {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .es-multi-img-nav__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .es-multi-img-nav__btn:hover {
    background-color: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .es-multi-img-dots {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .es-multi-img-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #cbd5e1;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .es-multi-img-dot.is-active {
    width: 24px;
    background: #0f172a;
  }
{%- endstyle -%}

<div class="{% if section.settings.full_width %}page-width-full{% else %}page-width{% endif %}">
  <div class="es-multi-img-wrap" id="MultiImgSection-{{ section.id }}">
    
    <!-- Visual Images Box -->
    <div class="es-multi-img-media-box es-layout-{{ section.settings.images_layout | default: 'stacked' }}">
      {%- for block in section.blocks -%}
        <div
          class="es-multi-img-card {% if forloop.first %}is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          style="{% if section.settings.images_layout == 'scattered' %}transform: rotate({{ block.settings.image_rotation_degrees | default: 0 }}deg);{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- assign es_tagarg_1 = block.settings.title | default: 'Feature image' | escape -%}{{ block.settings.image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              alt: es_tagarg_1}}
          {%- else -%}
            <div style="background: #e2e8f0; aspect-ratio: 4/5; display: flex; align-items: center; justify-content: center; color: #64748b;">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Content Story Slides -->
    <div class="es-multi-img-content-box">
      {%- for block in section.blocks -%}
        <div class="es-multi-img-slide {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
          {%- if block.settings.subheading != blank -%}
            <p class="es-multi-img-subheading">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h2 class="es-multi-img-heading">{{ block.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if block.settings.content != blank -%}
            <div class="es-multi-img-body">
              {{ block.settings.content }}
            </div>
          {%- endif -%}

          {%- if block.settings.button_text != blank -%}
            <a href="{{ block.settings.button_url | default: '#' }}" class="es-multi-img-btn">
              {{ block.settings.button_text | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <div class="es-multi-img-nav">
          <button type="button" class="es-multi-img-nav__btn" onclick="switchMultiImgSlide('{{ section.id }}', -1)" aria-label="Previous slide">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          
          <div class="es-multi-img-dots">
            {%- for block in section.blocks -%}
              <span class="es-multi-img-dot {% if forloop.first %}is-active{% endif %}" onclick="goToMultiImgSlide('{{ section.id }}', {{ forloop.index0 }})"></span>
            {%- endfor -%}
          </div>

          <button type="button" class="es-multi-img-nav__btn" onclick="switchMultiImgSlide('{{ section.id }}', 1)" aria-label="Next slide">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  (function() {
    let currentIndices = {};

    window.goToMultiImgSlide = function(sectionId, index) {
      const container = document.getElementById('MultiImgSection-' + sectionId);
      if (!container) return;

      const slides = container.querySelectorAll('.es-multi-img-slide');
      const cards = container.querySelectorAll('.es-multi-img-card');
      const dots = container.querySelectorAll('.es-multi-img-dot');

      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      currentIndices[sectionId] = index;

      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      cards.forEach((c, i) => c.classList.toggle('is-active', i === index));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
    };

    window.switchMultiImgSlide = function(sectionId, delta) {
      const current = currentIndices[sectionId] || 0;
      window.goToMultiImgSlide(sectionId, current + delta);
    };
  })();
</script>

{% schema %}
{
  "name": "Multiple images with text",
  "tag": "section",
  "class": "shopify-section--multiple-images-with-text",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "images_layout",
      "label": "Images layout style",
      "options": [
        { "value": "stacked", "label": "Stacked Depth" },
        { "value": "collage", "label": "Collage Grid" },
        { "value": "scattered", "label": "Scattered Angles" }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Story item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_rotation_degrees",
          "min": -15,
          "max": 15,
          "step": 0.5,
          "unit": "deg",
          "label": "Image rotation",
          "default": 0
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Feature highlight"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Engineered For Durability"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Description",
          "default": "<p>Discover the high performance materials and artisanal precision that go into crafting every single piece.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multiple images with text",
      "blocks": [
        { "type": "item", "settings": { "title": "Precision Craftsmanship", "image_rotation_degrees": -3 } },
        { "type": "item", "settings": { "title": "Sustainable Materials", "image_rotation_degrees": 2 } }
      ]
    }
  ]
}
{% endschema %}
