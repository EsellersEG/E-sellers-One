{%- comment -%}
  E-sellers Header Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

<style>
  /* Base Header & Layout Styles */
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75% !important;
      transition: width 0.25s ease;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
    cursor: pointer;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale, 1));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale, 1));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  /* Header Wrapper & Sticky State */
  .header-wrapper {
    position: relative;
    display: block;
    background-color: var(--color-base-background, #ffffff);
    color: var(--color-base-text, #121212);
    z-index: 100;
  }

  .header-wrapper--border-bottom {
    border-bottom: 1px solid rgba(18, 18, 18, 0.08);
  }

  sticky-header {
    display: block;
  }

  .shopify-section-header-sticky {
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .shopify-section-header-hidden {
    transform: translateY(-100%);
  }

  .animate {
    transition: transform 0.25s ease-in-out, box-shadow 0.25s ease;
  }

  .scrolled-past-header {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  /* Header Grid & Flex Structure */
  .header {
    display: grid;
    grid-template-areas: 'left-icon heading icons';
    grid-template-columns: 1fr 2fr 1fr;
    align-items: center;
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 2rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 2rem;
    margin: 0 auto;
    max-width: var(--page-width, 1360px);
  }

  .header--full-width {
    max-width: 100% !important;
    padding-left: 3rem !important;
    padding-right: 3rem !important;
  }

  .header__heading {
    grid-area: heading;
    justify-self: center;
    margin: 0;
  }

  .header__heading-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .header__heading-logo-wrapper {
    width: {{ section.settings.logo_width | default: 140 }}px;
    display: inline-block;
    transition: width 0.2s ease;
  }

  .header__heading-logo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Header Icons */
  .header__icons {
    grid-area: icons;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.6rem;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: inherit;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .header__icon:hover {
    opacity: 0.7;
  }

  .header__icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .cart-count-bubble {
    position: absolute;
    top: -6px;
    right: -8px;
    background-color: #121212;
    color: #ffffff;
    border-radius: 999px;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 4px;
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Desktop Inline Menu */
  .header__inline-menu {
    display: none;
  }

  /* E-sellers header visual calibration */
  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .header--middle-left {
      grid-template-areas: 'heading navigation icons';
      grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr) !important;
      column-gap: 3.2rem !important;
    }

    .header--middle-left .header__heading {
      grid-area: heading;
      justify-self: start;
    }

    .header--middle-left .header__inline-menu {
      grid-area: navigation;
      display: flex !important;
      justify-content: center !important;
    }

    .header--top-center {
      grid-template-areas: 'left-icon heading icons' 'navigation navigation navigation';
      grid-template-columns: 1fr auto 1fr;
      row-gap: 1.6rem;
    }

    .header--top-center .header__inline-menu {
      grid-area: navigation;
      display: flex !important;
      justify-content: center !important;
    }

    .header .list-menu--inline {
      justify-content: center !important;
      gap: 0.8rem;
    }

    .header__menu-item {
      position: relative;
      font-weight: 700 !important;
      font-size: 1.3rem !important;
      letter-spacing: 0.03em !important;
      color: inherit !important;
      padding: 0.8rem 1.6rem !important;
      transition: opacity 0.2s ease-in-out !important;
      opacity: 1 !important;
      text-decoration: none !important;
      display: inline-flex;
      align-items: center;
    }

    .header__menu-item span {
      text-decoration: none !important;
    }

    .header__menu-item:hover span {
      text-decoration: none !important;
    }

    .header__active-menu-item,
    details[open] > .header__menu-item {
      color: inherit !important;
      text-decoration: none !important;
    }

    .header__menu-item .icon-caret {
      position: static !important;
      margin-left: 0.6rem !important;
      display: inline-block !important;
      vertical-align: middle !important;
      width: 0.8rem !important;
      height: 0.6rem !important;
      transition: transform 0.2s ease-in-out !important;
    }

    details[open] > summary .icon-caret {
      transform: rotate(180deg);
    }

    /* Submenu (Dropdown) styling */
    .header__submenu-wrapper {
      position: relative;
    }

    .header__submenu {
      position: absolute !important;
      top: calc(100% + 0.8rem) !important;
      left: 0;
      width: 24rem !important;
      background-color: #ffffff !important;
      border: 1px solid rgba(18, 18, 18, 0.08) !important;
      border-radius: 8px !important;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06) !important;
      padding: 1.4rem 0 !important;
      z-index: 300;
      list-style: none;
      animation: esHeaderFadeIn 0.2s ease forwards;
    }

    .header__submenu .header__menu-item {
      font-weight: 600 !important;
      font-size: 1.3rem !important;
      color: #121212 !important;
      padding: 1rem 2.2rem !important;
      text-decoration: none !important;
      transition: opacity 0.2s ease-in-out, background-color 0.15s ease !important;
      opacity: 0.75 !important;
      display: flex;
      justify-content: space-between;
    }

    .header__submenu .header__menu-item:hover,
    .header__submenu .header__menu-item.list-menu__item--active {
      opacity: 1 !important;
      background-color: rgba(0, 0, 0, 0.03);
      text-decoration: none !important;
    }

    /* Nested Submenu Level 2 */
    .header__submenu--nested {
      top: 0 !important;
      left: 100% !important;
      margin-left: 0.4rem;
    }

    /* Mega Menu Styling */
    .header__mega-menu {
      position: absolute !important;
      top: 100% !important;
      left: 0 !important;
      width: 100% !important;
      background-color: #ffffff !important;
      border-top: 1px solid rgba(18, 18, 18, 0.08) !important;
      border-bottom: 1px solid rgba(18, 18, 18, 0.08) !important;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08) !important;
      padding: 3.2rem 4rem !important;
      z-index: 300;
      animation: esHeaderFadeIn 0.2s ease forwards;
    }

    .header__mega-menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 3rem;
      max-width: var(--page-width, 1360px);
      margin: 0 auto;
    }

    .header__mega-menu-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: #121212;
      text-decoration: none;
      margin-bottom: 1.2rem;
      display: block;
    }

    .header__mega-menu-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .header__mega-menu-link {
      font-size: 1.3rem;
      font-weight: 500;
      color: #4a5568;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .header__mega-menu-link:hover {
      color: #121212;
    }
  }

  @keyframes esHeaderFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media screen and (pointer: fine) {
    .header__menu-item:hover {
      opacity: 0.7 !important;
    }
  }

  /* Mobile Drawer Styling */
  .es-header-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .es-header-drawer.is-open {
    opacity: 1;
    visibility: visible;
  }

  .es-header-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 380px;
    height: 100%;
    background: #ffffff;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .es-header-drawer.is-open .es-header-drawer__panel {
    transform: translateX(0);
  }

  .es-header-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2.4rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .es-header-drawer__title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    color: #121212;
  }

  .es-header-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    color: #121212;
  }

  .es-header-drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 2rem 2.4rem;
  }

  .es-header-drawer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .es-header-drawer__link {
    font-size: 1.6rem;
    font-weight: 600;
    color: #121212;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0;
  }

  .es-header-drawer__footer {
    padding: 2rem 2.4rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    background: #fafafa;
  }

  /* Search Modal Overlay */
  .es-search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }

  .es-search-modal.is-open {
    display: flex;
  }

  .es-search-modal__box {
    background: #ffffff;
    border-radius: 12px;
    width: 90%;
    max-width: 600px;
    padding: 2.4rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .es-search-modal__form {
    display: flex;
    gap: 1.2rem;
  }

  .es-search-modal__input {
    flex: 1;
    padding: 1.2rem 1.6rem;
    font-size: 1.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    outline: none;
  }

  .es-search-modal__input:focus {
    border-color: #121212;
  }

  .es-search-modal__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: #64748b;
  }
</style>

{%- liquid
  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
-%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }}{% if section.settings.full_width %} header--full-width{% endif %}">
    
    <!-- Mobile Hamburger Drawer Trigger -->
    <header-drawer>
      <button
        type="button"
        class="header__icon header__icon--menu"
        id="HeaderDrawerTrigger"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </header-drawer>

    <!-- Brand Logo -->
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- else -%}
      <div class="header__heading">
    {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {%- assign header_logo = section.settings.logo | default: settings.logo | default: settings.brand_logo -%}
        {%- if header_logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = header_logo.alt | default: shop.name | escape -%}
            {{
              header_logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                width: section.settings.logo_width,
                alt: logo_alt,
                preload: true
            }}
          </div>
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <!-- Desktop Navigation Menu -->
    {%- if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer' -%}
      <nav class="header__inline-menu" aria-label="Primary Navigation">
        <ul class="list-menu list-menu--inline" role="list">
          {%- for link in section.settings.menu.links -%}
            <li class="header__submenu-wrapper">
              {%- if link.links != blank -%}
                {%- if section.settings.menu_type_desktop == 'mega' -%}
                  <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu-details">
                    <summary class="header__menu-item list-menu__item link">
                      <span>{{ link.title | escape }}</span>
                      <svg class="icon-caret" viewBox="0 0 10 6" fill="none" stroke="currentColor">
                        <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="header__mega-menu">
                      <div class="header__mega-menu-grid">
                        {%- for childlink in link.links -%}
                          <div>
                            <a href="{{ childlink.url }}" class="header__mega-menu-title">{{ childlink.title | escape }}</a>
                            {%- if childlink.links != blank -%}
                              <ul class="header__mega-menu-list">
                                {%- for grandchildlink in childlink.links -%}
                                  <li>
                                    <a href="{{ grandchildlink.url }}" class="header__mega-menu-link">{{ grandchildlink.title | escape }}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </details>
                {%- else -%}
                  <details id="Details-HeaderMenu-{{ forloop.index }}">
                    <summary class="header__menu-item list-menu__item link">
                      <span>{{ link.title | escape }}</span>
                      <svg class="icon-caret" viewBox="0 0 10 6" fill="none" stroke="currentColor">
                        <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <ul class="header__submenu" role="list">
                      {%- for childlink in link.links -%}
                        <li>
                          {%- if childlink.links != blank -%}
                            <details id="Details-HeaderSubMenu-{{ forloop.index }}">
                              <summary class="header__menu-item list-menu__item link">
                                <span>{{ childlink.title | escape }}</span>
                                <svg class="icon-caret" viewBox="0 0 10 6" fill="none" stroke="currentColor">
                                  <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </summary>
                              <ul class="header__submenu header__submenu--nested" role="list">
                                {%- for grandchildlink in childlink.links -%}
                                  <li>
                                    <a href="{{ grandchildlink.url }}" class="header__menu-item list-menu__item link">
                                      {{ grandchildlink.title | escape }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </details>
                          {%- else -%}
                            <a href="{{ childlink.url }}" class="header__menu-item list-menu__item link">
                              {{ childlink.title | escape }}
                            </a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- endif -%}
              {%- else -%}
                <a href="{{ link.url }}" class="header__menu-item list-menu__item link">
                  <span>{{ link.title | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <!-- Action Icons -->
    <div class="header__icons">
      <!-- Search Modal Trigger -->
      <button
        type="button"
        class="header__icon header__icon--search"
        id="HeaderSearchTrigger"
        aria-label="Search store"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Customer Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__icon header__icon--account"
          aria-label="Account"
        >
          {%- if section.settings.enable_customer_avatar and customer and customer.has_avatar? -%}
            {{ customer | avatar }}
          {%- else -%}
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          {%- endif -%}
        </a>
      {%- endif -%}

      <!-- Cart Icon with dynamic bubble -->
      <a
        href="{{ routes.cart_url }}"
        class="header__icon header__icon--cart"
        id="cart-icon-bubble"
        aria-label="Shopping Cart"
        {% if settings.cart_type == 'drawer' %}data-cart-drawer-trigger{% endif %}
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <div class="cart-count-bubble" id="CartCountBubble" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          <span aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count | default: 'items in cart' }}</span>
        </div>
      </a>

      <!-- App Blocks -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </header>
</{{ header_tag }}>

<!-- Mobile Navigation Drawer -->
<div class="es-header-drawer" id="HeaderDrawerModal" aria-hidden="true">
  <div class="es-header-drawer__panel">
    <div class="es-header-drawer__header">
      <h2 class="es-header-drawer__title">{{ shop.name }}</h2>
      <button type="button" class="es-header-drawer__close" id="HeaderDrawerClose" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="es-header-drawer__nav">
      {%- if section.settings.menu != blank -%}
        <ul class="es-header-drawer__menu">
          {%- for link in section.settings.menu.links -%}
            <li>
              {%- if link.links != blank -%}
                <details>
                  <summary class="es-header-drawer__link">
                    <span>{{ link.title | escape }}</span>
                    <svg viewBox="0 0 10 6" width="10" height="6" fill="none" stroke="currentColor">
                      <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul style="list-style: none; padding-left: 1.6rem; display: flex; flex-direction: column; gap: 0.8rem; margin-top: 0.8rem;">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}" class="es-header-drawer__link" style="font-size: 1.4rem; font-weight: 500;">
                          {{ childlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="es-header-drawer__link">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <div class="es-header-drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="link" style="text-decoration: none; color: #121212; font-weight: 600; font-size: 1.4rem;">
          {% if customer %}Account{% else %}Log in / Sign up{% endif %}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Search Modal -->
<div class="es-search-modal" id="HeaderSearchModal" aria-hidden="true">
  <div class="es-search-modal__box">
    <button type="button" class="es-search-modal__close" id="HeaderSearchClose" aria-label="Close search">&times;</button>
    <form action="{{ routes.search_url }}" method="get" role="search" class="es-search-modal__form">
      <input
        type="search"
        name="q"
        placeholder="Search for products, brands..."
        class="es-search-modal__input"
        autocomplete="off"
        required
      >
      <button type="submit" class="button" style="background: #121212; color: #ffffff; padding: 0 2rem; border-radius: 8px; border: none; font-weight: 600; cursor: pointer;">
        Search
      </button>
    </form>
  </div>
</div>

<script>
  // Sticky Header Component
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header') || this;
      this.stickyType = this.getAttribute('data-sticky-type') || 'on-scroll-up';
      this.headerIsAlwaysSticky = this.stickyType === 'always' || this.stickyType === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();
      window.addEventListener('resize', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.onScrollHandler = this.onScroll.bind(this);
      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight || 70}px`);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > 100) {
        this.header.classList.add('scrolled-past-header');
      } else {
        this.header.classList.remove('scrolled-past-header');
      }

      if (this.headerIsAlwaysSticky) {
        this.currentScrollTop = scrollTop;
        return;
      }

      if (scrollTop > this.currentScrollTop && scrollTop > 200) {
        // Scrolling Down
        this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
      } else if (scrollTop < this.currentScrollTop && scrollTop > 100) {
        // Scrolling Up
        this.header.classList.remove('shopify-section-header-hidden');
        this.header.classList.add('shopify-section-header-sticky', 'animate');
      } else if (scrollTop <= 50) {
        // Reset at top
        this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
      }

      this.currentScrollTop = scrollTop;
    }
  }

  if (!customElements.get('sticky-header')) {
    customElements.define('sticky-header', StickyHeader);
  }

  // Mobile Drawer & Search Modal Scripts
  document.addEventListener('DOMContentLoaded', () => {
    // Drawer
    const drawerTrigger = document.getElementById('HeaderDrawerTrigger');
    const drawerModal = document.getElementById('HeaderDrawerModal');
    const drawerClose = document.getElementById('HeaderDrawerClose');

    if (drawerTrigger && drawerModal) {
      drawerTrigger.addEventListener('click', () => {
        drawerModal.classList.add('is-open');
        drawerModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      const closeDrawer = () => {
        drawerModal.classList.remove('is-open');
        drawerModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
      drawerModal.addEventListener('click', (e) => {
        if (e.target === drawerModal) closeDrawer();
      });
    }

    // Search Modal
    const searchTrigger = document.getElementById('HeaderSearchTrigger');
    const searchModal = document.getElementById('HeaderSearchModal');
    const searchClose = document.getElementById('HeaderSearchClose');

    if (searchTrigger && searchModal) {
      searchTrigger.addEventListener('click', () => {
        // If theme has Search Drawer component, publish event or toggle modal
        if (document.querySelector('.es-search-drawer')) {
          document.querySelector('.es-search-drawer').classList.add('is-open');
          document.body.style.overflow = 'hidden';
        } else {
          searchModal.classList.add('is-open');
          searchModal.querySelector('input')?.focus();
        }
      });

      if (searchClose) {
        searchClose.addEventListener('click', () => {
          searchModal.classList.remove('is-open');
        });
      }

      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) searchModal.classList.remove('is-open');
      });
    }

    // Cart Drawer Integration
    const cartIcon = document.getElementById('cart-icon-bubble');
    if (cartIcon) {
      cartIcon.addEventListener('click', (e) => {
        if (window.theme?.cartType === 'drawer') {
          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer) {
            e.preventDefault();
            if (typeof cartDrawer.open === 'function') {
              cartDrawer.open(cartIcon);
            } else {
              cartDrawer.classList.add('is-open');
              cartDrawer.setAttribute('aria-hidden', 'false');
              document.body.classList.add('overflow-hidden');
            }
          }
        }
      });
    }
  });
</script>

{%- comment -%}
  Organization and WebSite structured data used to be emitted here, which
  duplicated the same entities whenever another surface declared them. All
  JSON-LD now comes from `snippets/schema-structured-data.liquid`, rendered
  once from the layout, which also covers Product and Article.
{%- endcomment -%}

