{%- comment -%}
  E-sellers Image With Text Slider - E-sellers One (v5.0.0)

  A rail of image+text panels (each block = one slide) with dot navigation.
  CSS scroll-snap drives the slide, IntersectionObserver keeps the dots in
  sync - no carousel library.
{%- endcomment -%}

{%- liquid
  assign es_iwts_slides = section.blocks | where: 'type', 'slide'
-%}

{%- if es_iwts_slides.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #shopify-section-{{ section.id }} .es-iwts__rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    #shopify-section-{{ section.id }} .es-iwts__rail::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .es-iwts__slide { scroll-snap-align: start; }

    #shopify-section-{{ section.id }} .es-iwts__pair {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--es-space-6);
      align-items: center;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-iwts__pair { grid-template-columns: 1fr 1fr; }
    }

    #shopify-section-{{ section.id }} .es-iwts__media { aspect-ratio: 4/5; border-radius: var(--es-radius-lg); overflow: hidden; position: relative; }
    #shopify-section-{{ section.id }} .es-iwts__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    #shopify-section-{{ section.id }} .es-iwts__dots { display: flex; justify-content: center; gap: var(--es-space-2); margin-top: var(--es-space-5); }
    #shopify-section-{{ section.id }} .es-iwts__dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--es-rule-strong);
      border: none; padding: 0; cursor: pointer;
    }
    #shopify-section-{{ section.id }} .es-iwts__dot.is-active { background: var(--es-fg); }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        alignment: 'center' -%}

    <div class="es-iwts__rail" data-es-iwts-rail>
      {%- for block in es_iwts_slides -%}
        <div class="es-iwts__slide" {{ block.shopify_attributes }}>
          <div class="es-iwts__pair">
            <div class="es-iwts__media">
              {%- if block.settings.image != blank -%}
                {%- assign es_iwts_alt = block.settings.heading | escape -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: es_iwts_alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
              {%- endif -%}
            </div>
            <div>
              {%- if block.settings.heading != blank -%}<h3 class="h3">{{ block.settings.heading | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div>{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                {%- render 'es-button', label: block.settings.button_label, url: block.settings.button_link, style: 'solid' -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if es_iwts_slides.size > 1 -%}
      <div class="es-iwts__dots" data-es-iwts-dots>
        {%- for block in es_iwts_slides -%}
          <button type="button" class="es-iwts__dot{% if forloop.first %} is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}" data-index="{{ forloop.index0 }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var rail = root.querySelector('[data-es-iwts-rail]');
      var dotsWrap = root.querySelector('[data-es-iwts-dots]');
      if (!rail || !dotsWrap) return;
      var slides = Array.prototype.slice.call(rail.children);
      var dots = Array.prototype.slice.call(dotsWrap.children);

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          slides[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
      });

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var idx = slides.indexOf(entry.target);
              dots.forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
            }
          });
        }, { root: rail, threshold: 0.6 });
        slides.forEach(function (s) { io.observe(s); });
      }
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add slide blocks to populate this slider.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Image With Text Slider",
  "tag": "section",
  "class": "shopify-section--es-image-with-text-slider",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "E-sellers Image With Text Slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
