{%- comment -%}
  ES Quick Comparison Table - E-sellers One (v5.0.0)

  Product-page only: a compact spec table comparing the current product
  against Shopify's own recommended products, one column per product. Row
  blocks choose which fields appear (price, vendor, type, description).
  Uses the native {% recommendations %} tag - no extra network request.
{%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign es_qct_limit = section.settings.limit | default: 4
    assign es_qct_rows = section.blocks
  -%}

  {%- recommendations product: product, limit: es_qct_limit, intent: 'related' -%}
    {%- if recommendations.performed and recommendations.products_count > 0 and es_qct_rows.size > 0 -%}
      {%- style -%}
        #shopify-section-{{ section.id }} {
          padding-top: {{ section.settings.padding_top | default: 56 }}px;
          padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
        }

        #shopify-section-{{ section.id }} .es-qct__scroll { overflow-x: auto; }
        #shopify-section-{{ section.id }} .es-qct__table { width: 100%; min-width: 520px; border-collapse: collapse; }
        #shopify-section-{{ section.id }} .es-qct__table th,
        #shopify-section-{{ section.id }} .es-qct__table td {
          padding: var(--es-space-3);
          border-bottom: var(--es-rule-width) solid var(--es-rule);
          text-align: center;
          vertical-align: top;
        }
        #shopify-section-{{ section.id }} .es-qct__row-label { text-align: left; font-weight: 650; white-space: nowrap; }
        #shopify-section-{{ section.id }} .es-qct__col-head { min-width: 150px; }
        #shopify-section-{{ section.id }} .es-qct__col-head img { width: 72px; height: 72px; object-fit: cover; border-radius: var(--es-radius-md); margin: 0 auto var(--es-space-2); }
        #shopify-section-{{ section.id }} .es-qct__col-title { font-weight: 650; font-size: var(--es-text-sm); }
        #shopify-section-{{ section.id }} .es-qct__col-title a { color: inherit; }
        #shopify-section-{{ section.id }} .es-qct__desc {
          display: -webkit-box;
          -webkit-line-clamp: {{ section.settings.text_line_limit | default: 3 }};
          -webkit-box-orient: vertical;
          overflow: hidden;
          font-size: var(--es-text-xs);
          color: var(--es-fg-muted);
        }
      {%- endstyle -%}

      <div class="page-width">
        {%- render 'es-section-heading',
            subheading: section.settings.subheading,
            heading: section.settings.heading,
            description: section.settings.description -%}

        <div class="es-qct__scroll">
          <table class="es-qct__table">
            <thead>
              <tr>
                <th></th>
                <th class="es-qct__col-head">
                  {%- if product.featured_image != blank -%}
                    {%- assign es_qct_alt = product.title | escape -%}
                    {{ product.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', alt: es_qct_alt }}
                  {%- endif -%}
                  <div class="es-qct__col-title">{{ product.title }}</div>
                </th>
                {%- for rec in recommendations.products -%}
                  <th class="es-qct__col-head">
                    {%- if rec.featured_image != blank -%}
                      {%- assign es_qct_rec_alt = rec.title | escape -%}
                      {{ rec.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', alt: es_qct_rec_alt }}
                    {%- endif -%}
                    <div class="es-qct__col-title"><a href="{{ rec.url }}">{{ rec.title }}</a></div>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for block in es_qct_rows -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row" class="es-qct__row-label">
                    {%- case block.type -%}
                      {%- when 'price' -%}{{ 'products.product.price.label' | t | default: 'Price' }}
                      {%- when 'vendor' -%}{{ 'products.product.vendor' | t | default: 'Brand' }}
                      {%- when 'type' -%}{{ 'products.product.type' | t | default: 'Type' }}
                      {%- when 'description' -%}{{ 'products.product.description' | t | default: 'Description' }}
                    {%- endcase -%}
                  </th>
                  <td>
                    {%- case block.type -%}
                      {%- when 'price' -%}{{ product.price | money }}
                      {%- when 'vendor' -%}{{ product.vendor }}
                      {%- when 'type' -%}{{ product.type }}
                      {%- when 'description' -%}<div class="es-qct__desc">{{ product.description | strip_html }}</div>
                    {%- endcase -%}
                  </td>
                  {%- for rec in recommendations.products -%}
                    <td>
                      {%- case block.type -%}
                        {%- when 'price' -%}{{ rec.price | money }}
                        {%- when 'vendor' -%}{{ rec.vendor }}
                        {%- when 'type' -%}{{ rec.type }}
                        {%- when 'description' -%}<div class="es-qct__desc">{{ rec.description | strip_html }}</div>
                      {%- endcase -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
              {%- if section.settings.show_view_details_button -%}
                <tr>
                  <th scope="row" class="es-qct__row-label"></th>
                  <td><a href="{{ product.url }}" class="es-btn es-btn--sm">{{ 'general.view_details' | t | default: 'View' }}</a></td>
                  {%- for rec in recommendations.products -%}
                    <td><a href="{{ rec.url }}" class="es-btn es-btn--sm">{{ 'general.view_details' | t | default: 'View' }}</a></td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            </tbody>
          </table>
        </div>
      </div>
    {%- endif -%}
  {%- endrecommendations -%}
{%- endif -%}

{% schema %}
{
  "name": "ES Quick Comparison",
  "tag": "section",
  "class": "shopify-section--es-quick-comparison-table",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare with similar products" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "range", "id": "limit", "label": "Products to compare", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "text_line_limit", "label": "Description line limit", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_view_details_button", "label": "Show view button row", "default": true },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "vendor", "name": "Brand", "limit": 1 },
    { "type": "type", "name": "Type", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "ES Quick Comparison",
      "blocks": [{ "type": "price" }, { "type": "vendor" }, { "type": "type" }]
    }
  ]
}
{% endschema %}
