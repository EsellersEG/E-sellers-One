{%- comment -%}
  E-sellers Layered Images With Text - E-sellers One (v5.0.0)

  A primary image with a smaller image offset over one corner, next to a text
  column. A common "editorial" hero pattern. Pure CSS positioning, image order
  can be mirrored via the image_position setting.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  #shopify-section-{{ section.id }} .es-liwt {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--es-space-7);
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .es-liwt { grid-template-columns: 1fr 1fr; }
    {%- if section.settings.image_position == 'right' -%}
      #shopify-section-{{ section.id }} .es-liwt__media { order: 2; }
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .es-liwt__media {
    position: relative;
    padding: 0 0 20% 20%;
  }
  #shopify-section-{{ section.id }} .es-liwt__main {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--es-radius-lg);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .es-liwt__main img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .es-liwt__secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 55%;
    aspect-ratio: 1/1;
    border-radius: var(--es-radius-lg);
    overflow: hidden;
    border: 6px solid var(--es-bg);
    box-shadow: var(--es-elev-2);
  }
  #shopify-section-{{ section.id }} .es-liwt__secondary img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .es-liwt__eyebrow { font-size: var(--es-text-xs); font-weight: 700; letter-spacing: var(--es-track-caps); text-transform: uppercase; color: var(--es-fg-muted); margin: 0 0 var(--es-space-2); }
  #shopify-section-{{ section.id }} .es-liwt__heading { margin: 0 0 var(--es-space-3); }
  #shopify-section-{{ section.id }} .es-liwt__desc { color: var(--es-fg-muted); margin-bottom: var(--es-space-4); }
{%- endstyle -%}

<div class="page-width">
  <div class="es-liwt">
    <div class="es-liwt__media">
      <div class="es-liwt__main">
        {%- if section.settings.image_desktop_vertical != blank -%}
          {%- assign es_liwt_alt = section.settings.heading | escape -%}
          {{ section.settings.image_desktop_vertical | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: es_liwt_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
        {%- endif -%}
      </div>
      {%- if section.settings.image_desktop_horizontal != blank -%}
        <div class="es-liwt__secondary">
          {{ section.settings.image_desktop_horizontal | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,400,500', alt: '' }}
        </div>
      {%- endif -%}
    </div>

    <div>
      {%- if section.settings.subheading != blank -%}<p class="es-liwt__eyebrow">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="es-liwt__heading h2">{%- render 'es-highlight-text', text: section.settings.heading, style: section.settings.highlight_style -%}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}<div class="es-liwt__desc">{{ section.settings.description }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- render 'es-button', label: section.settings.button_label, url: section.settings.button_link, style: section.settings.button_style -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "E-sellers Layered Images With Text",
  "tag": "section",
  "class": "shopify-section--es-layered-images-with-text",
  "settings": [
    { "type": "image_picker", "id": "image_desktop_vertical", "label": "Main image" },
    { "type": "image_picker", "id": "image_desktop_horizontal", "label": "Overlapping image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A closer look" },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Heading emphasis style",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "circle", "label": "Circle" },
        { "value": "color", "label": "Color" }
      ],
      "default": "underline",
      "info": "Wrap words in <em>...</em> in the heading to apply this style."
    },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "secondary", "label": "Outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "E-sellers Layered Images With Text" }
  ]
}
{% endschema %}
