{%- comment -%}
  Main Customer Reset Password Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
  }

  .es-reset-password {
    max-width: 480px;
    margin: 0 auto;
    padding: 40px 32px;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 10px 40px -4px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    text-align: center;
  }

  .es-reset-password__heading {
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #0f172a;
    {% if section.settings.heading_gradient != blank %}
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    {% endif %}
  }

  .es-reset-password__subtext {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0 0 24px 0;
  }

  .es-reset-password__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .es-reset-password__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .es-reset-password__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }

  .es-reset-password__input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #0f172a;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .es-reset-password__input:focus {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .es-reset-password__btn {
    width: 100%;
    padding: 14px 20px;
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .es-reset-password__btn:hover {
    background-color: #1e293b;
    transform: translateY(-1px);
  }

  .es-reset-password__errors {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 16px;
    text-align: left;
  }

  .es-reset-password__errors ul {
    margin: 4px 0 0 0;
    padding-left: 18px;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="es-reset-password">
    <h1 class="es-reset-password__heading">{{ 'customer.reset_password.title' | t | default: 'Reset Account Password' }}</h1>
    <p class="es-reset-password__subtext">{{ 'customer.reset_password.subtext' | t | default: 'Enter a new password for your account' }}</p>

    {%- form 'reset_customer_password', class: 'es-reset-password__form' -%}
      {%- if form.errors -%}
        <div class="es-reset-password__errors" role="alert">
          <strong>{{ 'templates.contact.form.error_heading' | t | default: 'Please fix the errors below:' }}</strong>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }}: {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="es-reset-password__field">
        <label class="es-reset-password__label" for="ResetPassword">
          {{ 'customer.reset_password.password' | t | default: 'New password' }}
        </label>
        <input
          type="password"
          name="customer[password]"
          id="ResetPassword"
          autocomplete="new-password"
          placeholder="••••••••"
          class="es-reset-password__input"
          minlength="6"
          required
        >
      </div>

      <div class="es-reset-password__field">
        <label class="es-reset-password__label" for="ResetPasswordConfirmation">
          {{ 'customer.reset_password.password_confirmation' | t | default: 'Confirm new password' }}
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="ResetPasswordConfirmation"
          autocomplete="new-password"
          placeholder="••••••••"
          class="es-reset-password__input"
          minlength="6"
          required
        >
      </div>

      <button type="submit" class="es-reset-password__btn">
        {{ 'customer.reset_password.submit' | t | default: 'Update Password' }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "shopify-section--main-customers-reset-password",
  "settings": [
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ]
}
{% endschema %}
