{%- comment -%}
  E-sellers Video Testimonial Gallery Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{{ 'video-testimonial-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec_id = section.id
-%}

<section
  class="vt-gallery-section"
  id="vt-gallery-{{ sec_id }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-transition-speed="{{ section.settings.transition_speed }}"
  style="
    --vt-bg: {{ section.settings.background_color | default: '#faf8f5' }};
    --vt-card-width: {{ section.settings.card_width | default: 300 }}px;
    --vt-card-height: {{ section.settings.card_height | default: 540 }}px;
    --vt-card-radius: {{ section.settings.card_radius | default: 24 }}px;
    --vt-gap: {{ section.settings.card_gap | default: 16 }}px;
    --vt-active-scale: {{ section.settings.active_scale | default: 106 | divided_by: 100.0 }};
    --vt-transition-speed: {{ section.settings.transition_speed | default: 400 }}ms;
    --vt-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --vt-padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --vt-arrow-color: {{ section.settings.arrow_color | default: '#000000' }};
    --vt-arrow-active-bg: {{ section.settings.arrow_active_bg | default: '#000000' }};
    --vt-arrow-active-color: {{ section.settings.arrow_active_color | default: '#ffffff' }};
    --vt-overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --vt-overlay-opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};
    --vt-heading-color: {{ section.settings.heading_color | default: '#000000' }};
    --vt-heading-size: {{ section.settings.heading_size | default: 36 }}px;
    --vt-heading-margin-bottom: {{ section.settings.heading_margin_bottom | default: 40 }}px;
  "
>
  <div class="vt-container">
    {%- if section.settings.heading != blank -%}
      <div class="vt-header">
        <h2 class="vt-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    
    <div class="vt-viewport">
      <div class="vt-track" data-vt-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'video_card' -%}
            {%- liquid
              assign video = block.settings.video
              assign video_url = block.settings.video_url
              assign cover_image = block.settings.cover_image | default: video.preview_image
              
              assign video_src = ''
              if video != blank
                for source in video.sources
                  if source.format == 'mp4'
                    assign video_src = source.url
                    break
                  endif
                endfor
                if video_src == blank
                  assign video_src = video.sources.first.url
                endif
              else
                assign video_src = video_url
              endif
            -%}
            <div class="vt-slide" data-vt-slide {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
              <div class="vt-card">
                <div class="vt-media-wrap">
                  {%- if video_src != blank -%}
                    <video
                      class="vt-video"
                      playsinline
                      loop
                      muted
                      preload="metadata"
                      {% if cover_image != blank %}poster="{{ cover_image | image_url: width: 800 }}"{% endif %}
                      src="{{ video_src }}"
                    ></video>
                  {%- elsif cover_image != blank -%}
                    <img
                      class="vt-poster"
                      src="{{ cover_image | image_url: width: 800 }}"
                      width="{{ cover_image.width }}"
                      height="{{ cover_image.height }}"
                      alt="Video testimonial cover"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="vt-placeholder">
                      {{ 'image' | placeholder_svg_tag: 'vt-placeholder-svg' }}
                    </div>
                  {%- endif -%}
                  
                  <div class="vt-overlay"></div>
                  
                  <button type="button" class="vt-play-button" aria-label="Play video">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                  
                  <button type="button" class="vt-mute-button" aria-label="Mute video">
                    <svg class="icon-muted" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM12 4L9.91 6.09 12 8.18V4zm5.66 2.84L16.2 8.3c1.1 1.05 1.8 2.5 1.8 4.1s-.7 3.05-1.8 4.1l1.46 1.46c1.49-1.43 2.44-3.4 2.44-5.56s-.95-4.13-2.44-5.56zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.03c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 14.18v3.63L8.82 15H5v-4h3.82l.18-.18 3 3z"/>
                    </svg>
                    <svg class="icon-unmuted" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    
    {%- if section.blocks.size > 1 -%}
      <div class="vt-navigation">
        <button type="button" class="vt-arrow vt-arrow--prev" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="vt-arrow vt-arrow--next" aria-label="Next slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var globalMuted = true;

    function initSection(secId) {
      var section = document.getElementById('vt-gallery-' + secId);
      if (!section || section.classList.contains('is-initialized')) return;
      
      var track = section.querySelector('[data-vt-track]');
      var slides = Array.prototype.slice.call(section.querySelectorAll('[data-vt-slide]'));
      var n = slides.length;
      if (n === 0) return;

      section.classList.add('is-initialized');

      var allSlides = [];
      if (n > 1) {
        var setA = [];
        var setB = [];
        var setC = [];
        
        slides.forEach(function (s) {
          var cloneA = s.cloneNode(true);
          var cloneC = s.cloneNode(true);

          var videoA = cloneA.querySelector('.vt-video');
          var videoC = cloneC.querySelector('.vt-video');
          if (videoA) videoA.setAttribute('preload', 'none');
          if (videoC) videoC.setAttribute('preload', 'none');

          setA.push(cloneA);
          setB.push(s);
          setC.push(cloneC);
        });
        
        track.innerHTML = '';
        setA.forEach(function (s) { track.appendChild(s); });
        setB.forEach(function (s) { track.appendChild(s); });
        setC.forEach(function (s) { track.appendChild(s); });
        
        allSlides = Array.prototype.slice.call(track.querySelectorAll('[data-vt-slide]'));
      } else {
        allSlides = slides;
      }

      var currentIndex = n > 1 ? n : 0;
      var isTransitioning = false;
      var autoplayTimer = null;
      var cardWidth = 0;
      var gap = 0;
      var dragOffset = 0;
      var isSectionInView = true;

      var autoplay = section.getAttribute('data-autoplay') === 'true';
      var autoplaySpeed = parseInt(section.getAttribute('data-autoplay-speed'), 10) || 4000;
      var transitionSpeed = parseInt(section.getAttribute('data-transition-speed'), 10) || 400;
      var viewport = section.querySelector('.vt-viewport');

      function readMetrics() {
        var styles = getComputedStyle(section);
        var baseGap = parseFloat(styles.getPropertyValue('--vt-gap')) || 16;
        
        var sample = null;
        for (var i = 0; i < allSlides.length; i++) {
          if (!allSlides[i].classList.contains('is-active')) {
            sample = allSlides[i];
            break;
          }
        }
        if (!sample) sample = allSlides[0];
        
        var measuredWidth = sample ? sample.getBoundingClientRect().width : 0;
        var baseCardWidth = parseFloat(styles.getPropertyValue('--vt-card-width')) || 300;
        
        if (measuredWidth > 0) {
          cardWidth = measuredWidth;
        } else {
          var screenWidth = window.innerWidth;
          if (screenWidth <= 749) {
            cardWidth = baseCardWidth * 0.72;
          } else if (screenWidth <= 989) {
            cardWidth = baseCardWidth * 0.85;
          } else {
            cardWidth = baseCardWidth;
          }
        }
        gap = baseGap;
      }

      function getTranslateXForIndex(index) {
        var viewportWidth = viewport.getBoundingClientRect().width;
        var centerOfSlide = index * (cardWidth + gap) + cardWidth / 2;
        return viewportWidth / 2 - centerOfSlide;
      }

      function updateMuteIcons(slide, isMuted) {
        var muteBtn = slide.querySelector('.vt-mute-button');
        if (!muteBtn) return;
        var mutedIcon = muteBtn.querySelector('.icon-muted');
        var unmutedIcon = muteBtn.querySelector('.icon-unmuted');
        if (mutedIcon && unmutedIcon) {
          mutedIcon.style.display = isMuted ? 'block' : 'none';
          unmutedIcon.style.display = isMuted ? 'none' : 'block';
        }
      }

      function playActiveVideo(slide) {
        var video = slide.querySelector('.vt-video');
        if (!video) return;
        slide.classList.remove('is-paused');
        video.muted = globalMuted;
        updateMuteIcons(slide, globalMuted);

        if (video.hasAttribute('preload') && video.getAttribute('preload') === 'none') {
          video.setAttribute('preload', 'metadata');
        }

        var playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(function () {
            slide.classList.add('is-paused');
          });
        }
      }

      function pauseVideo(slide) {
        var video = slide.querySelector('.vt-video');
        if (!video) return;
        video.pause();
        slide.classList.remove('is-paused');
      }

      function goTo(newIndex) {
        if (isTransitioning || n <= 1) return;
        isTransitioning = true;
        currentIndex = newIndex;
        dragOffset = 0;

        allSlides.forEach(function (slide, i) {
          var isActive = i === currentIndex;
          slide.classList.toggle('is-active', isActive);
          
          if (isActive) {
            playActiveVideo(slide);
          } else {
            pauseVideo(slide);
          }
        });

        track.style.transition = 'transform ' + transitionSpeed + 'ms cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        var targetTranslate = getTranslateXForIndex(currentIndex);
        track.style.transform = 'translateX(' + targetTranslate + 'px)';

        setTimeout(function () {
          isTransitioning = false;

          if (currentIndex >= n * 2) {
            var oldActive = allSlides[currentIndex];
            var oldVideo = oldActive ? oldActive.querySelector('.vt-video') : null;

            currentIndex -= n;

            var newActive = allSlides[currentIndex];
            var newVideo = newActive ? newActive.querySelector('.vt-video') : null;

            if (oldVideo && newVideo) {
              newVideo.currentTime = oldVideo.currentTime;
              newVideo.muted = oldVideo.muted;
              playActiveVideo(newActive);
              oldVideo.pause();
            }

            track.style.transition = 'none';
            var resetTranslate = getTranslateXForIndex(currentIndex);
            track.style.transform = 'translateX(' + resetTranslate + 'px)';

            allSlides.forEach(function (slide, i) {
              slide.classList.toggle('is-active', i === currentIndex);
            });

          } else if (currentIndex < n) {
            var oldActive = allSlides[currentIndex];
            var oldVideo = oldActive ? oldActive.querySelector('.vt-video') : null;

            currentIndex += n;

            var newActive = allSlides[currentIndex];
            var newVideo = newActive ? newActive.querySelector('.vt-video') : null;

            if (oldVideo && newVideo) {
              newVideo.currentTime = oldVideo.currentTime;
              newVideo.muted = oldVideo.muted;
              playActiveVideo(newActive);
              oldVideo.pause();
            }

            track.style.transition = 'none';
            var resetTranslate = getTranslateXForIndex(currentIndex);
            track.style.transform = 'translateX(' + resetTranslate + 'px)';

            allSlides.forEach(function (slide, i) {
              slide.classList.toggle('is-active', i === currentIndex);
            });
          }
        }, transitionSpeed);
      }

      function next() { goTo(currentIndex + 1); }
      function prev() { goTo(currentIndex - 1); }

      function startAutoplay() {
        if (!autoplay || n <= 1 || !isSectionInView) return;
        stopAutoplay();
        autoplayTimer = setInterval(function () {
          var activeSlide = allSlides[currentIndex];
          var activeVideo = activeSlide ? activeSlide.querySelector('.vt-video') : null;
          if (activeVideo && !activeVideo.paused) {
            return;
          }
          next();
        }, autoplaySpeed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      if (window.IntersectionObserver) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            isSectionInView = entry.isIntersecting;
            var activeSlide = allSlides[currentIndex];
            if (isSectionInView) {
              if (activeSlide) playActiveVideo(activeSlide);
              startAutoplay();
            } else {
              if (activeSlide) pauseVideo(activeSlide);
              stopAutoplay();
            }
          });
        }, { threshold: 0.15 });
        observer.observe(section);
      }

      var nextBtn = section.querySelector('.vt-arrow--next');
      var prevBtn = section.querySelector('.vt-arrow--prev');
      if (nextBtn) nextBtn.addEventListener('click', function () { next(); resetAutoplay(); });
      if (prevBtn) prevBtn.addEventListener('click', function () { prev(); resetAutoplay(); });

      allSlides.forEach(function (slide) {
        slide.addEventListener('click', function (e) {
          var index = allSlides.indexOf(slide);
          if (index !== currentIndex) {
            e.preventDefault();
            e.stopPropagation();
            goTo(index);
            resetAutoplay();
          }
        });

        var video = slide.querySelector('.vt-video');
        var playBtn = slide.querySelector('.vt-play-button');
        if (playBtn && video) {
          playBtn.addEventListener('click', function (e) {
            var index = allSlides.indexOf(slide);
            if (index === currentIndex) {
              e.preventDefault();
              e.stopPropagation();
              if (video.paused) {
                video.play().then(function () {
                  slide.classList.remove('is-paused');
                }).catch(function () {});
              }
            }
          });
        }

        var muteBtn = slide.querySelector('.vt-mute-button');
        if (muteBtn && video) {
          muteBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            globalMuted = !globalMuted;
            
            allSlides.forEach(function (s) {
              var v = s.querySelector('.vt-video');
              if (v) {
                v.muted = globalMuted;
                updateMuteIcons(s, globalMuted);
              }
            });
          });
        }

        if (video) {
          video.addEventListener('click', function (e) {
            var index = allSlides.indexOf(slide);
            if (index === currentIndex) {
              e.preventDefault();
              e.stopPropagation();
              if (video.paused) {
                video.play().then(function () {
                  slide.classList.remove('is-paused');
                }).catch(function () {});
              } else {
                video.pause();
                slide.classList.add('is-paused');
              }
            }
          });

          video.addEventListener('ended', function () {
            var index = allSlides.indexOf(slide);
            if (index === currentIndex) {
              next();
            }
          });
        }
      });

      var dragStartX = 0;
      var dragStartY = 0;
      var isDragging = false;
      var isTouching = false;
      var draggedOccurred = false;

      function onMouseMove(e) {
        if (!isDragging) return;
        var dx = e.clientX - dragStartX;
        
        if (Math.abs(dx) > 10) {
          draggedOccurred = true;
          dragOffset = dx;
          
          var targetTranslate = getTranslateXForIndex(currentIndex) + dragOffset;
          track.style.transition = 'none';
          track.style.transform = 'translateX(' + targetTranslate + 'px)';
        }
      }

      function onMouseUp() {
        if (!isDragging) return;
        isDragging = false;
        
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
        
        if (draggedOccurred) {
          var threshold = Math.min(60, cardWidth * 0.15);
          if (dragOffset > threshold) {
            prev();
          } else if (dragOffset < -threshold) {
            next();
          } else {
            goTo(currentIndex);
          }
          setTimeout(function () {
            draggedOccurred = false;
          }, 50);
        }
        startAutoplay();
      }

      viewport.addEventListener('mousedown', function (e) {
        if (e.button !== 0 || isTransitioning) return;
        isDragging = true;
        draggedOccurred = false;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        dragOffset = 0;
        stopAutoplay();

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });

      viewport.addEventListener('touchstart', function (e) {
        if (isTransitioning) return;
        isTouching = true;
        draggedOccurred = false;
        dragStartX = e.touches[0].clientX;
        dragStartY = e.touches[0].clientY;
        dragOffset = 0;
        stopAutoplay();
      }, { passive: true });

      viewport.addEventListener('touchmove', function (e) {
        if (!isTouching) return;
        var dx = e.touches[0].clientX - dragStartX;
        var dy = e.touches[0].clientY - dragStartY;

        if (Math.abs(dx) > Math.abs(dy)) {
          if (e.cancelable) e.preventDefault();
          if (Math.abs(dx) > 10) {
            draggedOccurred = true;
            dragOffset = dx;
            
            var targetTranslate = getTranslateXForIndex(currentIndex) + dragOffset;
            track.style.transition = 'none';
            track.style.transform = 'translateX(' + targetTranslate + 'px)';
          }
        }
      }, { passive: false });

      viewport.addEventListener('touchend', function () {
        if (!isTouching) return;
        isTouching = false;
        
        if (draggedOccurred) {
          var threshold = Math.min(60, cardWidth * 0.15);
          if (dragOffset > threshold) {
            prev();
          } else if (dragOffset < -threshold) {
            next();
          } else {
            goTo(currentIndex);
          }
          setTimeout(function () {
            draggedOccurred = false;
          }, 50);
        }
        startAutoplay();
      });

      viewport.addEventListener('touchcancel', function () {
        if (!isTouching) return;
        isTouching = false;
        dragOffset = 0;
        goTo(currentIndex);
        startAutoplay();
      });

      viewport.addEventListener('click', function (e) {
        if (draggedOccurred) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      viewport.addEventListener('dragstart', function (e) {
        e.preventDefault();
      });

      function init() {
        readMetrics();
        currentIndex = n > 1 ? n : 0;
        track.style.transition = 'none';
        var initialTranslate = getTranslateXForIndex(currentIndex);
        track.style.transform = 'translateX(' + initialTranslate + 'px)';
        
        allSlides.forEach(function (slide, i) {
          var isActive = i === currentIndex;
          slide.classList.toggle('is-active', isActive);
          if (isActive) {
            playActiveVideo(slide);
          } else {
            pauseVideo(slide);
          }
        });
        
        startAutoplay();

        setTimeout(function () {
          readMetrics();
          track.style.transition = 'none';
          var resetTranslate = getTranslateXForIndex(currentIndex);
          track.style.transform = 'translateX(' + resetTranslate + 'px)';
        }, 100);
      }

      var resizeTimer = null;
      function handleResize() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          readMetrics();
          track.style.transition = 'none';
          var resetTranslate = getTranslateXForIndex(currentIndex);
          track.style.transform = 'translateX(' + resetTranslate + 'px)';
        }, 100);
      }

      window.addEventListener('resize', handleResize);
      window.addEventListener('orientationchange', handleResize);

      if (window.ResizeObserver) {
        var ro = new ResizeObserver(handleResize);
        ro.observe(viewport);
      }

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(init);
      } else {
        init();
      }

      window.addEventListener('load', handleResize);
    }

    initSection('{{ sec_id }}');

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ sec_id }}') {
        initSection('{{ sec_id }}');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Video Testimonial Slider",
  "tag": "section",
  "class": "shopify-section--video-testimonial-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Customer Stories"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading margin bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_active_bg",
      "label": "Arrow hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_active_color",
      "label": "Arrow hover color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Inactive card overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Inactive card overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 540
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
