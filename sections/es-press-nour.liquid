{%- comment -%}
  E-sellers Press (Nour) - E-sellers One (v5.0.0)

  A single large quote above a strip of outlet logo thumbnails; clicking a
  thumbnail swaps the quote shown above it. Alternate to the theme's existing
  es-press (a logo grid with one shared rating) - this variant is for "as
  quoted in" style press pages where each outlet gets its own quote.
{%- endcomment -%}

{%- liquid
  assign es_prn_items = section.blocks | where: 'type', 'quote'
-%}

{%- if es_prn_items.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .es-prn__quote {
      max-width: 700px;
      margin: 0 auto var(--es-space-6);
      font-size: var(--es-text-lg);
      line-height: var(--es-leading-relaxed);
      display: none;
    }
    #shopify-section-{{ section.id }} .es-prn__quote.is-active { display: block; }

    #shopify-section-{{ section.id }} .es-prn__logos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--es-space-6);
    }
    #shopify-section-{{ section.id }} .es-prn__logo-btn {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      opacity: .45;
      transition: opacity var(--es-dur-base) var(--es-ease);
    }
    #shopify-section-{{ section.id }} .es-prn__logo-btn.is-active,
    #shopify-section-{{ section.id }} .es-prn__logo-btn:hover { opacity: 1; }
    #shopify-section-{{ section.id }} .es-prn__logo-btn img { max-height: 32px; width: auto; object-fit: contain; }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading', heading: section.settings.heading, alignment: 'center' -%}

    {%- for block in es_prn_items -%}
      <blockquote class="es-prn__quote{% if forloop.first %} is-active{% endif %}" data-es-prn-quote data-index="{{ forloop.index0 }}">
        {{ block.settings.text }}
      </blockquote>
    {%- endfor -%}

    <div class="es-prn__logos">
      {%- for block in es_prn_items -%}
        <button type="button" class="es-prn__logo-btn{% if forloop.first %} is-active{% endif %}" data-es-prn-logo data-index="{{ forloop.index0 }}" aria-label="{{ block.settings.author | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign es_prn_alt = block.settings.author | default: 'Press outlet' | escape -%}
            {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: es_prn_alt }}
          {%- else -%}
            <span>{{ block.settings.author | escape }}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var quotes = root.querySelectorAll('[data-es-prn-quote]');
      var logos = root.querySelectorAll('[data-es-prn-logo]');
      logos.forEach(function (logo) {
        logo.addEventListener('click', function () {
          var idx = logo.dataset.index;
          logos.forEach(function (l) { l.classList.toggle('is-active', l === logo); });
          quotes.forEach(function (q) { q.classList.toggle('is-active', q.dataset.index === idx); });
        });
      });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add quote blocks to populate this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Press (Nour)",
  "tag": "section",
  "class": "shopify-section--es-press-nour",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Outlet logo" },
        { "type": "text", "id": "author", "label": "Outlet name", "default": "Publication" },
        { "type": "richtext", "id": "text", "label": "Quote", "default": "<p>\"An outstanding product.\"</p>" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "E-sellers Press (Nour)",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
