{%- comment -%}
  Main Customer Login Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
  }

  .es-login-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: {% if section.settings.image != blank %}960px{% else %}480px{% endif %};
    margin: 0 auto;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px -4px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
  }

  .es-login-media {
    flex: 1 1 50%;
    align-self: stretch;
    background: #f1f5f9;
  }

  .es-login-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .es-login-card {
    flex: 1 1 50%;
    padding: 44px 36px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  @media screen and (max-width: 768px) {
    .es-login-wrapper {
      flex-direction: column;
      max-width: 100%;
      border-radius: 16px;
    }

    .es-login-media {
      display: none;
    }

    .es-login-card {
      padding: 32px 20px;
    }
  }

  .es-login-heading {
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #0f172a;
    text-align: center;
    {% if section.settings.heading_gradient != blank %}
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    {% endif %}
  }

  .es-login-subtext {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0 0 24px 0;
    text-align: center;
  }

  .es-login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .es-login-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .es-login-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }

  .es-login-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #0f172a;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .es-login-input:focus {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .es-login-forgot {
    font-size: 0.875rem;
    color: #64748b;
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-end;
    margin-top: -4px;
    cursor: pointer;
  }

  .es-login-forgot:hover {
    color: #0f172a;
  }

  .es-login-btn {
    width: 100%;
    padding: 14px 20px;
    background-color: {{ section.settings.button_background | default: '#0f172a' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .es-login-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .es-login-footer {
    margin-top: 20px;
    text-align: center;
    font-size: 0.9rem;
    color: #64748b;
  }

  .es-login-footer a {
    color: #0f172a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .es-login-error {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  .es-login-success {
    background-color: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="es-login-wrapper">
    {%- if section.settings.image != blank -%}
      <div class="es-login-media">
        {%- assign es_tagarg_1 = shop.name | escape -%}{{ section.settings.image | image_url: width: 1000 | image_tag:
          loading: 'eager',
          alt: es_tagarg_1}}
      </div>
    {%- endif -%}

    <div class="es-login-card">
      <!-- Main Login Container -->
      <div id="LoginFormContainer">
        <h1 class="es-login-heading">{{ 'customer.login.title' | t | default: 'Welcome Back' }}</h1>
        <p class="es-login-subtext">{{ 'customer.login.subtext' | t | default: 'Sign in with your email and password' }}</p>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'liquid' -%}
              {%- if block.settings.liquid != blank -%}
                <div {{ block.shopify_attributes }}>
                  {{ block.settings.liquid }}
                </div>
              {%- endif -%}

            {%- when 'fields' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'customer_login', class: 'es-login-form' -%}
                  <input type="hidden" name="checkout_url" value="{{ block.settings.return_to | default: routes.account_url }}">

                  {%- if form.errors -%}
                    <div class="es-login-error" role="alert">
                      {{ form.errors.messages['form'] | default: 'Invalid email or password.' }}
                    </div>
                  {%- endif -%}

                  <div class="es-login-field">
                    <label class="es-login-label" for="CustomerEmail">{{ 'customer.login.email' | t | default: 'Email address' }}</label>
                    <input
                      type="email"
                      name="customer[email]"
                      id="CustomerEmail"
                      autocomplete="email"
                      placeholder="name@example.com"
                      class="es-login-input"
                      required
                    >
                  </div>

                  <div class="es-login-field">
                    <label class="es-login-label" for="CustomerPassword">{{ 'customer.login.password' | t | default: 'Password' }}</label>
                    <input
                      type="password"
                      name="customer[password]"
                      id="CustomerPassword"
                      autocomplete="current-password"
                      placeholder="••••••••"
                      class="es-login-input"
                      required
                    >
                  </div>

                  <a href="#recover" class="es-login-forgot" onclick="toggleRecover(true)">
                    {{ 'customer.login.forgot_password' | t | default: 'Forgot your password?' }}
                  </a>

                  <button type="submit" class="es-login-btn">
                    {{ 'customer.login.submit' | t | default: 'Sign In' }}
                  </button>

                  <div class="es-login-footer">
                    <span>Don't have an account?</span>
                    <a href="{{ routes.account_register_url }}">{{ 'customer.login.sign_up' | t | default: 'Sign up' }}</a>
                  </div>
                {%- endform -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <!-- Recover Password Container -->
      <div id="RecoverFormContainer" style="display: none;">
        <h1 class="es-login-heading">{{ 'customer.recover_password.title' | t | default: 'Reset Password' }}</h1>
        <p class="es-login-subtext">{{ 'customer.recover_password.subtext' | t | default: 'We will send you an email to reset your password.' }}</p>

        {%- form 'recover_customer_password', class: 'es-login-form' -%}
          {%- if form.errors -%}
            <div class="es-login-error" role="alert">
              {{ form.errors.messages['form'] }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div class="es-login-success" role="status">
              {{ 'customer.recover_password.success_message' | t | default: "We've sent you an email with a link to update your password." }}
            </div>
          {%- else -%}
            <div class="es-login-field">
              <label class="es-login-label" for="RecoverEmail">{{ 'customer.recover_password.email' | t | default: 'Email address' }}</label>
              <input
                type="email"
                name="email"
                id="RecoverEmail"
                autocomplete="email"
                placeholder="name@example.com"
                class="es-login-input"
                required
              >
            </div>

            <button type="submit" class="es-login-btn">
              {{ 'customer.recover_password.submit' | t | default: 'Send Reset Link' }}
            </button>
          {%- endif -%}

          <div class="es-login-footer">
            <a href="#login" onclick="toggleRecover(false)">
              &larr; {{ 'customer.recover_password.back_to_login' | t | default: 'Back to login' }}
            </a>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  function toggleRecover(showRecover) {
    const login = document.getElementById('LoginFormContainer');
    const recover = document.getElementById('RecoverFormContainer');
    if (showRecover) {
      login.style.display = 'none';
      recover.style.display = 'block';
    } else {
      login.style.display = 'block';
      recover.style.display = 'none';
    }
  }

  if (window.location.hash === '#recover') {
    toggleRecover(true);
  }
</script>

{% schema %}
{
  "name": "Customer login",
  "tag": "section",
  "class": "shopify-section--main-customers-login",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side visual image",
      "info": "1200 x 1400px recommended"
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "fields",
      "name": "Login fields",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "return_to",
          "label": "Redirect URL upon login"
        }
      ]
    },
    {
      "type": "@app"
    },
    {
      "type": "liquid",
      "name": "Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer login",
      "blocks": [
        { "type": "fields" }
      ]
    }
  ]
}
{% endschema %}
