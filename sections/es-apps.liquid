{%- comment -%}
  E-sellers Apps - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.background | default: 'transparent' }};
      {% if section.settings.background_gradient != blank %}
        background: {{ section.settings.background_gradient }};
      {% endif %}
      color: {{ section.settings.text_color | default: 'inherit' }};
      {% unless section.settings.remove_vertical_spacing %}
        padding-top: {{ section.settings.padding_top | default: 36 }}px;
        padding-bottom: {{ section.settings.padding_bottom | default: 36 }}px;
      {% endunless %}
    }

    .es-apps-container {
      width: 100%;
      {% if section.settings.full_width %}
        max-width: 100%;
        padding: 0;
      {% else %}
        max-width: var(--page-width, 1200px);
        margin: 0 auto;
        {% unless section.settings.remove_horizontal_spacing %}
          padding: 0 20px;
        {% endunless %}
      {% endif %}
    }

    /* App Block Wrapper */
    .es-app-block {
      width: 100%;
    }
  {%- endstyle -%}

  <!-- ====================================================================== -->
  <!-- HTML / LIQUID LAYOUT                                                   -->
  <!-- ====================================================================== -->
  <div class="es-apps-container">
    {%- for block in section.blocks -%}
      <div class="es-app-block" {{ block.shopify_attributes }}>
        {%- render block -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Apps",
  "class": "section--es-apps",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width container",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "Remove top/bottom padding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_spacing",
      "label": "Remove left/right padding",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "E-sellers Apps"
    }
  ]
}
{% endschema %}
