    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Mobile aspect ratio",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        }
      ],
      "default": "4 / 5"
