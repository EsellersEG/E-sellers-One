{% render 'es-section-style', section: section %}

{%- style -%}
  #es-hair-quiz-banner-{{ section.id }} {
    --banner-bg: {{ section.settings.banner_bg | default: '#1f1d1b' }};
    --banner-text: {{ section.settings.banner_text_color | default: '#ffffff' }};
    --banner-radius: {{ section.settings.banner_radius | default: 16 }}px;
    --banner-pad-dt: {{ section.settings.banner_padding_desktop | default: 48 }}px;
    --banner-pad-mb: {{ section.settings.banner_padding_mobile | default: 24 }}px;
    --pill-bg: {{ section.settings.pill_bg | default: 'rgba(255, 255, 255, 0.1)' }};
    --pill-radius: {{ section.settings.pill_radius | default: 8 }}px;
    --button-bg: {{ section.settings.button_bg | default: '#ffffff' }};
    --button-text: {{ section.settings.button_text_color | default: '#1f1d1b' }};
    --button-radius: {{ section.settings.button_radius | default: 9999 }}px;
    --glow-color: {{ section.settings.glow_color | default: 'rgba(224, 122, 95, 0.2)' }};
    background-color: var(--banner-bg);
    {% if section.settings.banner_gradient != blank %}
      background-image: {{ section.settings.banner_gradient }};
    {% endif %}
    color: var(--banner-text);
    border-radius: var(--banner-radius);
    padding: var(--banner-pad-mb);
  }
  @media (min-width: 1024px) {
    #es-hair-quiz-banner-{{ section.id }} {
      padding: var(--banner-pad-dt);
    }
  }
  #es-hair-quiz-banner-{{ section.id }} .es-diagnostic-pill {
    background-color: var(--pill-bg);
    border-radius: var(--pill-radius);
  }
  #es-hair-quiz-banner-{{ section.id }} .es-quiz-cta-btn {
    background-color: var(--button-bg);
    color: var(--button-text);
    border-radius: var(--button-radius);
  }
  #es-hair-quiz-banner-{{ section.id }} .es-quiz-ambient-glow {
    background-color: var(--glow-color);
  }
{%- endstyle -%}

<section class="w-full py-space-3xl bg-surface section-{{ section.id }}-settings" id="hair-quiz">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div id="es-hair-quiz-banner-{{ section.id }}" class="relative overflow-hidden shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center relative z-10">
        <div class="{% if section.settings.show_graphic %}lg:col-span-7{% else %}lg:col-span-12{% endif %} flex flex-col">
          {% if section.settings.show_badge and section.settings.badge_text != blank %}
            <div class="inline-flex items-center gap-space-xs px-space-md py-space-xs rounded-full bg-surface-container-highest/20 text-pastel-make-my-day self-start mb-space-md"
              style="{% if section.settings.badge_bg != blank %}background-color: {{ section.settings.badge_bg }};{% endif %}{% if section.settings.badge_color != blank %}color: {{ section.settings.badge_color }};{% endif %}">
              {% if section.settings.badge_icon != blank %}
                <span class="material-symbols-outlined text-[16px]">
                  {{ section.settings.badge_icon }}
                </span>
              {% endif %}
              <span class="font-label-sm text-label-sm uppercase tracking-widest font-semibold">
                {{ section.settings.badge_text }}
              </span>
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="font-headline-xl text-headline-xl mb-space-md {% if section.settings.heading_size == 'editorial' %}font-editorial italic font-normal{% elsif section.settings.heading_size == 'large' %}text-3xl lg:text-5xl font-bold{% else %}font-bold{% endif %}" style="color: var(--banner-text);">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="font-body-lg text-body-lg text-neutral-300 max-w-xl mb-space-xl">
              {{ section.settings.description }}
            </p>
          {% endif %}

          <!-- Diagnostic Quick Selector Simulation -->
          {% if section.settings.show_step_pills %}
            <div class="grid grid-cols-3 gap-space-sm max-w-lg mb-space-xl">
              <div class="es-diagnostic-pill p-space-sm text-center">
                <span class="font-label-sm text-label-sm block text-neutral-400">
                  {{ section.settings.step1_label | default: 'Step 1' }}
                </span>
                <span class="font-headline-sm text-headline-sm text-white font-semibold">
                  {{ section.settings.step1_title | default: 'Hair Density' }}
                </span>
              </div>
              <div class="es-diagnostic-pill p-space-sm text-center">
                <span class="font-label-sm text-label-sm block text-neutral-400">
                  {{ section.settings.step2_label | default: 'Step 2' }}
                </span>
                <span class="font-headline-sm text-headline-sm text-white font-semibold">
                  {{ section.settings.step2_title | default: 'Chemical State' }}
                </span>
              </div>
              <div class="es-diagnostic-pill p-space-sm text-center">
                <span class="font-label-sm text-label-sm block text-neutral-400">
                  {{ section.settings.step3_label | default: 'Step 3' }}
                </span>
                <span class="font-headline-sm text-headline-sm text-white font-semibold">
                  {{ section.settings.step3_title | default: 'Egypt Hard Water' }}
                </span>
              </div>
            </div>
          {% endif %}

          <div>
            {% if section.settings.quiz_link != blank %}
              <a href="{{ section.settings.quiz_link }}" class="es-quiz-cta-btn inline-flex items-center justify-center h-14 px-space-2xl font-label-lg text-label-lg tracking-wider uppercase hover:opacity-90 transition-all shadow-md">
                {{ section.settings.button_text | default: 'Start Hair Quiz' }}
              </a>
            {% else %}
              <button type="button" onclick="document.getElementById('es-hair-quiz-modal').classList.remove('hidden')" class="es-quiz-cta-btn inline-flex items-center justify-center h-14 px-space-2xl font-label-lg text-label-lg tracking-wider uppercase hover:opacity-90 transition-all shadow-md">
                {{ section.settings.button_text | default: 'Start Hair Quiz' }}
              </button>
            {% endif %}
          </div>
        </div>

        <!-- Diagnostic Graphic illustration -->
        {% if section.settings.show_graphic %}
          <div class="lg:col-span-5 flex justify-center">
            {% if section.settings.graphic_image != blank %}
              <div class="w-72 h-72 sm:w-80 sm:h-80 rounded-2xl overflow-hidden shadow-2xl">
                <img 
                  src="{{ section.settings.graphic_image | image_url: width: 600 }}" 
                  alt="{{ section.settings.graphic_image.alt | default: 'Hair diagnosis' }}" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            {% else %}
              <div class="relative w-72 h-72 sm:w-80 sm:h-80 rounded-full bg-surface-container/10 flex items-center justify-center p-8">
                <div class="w-full h-full rounded-full border border-dashed border-white/20 {% if section.settings.enable_graphic_rotation %}animate-spin-slow{% endif %} flex items-center justify-center">
                  <div class="w-48 h-48 rounded-full bg-pastel-make-my-day/20 flex flex-col items-center justify-center p-6 text-center backdrop-blur-sm">
                    <span class="material-symbols-outlined text-[36px] text-pastel-make-my-day mb-1">
                      {{ section.settings.graphic_icon | default: 'spa' }}
                    </span>
                    <span class="font-headline-sm text-headline-sm text-white font-semibold">
                      {{ section.settings.graphic_title | default: 'Custom Formula' }}
                    </span>
                    <span class="font-label-sm text-label-sm text-neutral-300">
                      {{ section.settings.graphic_subtitle | default: 'In 60 Seconds' }}
                    </span>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Ambient Background Glow -->
      {% if section.settings.show_ambient_glow %}
        <div class="es-quiz-ambient-glow absolute -bottom-24 -left-24 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-50"></div>
      {% endif %}
    </div>
  </div>

  <!-- Interactive Quiz Modal -->
  <div id="es-hair-quiz-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-surface rounded-2xl max-w-lg w-full p-6 sm:p-8 text-primary shadow-2xl relative">
      <button type="button" onclick="document.getElementById('es-hair-quiz-modal').classList.add('hidden')" class="absolute top-5 right-5 text-text-muted hover:text-primary">
        <span class="material-symbols-outlined">close</span>
      </button>

      <div id="es-quiz-content">
        <div class="inline-flex items-center gap-1 text-secondary font-label-sm uppercase tracking-wider mb-2">
          <span class="material-symbols-outlined text-[16px]">diagnosis</span>
          <span id="es-quiz-step-indicator">Question 1 of 3</span>
        </div>
        <h3 id="es-quiz-question" class="font-headline-md text-headline-md mb-4">
          What is your primary hair concern in Egypt?
        </h3>
        <div id="es-quiz-options" class="space-y-3 mb-6">
          <button type="button" onclick="nextQuizStep('Moisture & More', 'Extreme dryness & Nile water buildup')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Severe dryness &amp; dehydration</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
          <button type="button" onclick="nextQuizStep('Silver Shine', 'Brassiness & color fade from sun/chlorine')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Yellow brassiness in blonde or grey hair</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
          <button type="button" onclick="nextQuizStep('Integrity Intensive', 'Chemical damage & heat styling')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Damaged, bleached, or split ends</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
          <button type="button" onclick="nextQuizStep('Curl Passion', 'Frizz & coastal Alexandria humidity')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Unruly curls and stubborn humidity frizz</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
        </div>
      </div>

      <div id="es-quiz-result" class="hidden text-center py-4">
        <div class="w-16 h-16 rounded-full bg-pastel-flower-vibes/50 text-secondary mx-auto flex items-center justify-center mb-4">
          <span class="material-symbols-outlined text-[32px]">auto_awesome</span>
        </div>
        <span class="font-label-sm uppercase tracking-wider text-text-muted block mb-1">Your Italian Salon Prescription</span>
        <h4 id="es-quiz-result-title" class="font-headline-lg text-headline-lg text-primary mb-2">Moisture &amp; More Routine</h4>
        <p id="es-quiz-result-desc" class="font-body-sm text-body-sm text-on-surface-variant max-w-sm mx-auto mb-6">
          Formulated with organic papaya extract and hyaluronic acid to neutralize water hardness and restore moisture bounce.
        </p>
        <a href="/collections/all" class="inline-flex items-center justify-center h-12 px-space-xl rounded-full bg-primary text-on-primary font-label-md uppercase tracking-wider hover:bg-neutral-800 transition-colors w-full">
          Shop Recommended Routine
        </a>
      </div>
    </div>
  </div>

  <!-- Floating Sticky Action for Tablet & Mobile Viewports -->
  {% if section.settings.show_floating_button %}
    <div class="fixed bottom-4 right-4 z-30 flex items-center gap-2 md:hidden" data-purpose="floating-tablet-action">
      <button 
        type="button" 
        onclick="document.getElementById('es-hair-quiz-modal').classList.remove('hidden')" 
        class="flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-full shadow-lg hover:opacity-90 transition-all border border-white/20"
        style="background-color: {{ section.settings.floating_button_bg | default: '#1f1d1b' }}; color: {{ section.settings.floating_button_text_color | default: '#fcf9f4' }};"
      >
        <span>{{ section.settings.floating_button_icon | default: '✨' }}</span>
        <span>{{ section.settings.floating_button_text | default: 'Diagnostic Quiz' }}</span>
      </button>
    </div>
  {% endif %}

  <script>
    let currentQuizStep = 1;
    function nextQuizStep(routineName, reason) {
      currentQuizStep++;
      if (currentQuizStep === 2) {
        document.getElementById('es-quiz-step-indicator').innerText = 'Question 2 of 3';
        document.getElementById('es-quiz-question').innerText = 'Where is your home water source located?';
        document.getElementById('es-quiz-options').innerHTML = `
          <button type="button" onclick="nextQuizStep('${routineName}', '${reason}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Greater Cairo &amp; Giza (Chlorinated River Water)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
          <button type="button" onclick="nextQuizStep('${routineName}', '${reason}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Alexandria &amp; North Coast (Salt air + hard water)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
          <button type="button" onclick="nextQuizStep('${routineName}', '${reason}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Red Sea / Sinai (Desalinated mineral water)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">chevron_right</span>
          </button>
        `;
      } else if (currentQuizStep === 3) {
        document.getElementById('es-quiz-step-indicator').innerText = 'Question 3 of 3';
        document.getElementById('es-quiz-question').innerText = 'What is your hair density and texture?';
        document.getElementById('es-quiz-options').innerHTML = `
          <button type="button" onclick="finishQuiz('${routineName}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Fine or thinning (Needs weightless lift)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">check_circle</span>
          </button>
          <button type="button" onclick="finishQuiz('${routineName}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Medium / Wavy (Balanced hydration)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">check_circle</span>
          </button>
          <button type="button" onclick="finishQuiz('${routineName}')" class="w-full text-left p-3.5 rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container transition-all flex items-center justify-between">
            <span>Thick, Coarse or Afro-texture (Needs deep lipid seal)</span>
            <span class="material-symbols-outlined text-text-muted text-[20px]">check_circle</span>
          </button>
        `;
      }
    }

    function finishQuiz(routineName) {
      document.getElementById('es-quiz-content').classList.add('hidden');
      document.getElementById('es-quiz-result').classList.remove('hidden');
      document.getElementById('es-quiz-result-title').innerText = routineName + ' Routine';
    }
  </script>
</section>

