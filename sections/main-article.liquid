{%- comment -%}
  Main Article Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .main-article {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .main-article__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .main-article__title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.heading_color | default: '#121212' }};
    margin: 0 0 16px;
  }

  .main-article__meta {
    font-size: 0.9rem;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .main-article__image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 40px;
  }

  .main-article__content {
    color: {{ section.settings.text_color | default: '#121212' }};
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .main-article__content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 24px 0;
  }
{%- endstyle -%}

<article class="main-article page-width">
  <header class="main-article__header">
    <h1 class="main-article__title">{{ article.title }}</h1>
    <div class="main-article__meta">
      <span>{{ article.author }}</span>
      <span>•</span>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
    </div>
  </header>

  {%- if article.image -%}
    {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'main-article__image', alt: article.title }}
  {%- endif -%}

  <div class="main-article__content rte">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Main article",
  "tag": "section",
  "class": "section--main-article",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ]
}
{% endschema %}
