{%- comment -%}
  Main Password Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#121212' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
  }

  .main-password__box {
    max-width: 540px;
    width: 100%;
  }

  .main-password__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 16px;
    color: inherit;
  }

  .main-password__subtext {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 32px;
  }

  .main-password__form {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }

  .main-password__input {
    flex: 1;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    font-size: 1rem;
    outline: none;
  }

  .main-password__btn {
    background: #ffffff;
    color: #121212;
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="main-password page-width">
  <div class="main-password__box">
    <h1 class="main-password__title">{{ shop.name }}</h1>
    <p class="main-password__subtext">Opening soon. Enter store password to access.</p>

    {%- form 'storefront_password', class: 'main-password__form' -%}
      {%- if form.errors -%}
        <div style="color: #ef4444; width: 100%; margin-bottom: 12px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <input
        type="password"
        name="password"
        id="Password"
        class="main-password__input"
        placeholder="Enter store password"
        required
      >
      <button type="submit" class="main-password__btn">
        Enter
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Main password",
  "tag": "section",
  "class": "section--main-password",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
