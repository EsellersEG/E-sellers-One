{%- comment -%}
  E-sellers Products Bundle Selection - E-sellers One (v5.0.0)

  "Mix and match" bundle builder: a collection's products in a grid with
  checkboxes; a sticky bar tracks how many are selected and which discount
  tier that unlocks, then adds every selection to the cart in one request.

  Distinct from es-buy-together (which pairs specific curated products) - this
  lets the shopper choose freely from an entire collection.
{%- endcomment -%}

{%- liquid
  assign es_pbs_collection = section.settings.collection
  assign es_pbs_tiers = section.blocks | where: 'type', 'tier'
-%}

{%- if es_pbs_collection != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px;
    }

    #shopify-section-{{ section.id }} .es-pbs__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
      gap: {{ section.settings.column_gap | default: 16 }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-pbs__grid { grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, minmax(0, 1fr)); }
    }

    #shopify-section-{{ section.id }} .es-pbs__card {
      position: relative;
      border: 2px solid var(--es-rule);
      border-radius: var(--es-radius-lg);
      padding: var(--es-space-3);
      cursor: pointer;
      transition: border-color var(--es-dur-fast) var(--es-ease);
    }
    #shopify-section-{{ section.id }} .es-pbs__card.is-selected { border-color: var(--es-fg); }
    #shopify-section-{{ section.id }} .es-pbs__card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: var(--es-radius-md); margin-bottom: var(--es-space-2); }
    #shopify-section-{{ section.id }} .es-pbs__card-title { font-size: var(--es-text-sm); font-weight: 600; }
    #shopify-section-{{ section.id }} .es-pbs__card-price { font-size: var(--es-text-xs); color: var(--es-fg-muted); }
    #shopify-section-{{ section.id }} .es-pbs__check {
      position: absolute; top: var(--es-space-2); right: var(--es-space-2);
      width: 22px; height: 22px; border-radius: 50%;
      border: 2px solid var(--es-rule-strong);
      background: var(--es-bg);
      display: flex; align-items: center; justify-content: center;
    }
    #shopify-section-{{ section.id }} .es-pbs__card.is-selected .es-pbs__check { background: var(--es-fg); border-color: var(--es-fg); }
    #shopify-section-{{ section.id }} .es-pbs__check svg { width: 12px; height: 12px; color: var(--es-bg); opacity: 0; }
    #shopify-section-{{ section.id }} .es-pbs__card.is-selected .es-pbs__check svg { opacity: 1; }

    #shopify-section-{{ section.id }} .es-pbs__bar {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 40;
      background: var(--es-bg);
      border-top: var(--es-rule-width) solid var(--es-rule);
      box-shadow: 0 -4px 20px rgba(0,0,0,.08);
      padding: var(--es-space-3) var(--es-gutter);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--es-space-3);
      transform: translateY(100%);
      transition: transform var(--es-dur-base) var(--es-ease-out);
    }
    #shopify-section-{{ section.id }} .es-pbs__bar.is-visible { transform: translateY(0); }
    #shopify-section-{{ section.id }} .es-pbs__bar-info { font-size: var(--es-text-sm); }
    #shopify-section-{{ section.id }} .es-pbs__bar-tier { font-weight: 700; }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description -%}

    {%- if es_pbs_tiers.size > 0 -%}
      <p class="es-pbs__tiers-note">
        {%- for tier in es_pbs_tiers -%}
          {{ tier.settings.quantity }}+ = {{ tier.settings.discount_label | escape }}{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </p>
    {%- endif -%}

    <div class="es-pbs__grid" data-es-pbs-grid data-max-items="{{ section.settings.limit | default: 12 }}">
      {%- for product in es_pbs_collection.products limit: section.settings.limit | default: 12 -%}
        <div class="es-pbs__card" data-es-pbs-card data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-title="{{ product.title | escape }}" tabindex="0" role="checkbox" aria-checked="false">
          {%- if product.featured_image != blank -%}
            {%- assign es_pbs_alt = product.title | escape -%}
            {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: es_pbs_alt }}
          {%- endif -%}
          <div class="es-pbs__card-title">{{ product.title }}</div>
          <div class="es-pbs__card-price">{{ product.price | money }}</div>
          <span class="es-pbs__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="es-pbs__bar" data-es-pbs-bar>
    <span class="es-pbs__bar-info"><span data-es-pbs-count>0</span> selected &mdash; <span class="es-pbs__bar-tier" data-es-pbs-tier></span></span>
    <button type="button" class="es-btn" data-es-pbs-add disabled>Add selected to cart</button>
  </div>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var cards = root.querySelectorAll('[data-es-pbs-card]');
      var bar = root.querySelector('[data-es-pbs-bar]');
      var countEl = root.querySelector('[data-es-pbs-count]');
      var tierEl = root.querySelector('[data-es-pbs-tier]');
      var addBtn = root.querySelector('[data-es-pbs-add]');
      var tiers = {{ es_pbs_tiers | map: 'settings' | json }};

      var selected = {};

      function tierFor(count) {
        var best = null;
        tiers.forEach(function (t) {
          if (count >= (t.quantity || 0)) best = t.discount_label;
        });
        return best;
      }

      function update() {
        var ids = Object.keys(selected);
        countEl.textContent = ids.length;
        var label = tierFor(ids.length);
        tierEl.textContent = label || '';
        addBtn.disabled = ids.length === 0;
        bar.classList.toggle('is-visible', ids.length > 0);
      }

      cards.forEach(function (card) {
        card.addEventListener('click', function () { toggle(card); });
        card.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(card); }
        });
      });

      function toggle(card) {
        var id = card.dataset.variantId;
        var isSelected = card.classList.toggle('is-selected');
        card.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        if (isSelected) { selected[id] = true; } else { delete selected[id]; }
        update();
      }

      addBtn.addEventListener('click', function () {
        var items = Object.keys(selected).map(function (id) { return { id: id, quantity: 1 }; });
        if (!items.length) return;
        addBtn.disabled = true;
        fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root || '/') + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (r) { return r.json(); })
          .then(function () { window.location.href = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root || '/') + 'cart'; })
          .catch(function () { addBtn.disabled = false; });
      });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Choose a collection to populate this bundle builder.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Products Bundle Selection",
  "tag": "section",
  "class": "shopify-section--es-products-bundle-selection",
  "settings": [
    {
      "type": "paragraph",
      "content": "Discount tiers are shown to the shopper as an incentive label only. Create a matching Shopify automatic discount (quantity-based) so the price actually adjusts at checkout."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your bundle" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "column_gap", "label": "Gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Discount tier",
      "settings": [
        { "type": "range", "id": "quantity", "label": "Minimum items", "min": 2, "max": 10, "step": 1, "default": 2 },
        { "type": "text", "id": "discount_label", "label": "Discount label", "default": "10% off" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "E-sellers Products Bundle Selection",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 2, "discount_label": "10% off" } },
        { "type": "tier", "settings": { "quantity": 3, "discount_label": "15% off" } }
      ]
    }
  ]
}
{% endschema %}
