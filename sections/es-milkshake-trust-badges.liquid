      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Grid gap",
      "default": 16
    },
    {
      "type": "select",
      "id": "item_alignment",
      "label": "Item alignment",
      "options": [
        {
          "value": "left",
          "label": "Horizontal (Icon Left)"
        },
        {
          "value": "center",
