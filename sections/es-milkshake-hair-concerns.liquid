<section id="hair-concerns" class="w-full py-space-3xl bg-surface">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl">
      <div>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-text-muted mb-space-xs block">
          {{ section.settings.subheading | default: 'Prescribed Rituals' }}
        </span>
        <h2 class="font-headline-xl text-headline-xl text-primary">
          {{ section.settings.heading | default: 'Shop by Hair Concern' }}
        </h2>
      </div>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-md mt-space-sm md:mt-0">
        {{ section.settings.description | default: 'Targeted formulations infused with active milk whey, murumuru butter, and berry extracts for customized restorative hair therapy.' }}
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-space-md">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a
            class="group flex flex-col items-center text-center p-space-md rounded-xl bg-surface-container-lowest {{ block.settings.hover_class | default: 'hover:bg-pastel-moisture-plus/40' }} transition-all duration-300 shadow-sm"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden mb-space-md bg-surface-container shadow-sm group-hover:scale-105 transition-transform">
              {%- if block.settings.image != blank -%}
                <img
                  class="w-full h-full object-cover"
                  alt="{{ block.settings.title | escape }}"
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  loading="lazy"
                />
              {%- else -%}
                <img
                  class="w-full h-full object-cover"
                  alt="{{ block.settings.title | escape }}"
                  src="{{ block.settings.image_url }}"
                  loading="lazy"
                />
              {%- endif -%}
            </div>
            <span class="font-headline-sm text-headline-sm text-primary mb-1">
              {{ block.settings.title }}
            </span>
            <span class="font-body-sm text-body-sm text-text-muted">
              {{ block.settings.subtitle }}
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback to 6 default concerns -->
        <a class="group flex flex-col items-center text-center p-space-md rounded-xl bg-surface-container-lowest hover:bg-pastel-moisture-plus/40 transition-all duration-300 shadow-sm" href="#">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden mb-space-md bg-surface-container shadow-sm group-hover:scale-105 transition-transform">
            <img class="w-full h-full object-cover" alt="Dry Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-RsWRnhA_FyZLVVJ76QIGwjT8SwZuCSkQj8EYfuQT_YFXmzDx0VUTLj6Vi2ZoOgoHSDe9LsEkfH2oFNF84_jRwnuKjUvFVCAfBWeLqoEi5E1K2CKlaTe6oul9oXKcmjua9YKXoLeZmtOC033LJSWxuyAKVoIyDij7MIjKBBvirhQDyqP3PZzRG1NuzEo1N7Di5lFdIIeGpqXROseF-bD7AbhZaIPmxZR1Ql6-QsKetSPPUZmy0xU" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Dry Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Moisture &amp; More</span>
        </a>
        <a class="group flex flex-col items-center text-center p-space-md rounded-xl bg-surface-container-lowest hover:bg-pastel-flower-vibes/40 transition-all duration-300 shadow-sm" href="#">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden mb-space-md bg-surface-container shadow-sm group-hover:scale-105 transition-transform">
            <img class="w-full h-full object-cover" alt="Damaged Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBnyNSFFZe_Ldw5lifVF4T8B_TPLUaUZY8UV8DLGyWqeU1Oc3gESIwB2QbQpB16QELKcBCgpMkzoPS0r1MWh_-4KxrTlJhu07G_6lcMr_F8kdgeSxqAdUzodo8jmJ-tbyEs-ain8e53zWLSiQASalwKibnspGRMRexvp2gb77QXATiaSc10XTn44wE2Vbd6op0xmgcN6jtQQfNavZFiwx_XivLglnwZ1XuwF-saWtsS-ofNfP7Vz4o" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Damaged Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Integrity System</span>
        </a>
        <a class="group flex flex-col items-center text-center p-space-md rounded-xl bg-surface-container-lowest hover:bg-pastel-make-my-day/40 transition-all duration-300 shadow-sm" href="#">
