    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Hair Concern"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Targeted formulations infused with active milk whey, murumuru butter, and berry extracts for customized restorative hair therapy."
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Hair Concern",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
