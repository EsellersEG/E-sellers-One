{% render 'es-section-style', section: section %}

{%- assign is_carousel = false -%}
{%- if section.settings.layout_type == 'carousel' -%}
  {%- assign is_carousel = true -%}
{%- endif -%}

{%- assign img_shape_class = 'es-shape-circle' -%}
{%- if section.settings.image_shape == 'rounded' -%}
  {%- assign img_shape_class = 'es-shape-rounded' -%}
{%- elsif section.settings.image_shape == 'portrait' -%}
  {%- assign img_shape_class = 'es-shape-portrait' -%}
{%- endif -%}

{%- assign hover_effect = 'group-hover:scale-105' -%}
{%- if section.settings.image_hover == 'lift' -%}
  {%- assign hover_effect = 'group-hover:-translate-y-1' -%}
{%- elsif section.settings.image_hover == 'none' -%}
  {%- assign hover_effect = '' -%}
{%- endif -%}

{%- style -%}
  #hair-concerns-{{ section.id }} {
    --cols-desktop: {{ section.settings.columns_desktop | default: 6 }};
    --cols-tablet: {{ section.settings.columns_tablet | default: 3 }};
    --cols-mobile: {{ section.settings.columns_mobile | default: 2 }};
    --grid-gap: {{ section.settings.grid_gap | default: 16 }}px;
  }
  .concern-card-{{ section.id }} {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 12 }}px;
    padding: {{ section.settings.card_padding | default: 16 }}px;
    text-align: {{ section.settings.text_alignment | default: 'center' }};
  }
  {%- if section.settings.image_size == 'small' -%}
    .concern-img-{{ section.id }} { width: 5rem; height: 5rem; }
  {%- elsif section.settings.image_size == 'large' -%}
    .concern-img-{{ section.id }} { width: 8.5rem; height: 8.5rem; }
  {%- else -%}
    .concern-img-{{ section.id }} { width: 6rem; height: 6rem; }
    @media (min-width: 640px) { .concern-img-{{ section.id }} { width: 7rem; height: 7rem; } }
  {%- endif -%}
{%- endstyle -%}

<section id="hair-concerns-{{ section.id }}" class="w-full py-space-3xl bg-surface section-{{ section.id }}-settings">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl">
      <div>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-text-muted mb-space-xs block">
          {{ section.settings.subheading | default: 'Prescribed Rituals' }}
        </span>
        <h2 class="font-headline-xl text-headline-xl text-primary">
          {{ section.settings.heading | default: 'Shop by Hair Concern' }}
        </h2>
      </div>
      <div class="flex items-end justify-between gap-4 mt-space-sm md:mt-0">
        <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          {{ section.settings.description | default: 'Targeted formulations infused with active milk whey, murumuru butter, and berry extracts for customized restorative hair therapy.' }}
        </p>
        {%- if is_carousel and section.settings.show_arrows -%}
          <div class="hidden sm:flex items-center gap-2 flex-shrink-0">
            <button type="button" data-carousel-prev="ConcernsTrack-{{ section.id }}" aria-label="Previous" class="w-10 h-10 rounded-full border border-warm-border bg-surface flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors shadow-sm cursor-pointer">
              <span class="material-symbols-outlined text-lg">arrow_back</span>
            </button>
            <button type="button" data-carousel-next="ConcernsTrack-{{ section.id }}" aria-label="Next" class="w-10 h-10 rounded-full border border-warm-border bg-surface flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors shadow-sm cursor-pointer">
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div id="ConcernsTrack-{{ section.id }}" class="{% if is_carousel %}es-carousel-track{% else %}es-collection-grid{% endif %}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign target_url = block.settings.link -%}
          {%- assign target_title = block.settings.title -%}
          {%- if block.settings.collection != blank -%}
            {%- assign coll = collections[block.settings.collection] -%}
            {%- assign target_url = coll.url -%}
            {%- if target_title == blank -%}{%- assign target_title = coll.title -%}{%- endif -%}
          {%- endif -%}
          <a
            class="group concern-card-{{ section.id }} flex flex-col items-center {{ block.settings.hover_class | default: 'hover:bg-pastel-moisture-plus/40' }} transition-all duration-300 shadow-sm"
            href="{{ target_url | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
              {%- if block.settings.image != blank -%}
                <img
                  class="w-full h-full object-cover"
                  alt="{{ target_title | escape }}"
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  loading="lazy"
                />
              {%- elsif block.settings.collection != blank and collections[block.settings.collection].featured_image != blank -%}
                <img
                  class="w-full h-full object-cover"
                  alt="{{ target_title | escape }}"
                  src="{{ collections[block.settings.collection].featured_image | image_url: width: 300 }}"
                  loading="lazy"
                />
              {%- else -%}
                <img
                  class="w-full h-full object-cover"
                  alt="{{ target_title | escape }}"
                  src="{{ block.settings.image_url }}"
                  loading="lazy"
                />
              {%- endif -%}
            </div>
            <span class="font-headline-sm text-headline-sm text-primary mb-1">
              {{ target_title }}
            </span>
            <span class="font-body-sm text-body-sm text-text-muted">
              {{ block.settings.subtitle }}
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback to 6 default concerns -->
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-pastel-moisture-plus/40 transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Dry Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-RsWRnhA_FyZLVVJ76QIGwjT8SwZuCSkQj8EYfuQT_YFXmzDx0VUTLj6Vi2ZoOgoHSDe9LsEkfH2oFNF84_jRwnuKjUvFVCAfBWeLqoEi5E1K2CKlaTe6oul9oXKcmjua9YKXoLeZmtOC033LJSWxuyAKVoIyDij7MIjKBBvirhQDyqP3PZzRG1NuzEo1N7Di5lFdIIeGpqXROseF-bD7AbhZaIPmxZR1Ql6-QsKetSPPUZmy0xU" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Dry Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Moisture &amp; More</span>
        </a>
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-pastel-flower-vibes/40 transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Damaged Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBnyNSFFZe_Ldw5lifVF4T8B_TPLUaUZY8UV8DLGyWqeU1Oc3gESIwB2QbQpB16QELKcBCgpMkzoPS0r1MWh_-4KxrTlJhu07G_6lcMr_F8kdgeSxqAdUzodo8jmJ-tbyEs-ain8e53zWLSiQASalwKibnspGRMRexvp2gb77QXATiaSc10XTn44wE2Vbd6op0xmgcN6jtQQfNavZFiwx_XivLglnwZ1XuwF-saWtsS-ofNfP7Vz4o" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Damaged Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Integrity System</span>
        </a>
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-pastel-make-my-day/40 transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Curly Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDvF4mQ5Tje-jmyjJiz1NMb8rr_d6cgpk2irwgvG5B5EKJTzrHf05aMh-7GQOnN8SXGsPh_rWZQcKqZMnr_R7XwJEO4EK3D3KibcT2iBSO6CYspRadFi7ectiu5oU9PnTGzPh6twlLU23bUdxc2eSaNOOdtEGf8FRcNhKeOaEch3dmgXlyX4V_d0dRzSWdL6BXIlHZBtvOcsAKsHQRvZsbfuVAByhJmdWouVcWZp5LPZkBDY9iQg2k" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Curly Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Curl Passion</span>
        </a>
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-pastel-silver-shine/50 transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Blond & Highlighted" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLU_zqc4Nlt49_0iYnx7n6nxIZKdJJVJa3HAHporxe-BxujKyYqdLNgzcgQMFZ4owQC823dLh2CbHzMz-NDWf3u2-Xlbg9yw2VW4t4trconA-Z4Rn7eamdfXjGhj_A0-ekJS_9wLH6HV_rQlMuBebl6CcjBrJPsouW2Ub2Edd43PQrrhVSK8i7zbGNvuUpdxSBr1DPJYf9oqh4OkIxmsVBnxINodXKqnFD0iMYT4KOEeSOLTtU5CU" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Blond &amp; Highlighted</span>
          <span class="font-body-sm text-body-sm text-text-muted">Silver Shine &amp; Icy</span>
        </a>
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-surface-container-high transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Clean & Fresh" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDo5WR2L0wdbmCvkDgQuNkc2T4onkJYwHRi_iNSEsCZwnZsRzhirXymmccUoWmwLFICuuUVHbs1Vvj3gUbNsjckEBqrdmQ0QhM6j7gR97-2XXOD0kmMTHpJP68LppslGJzPSRts2gKtlcz3YwVIjTjfgDKuXtHrdJXC2zz4kzaoPLBBC0FYDh3YN2_Pmbr2hbydc2lXwrrYotpd-QpvdiLVM63XXj6d2tVg9Gd2qxVPQuDrUI6FSDw" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Clean &amp; Fresh</span>
          <span class="font-body-sm text-body-sm text-text-muted">Deep Detox Scalp</span>
        </a>
        <a class="group concern-card-{{ section.id }} flex flex-col items-center hover:bg-pastel-make-my-day/40 transition-all duration-300 shadow-sm" href="#">
          <div class="concern-img-{{ section.id }} {{ img_shape_class }} overflow-hidden mb-space-md bg-surface-container shadow-sm {{ hover_effect }} transition-transform">
            <img class="w-full h-full object-cover" alt="Normal Hair" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCz4FEdTV8gg-Q2V-BFnztNZDVQ6vTK1t2cUlhMr-O_miUz_zPGr5JRISh2i_Oe7YVDus3B-yWPG-bPrZY4ouPY-fDGwzokDWY9QoXczEKik2UTlchcki1zXDtCOY9ec3rrUN5aDnXCG6545bIPtA1bV3F1CmJRyRGoq_gWCy8jVrhFbxf9Ecfj1TsY32YlUsDGo9Edb7huRXQ9S8QPP4BLqnU3q6C0jhcbk5dh0rAUkn2NqT1GNJY" loading="lazy" />
          </div>
          <span class="font-headline-sm text-headline-sm text-primary mb-1">Normal Hair</span>
          <span class="font-body-sm text-body-sm text-text-muted">Make My Day</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Milkshake Hair Concerns",
  "tag": "section",
  "class": "es-milkshake-hair-concerns-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Prescribed Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Hair Concern"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Targeted formulations infused with active milk whey, murumuru butter, and berry extracts for customized restorative hair therapy."
    },
    {
      "type": "header",
      "content": "Layout & Carousel Mode"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Mode",
      "options": [
        {
          "value": "grid",
          "label": "Standard Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel / Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop columns",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid / Carousel gap",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true,
      "info": "Active when Carousel mode is enabled"
    },
    {
      "type": "header",
      "content": "Cards & Imagery"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "circle",
          "label": "Circle (1:1)"
        },
        {
          "value": "rounded",
          "label": "Rounded Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "circle"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        {
          "value": "small",
          "label": "Small (80px)"
        },
        {
          "value": "medium",
          "label": "Medium (112px)"
        },
        {
          "value": "large",
          "label": "Large (136px)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_hover",
      "label": "Hover animation",
      "options": [
        {
          "value": "zoom",
          "label": "Zoom in"
        },
        {
          "value": "lift",
          "label": "Lift card up"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "zoom"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fcf9f4"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors and Background"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Border and Radius"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Desktop)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Mobile and Tablet)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS rules",
      "info": "Write CSS targeting .section-{{ section.id }}-settings or child classes"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Hair Concern",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to Collection (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (Fallback)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Concern Name",
          "default": "Dry Hair"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Routine / Subtitle",
          "default": "Moisture & More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (used if no collection is selected)"
        },
        {
          "type": "text",
          "id": "hover_class",
          "label": "Hover Background Class",
          "default": "hover:bg-pastel-moisture-plus/40"
        }
      ]
    }
  ],
