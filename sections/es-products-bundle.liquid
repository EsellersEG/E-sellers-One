{%- comment -%}
  E-sellers Products Bundle - E-sellers One (v5.0.0)

  Shoppable lifestyle image: merchant pins product hotspots at chosen
  coordinates over one image, each opening a small product popover on
  hover/tap. For a true multi-product "buy all together" checkout flow, use
  es-buy-together instead - this section is the visual "shop the scene" style.
{%- endcomment -%}

{%- liquid
  assign es_pb_pins = section.blocks | where: 'type', 'product'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }

  #shopify-section-{{ section.id }} .es-pb {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    aspect-ratio: {{ section.settings.image_ratio | default: '4/5' }};
    border-radius: var(--es-radius-lg);
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .es-pb__frame { position: absolute; inset: 0; border-radius: var(--es-radius-lg); overflow: hidden; }
  #shopify-section-{{ section.id }} .es-pb__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .es-pb__pin {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .es-pb__dot {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #fff;
    color: #121212;
    border: none;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .es-pb__dot svg { width: 14px; height: 14px; }
  #shopify-section-{{ section.id }} .es-pb__popover {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    background: var(--es-bg);
    border-radius: var(--es-radius-md);
    box-shadow: var(--es-elev-3);
    padding: var(--es-space-3);
    opacity: 0;
    visibility: hidden;
    translate: 0 6px;
    transition: opacity var(--es-dur-fast) var(--es-ease), translate var(--es-dur-fast) var(--es-ease), visibility var(--es-dur-fast);
  }
  #shopify-section-{{ section.id }} .es-pb__pin[data-open="true"] .es-pb__popover {
    opacity: 1; visibility: visible; translate: 0 0;
  }
{%- endstyle -%}

<div class="page-width">
  {%- render 'es-section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: 'center' -%}

  <div class="es-pb">
    <div class="es-pb__frame">
      {%- if section.settings.image != blank -%}
        {%- assign es_pb_alt = section.settings.heading | escape -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', alt: es_pb_alt }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
      {%- endif -%}
    </div>

    {%- for block in es_pb_pins -%}
      {%- assign es_pb_product = block.settings.product -%}
      <div class="es-pb__pin" data-es-pb-pin data-open="false"
           style="left:{{ block.settings.horizontal_position | default: 50 }}%; top:{{ block.settings.vertical_position | default: 50 }}%;"
           {{ block.shopify_attributes }}>
        <button type="button" class="es-pb__dot" aria-label="{{ es_pb_product.title | default: 'View product' | escape }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="es-pb__popover">
          {%- if es_pb_product != blank -%}
            {%- render 'horizontal-product', product: es_pb_product -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var pins = root.querySelectorAll('[data-es-pb-pin]');
    function closeAll(except) { pins.forEach(function (p) { if (p !== except) p.dataset.open = 'false'; }); }
    pins.forEach(function (pin) {
      var btn = pin.querySelector('.es-pb__dot');
      if (!btn) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = pin.dataset.open === 'true';
        closeAll(pin);
        pin.dataset.open = open ? 'false' : 'true';
      });
    });
    document.addEventListener('click', function (e) { if (!root.contains(e.target)) closeAll(null); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(null); });
  })();
</script>

{% schema %}
{
  "name": "E-sellers Products Bundle",
  "tag": "section",
  "class": "shopify-section--es-products-bundle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "16/9", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product pin",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "horizontal_position", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "vertical_position", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "E-sellers Products Bundle",
      "blocks": [
        { "type": "product", "settings": { "horizontal_position": 30, "vertical_position": 40 } },
        { "type": "product", "settings": { "horizontal_position": 65, "vertical_position": 60 } }
      ]
    }
  ]
}
{% endschema %}
