          <div class="mt-auto flex items-baseline gap-space-sm">
            <span class="font-price-sale text-price-sale text-badge-sale">LE 1,080.00</span>
            <span class="font-price-regular text-price-regular line-through text-text-muted">LE 1,200.00</span>
          </div>
        </div>

        <!-- Product 4 -->
        <div class="group relative flex flex-col rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all">
          <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container mb-space-md">
            <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-pastel-moisture-plus text-primary font-label-sm text-label-sm uppercase tracking-wider">
              Hydration
            </span>
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="moisture&more concentrated serum" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-mfnHhV7P0N9Va9la8gS77kewNFtYT2YSX80i1L7FgC-Od47SEcWhPeU8jSfU8HUHyMk7dI5C5HErq_An60iw3jn1g_Nx4TPhQIPFn-f-R_qy6_W5tYUB2nSDWtytvX7Jv8zdf6vDFraGEt-5QycxIwXoueFObrXk_9WhNAWaY3koFvxttDGeNoASrhn_9YxOI4Lp9YR0h-laLSI8IUU4kfsEFQ3zVOvkNsS15E83ntq1jSpMZ3c" loading="lazy" />
            <button type="button" class="absolute bottom-3 left-3 right-3 h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-space-xs shadow-md">
              <span class="material-symbols-outlined text-[18px]">add</span>
              Quick Add
            </button>
          </div>
          <div class="flex items-center gap-1 text-[#D4AF37] mb-1">
            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="font-body-sm text-body-sm text-text-muted">4.9 (118 reviews)</span>
          </div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">milk_shake®</span>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs line-clamp-2">
            moisture&amp;more concentrated serum
          </h3>
          <div class="mt-auto flex items-baseline gap-space-sm">
            <span class="font-body-sm text-body-sm text-text-muted">From</span>
