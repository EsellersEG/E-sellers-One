<section class="w-full py-space-3xl bg-surface-cream" id="bestsellers" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-space-2xl">
      <div>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-space-xs block">
          {{ section.settings.subheading | default: 'Salon Favorites' }}
        </span>
        <h2 class="font-headline-xl text-headline-xl text-primary">
          {{ section.settings.heading | default: 'Back in Stock & Trending Now' }}
        </h2>
      </div>
      <div class="flex items-center gap-space-sm mt-space-sm sm:mt-0">
        <button type="button" aria-label="Previous" class="w-11 h-11 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        </button>
        <button type="button" aria-label="Next" class="w-11 h-11 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[20px]">chevron_right</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-lg">
      {%- assign display_products = nil -%}
      {%- if section.settings.product_list != blank and section.settings.product_list.count > 0 -%}
        {%- assign display_products = section.settings.product_list -%}
      {%- elsif section.settings.collection != blank and collections[section.settings.collection].products_count > 0 -%}
        {%- assign display_products = collections[section.settings.collection].products -%}
      {%- endif -%}

      {%- if display_products != nil -%}
        {%- for product in display_products limit: 4 -%}
          <div class="group relative flex flex-col rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all">
            <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container mb-space-md">
              {%- if product.compare_at_price > product.price -%}
                <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-badge-sale text-on-error font-label-sm text-label-sm uppercase tracking-wider">
                  On Sale
                </span>
              {%- endif -%}
              <a href="{{ product.url }}" class="block w-full h-full">
                {%- if product.featured_image != blank -%}
                  <img
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    alt="{{ product.title | escape }}"
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    loading="lazy"
                  />
                {%- endif -%}
              </a>
              <form method="post" action="{{ routes.cart_add_url }}" class="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase flex items-center justify-center gap-space-xs shadow-md hover:bg-neutral-800 transition-colors">
                  <span class="material-symbols-outlined text-[18px]">add</span>
                  Quick Add
                </button>
              </form>
            </div>
            <div class="flex items-center gap-1 text-[#D4AF37] mb-1">
              <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="font-body-sm text-body-sm text-text-muted">4.9 (salon verified)</span>
            </div>
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">
              {{ product.vendor | default: 'milk_shake®' }}
            </span>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs line-clamp-2">
              <a href="{{ product.url }}" class="hover:text-neutral-700 transition-colors">{{ product.title }}</a>
            </h3>
            <div class="mt-auto flex items-baseline gap-space-sm">
              <span class="font-price-sale text-price-sale text-primary">
                {{ product.price | money }}
              </span>
              {%- if product.compare_at_price > product.price -%}
                <span class="font-price-regular text-price-regular line-through text-text-muted">
                  {{ product.compare_at_price | money }}
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback to exact 4 Stitch Products -->
        <!-- Product 1 -->
        <div class="group relative flex flex-col rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all">
          <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container mb-space-md">
            <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-badge-sale text-on-error font-label-sm text-label-sm uppercase tracking-wider">
              On Sale
            </span>
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="incredible milk leave in spray" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAuMln9dRfRPNurVA1hb5vjqm1N5hR-il_uTSfZ_-zJqbzDYAFe2FdRVWsHnhuAqn2A0lG2atPaAK5TyPA0QpYLqJUNNA5K4rmqXVFw0GU6u7VwhzW2Re9TL3qWVrGG2QOyMnvgdwe0loiTCbfkNCwn5N3A1M0KW4f7VZDu0d3sUE4sMbODpfztuHlMqRYBnAhsqH8fUKP6klwS5vENzwz31W5qHK3gqmedmMYgTaDxZmlq1pTgwDs" loading="lazy" />
            <button type="button" class="absolute bottom-3 left-3 right-3 h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-space-xs shadow-md">
              <span class="material-symbols-outlined text-[18px]">add</span>
              Quick Add
            </button>
          </div>
          <div class="flex items-center gap-1 text-[#D4AF37] mb-1">
            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="font-body-sm text-body-sm text-text-muted">4.9 (184 reviews)</span>
          </div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">milk_shake®</span>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs line-clamp-2">
            incredible milk leave in spray (12 benefits)
          </h3>
          <div class="mt-auto flex items-baseline gap-space-sm">
            <span class="font-body-sm text-body-sm text-text-muted">From</span>
            <span class="font-price-sale text-price-sale text-primary">LE 99.00</span>
          </div>
        </div>

        <!-- Product 2 -->
        <div class="group relative flex flex-col rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all">
          <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container mb-space-md">
