            {%- if section.settings.show_quick_add -%}
              <button type="button" class="absolute bottom-3 left-3 right-3 h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-space-xs shadow-md cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add</span>
