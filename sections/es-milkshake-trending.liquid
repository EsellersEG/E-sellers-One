          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Milkshake Trending",
  "tag": "section",
  "class": "es-milkshake-trending-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Salon Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Back in Stock & Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection (Optional)"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Specific Products (Optional - takes priority if chosen)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fcf9f4"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Product Card Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Milkshake Trending"
    }
  ]
}
{% endschema %}
