          </div>
        </div>

        <!-- Product 3 -->
        <div class="group relative flex flex-col rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all">
          <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container mb-space-md">
            <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-pastel-silver-shine text-primary font-label-sm text-label-sm uppercase tracking-wider">
              Best Seller
            </span>
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="silver shine whipped cream 200 ml" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDV24lCvNmghyzuNuOftYfztpDTTi90aHP5yb0VmF-D7tBewZ3z6ZnLX7Zts-QYLfPxrxRmOBjbcUENx5d8kSibonJ4YEKrTPIik5PD51XLBs3FlOyTyNl7SZSSixaUP8cJtRoBuA6CXgnp8oCKXBWlBZrqYnn-wsArcv08EO3qDrx1T2zMRED7peZ-1Sj0cai04rrFG_0jpYzFww54tPdi0lXVYpE1r3NFRjPPReRiSKTqYZWIlps" loading="lazy" />
            <button type="button" class="absolute bottom-3 left-3 right-3 h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-space-xs shadow-md">
              <span class="material-symbols-outlined text-[18px]">add</span>
              Quick Add
            </button>
          </div>
          <div class="flex items-center gap-1 text-[#D4AF37] mb-1">
            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="font-body-sm text-body-sm text-text-muted">5.0 (310 reviews)</span>
          </div>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">milk_shake®</span>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs line-clamp-2">
