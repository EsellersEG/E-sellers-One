{% schema %}
{
  "name": "Milkshake Trending",
  "tag": "section",
  "class": "es-milkshake-trending-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Salon Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Back in Stock & Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection (Optional)"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Specific Products (Optional - takes priority if chosen)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout & Carousel Mode"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Mode",
      "options": [
        {
          "value": "grid",
          "label": "Standard Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel / Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 3,
      "step": 1,
      "label": "Tablet columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid / Carousel gap",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true,
      "info": "Active when Carousel mode is selected"
    },
    {
      "type": "header",
      "content": "Product Card Styling"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Classic (3:4)"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Product Card Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show sale / promo badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add button",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fcf9f4"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors and Background"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Border and Radius"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
