{% render 'es-section-style', section: section %}

{%- assign is_carousel = false -%}
{%- if section.settings.layout_type == 'carousel' -%}
  {%- assign is_carousel = true -%}
{%- endif -%}

{%- assign img_ratio_class = 'es-aspect-4-5' -%}
{%- if section.settings.image_ratio == '1/1' -%}
  {%- assign img_ratio_class = 'es-aspect-1-1' -%}
{%- elsif section.settings.image_ratio == '3/4' -%}
  {%- assign img_ratio_class = 'es-aspect-3-4' -%}
{%- endif -%}

{%- style -%}
  #bestsellers-{{ section.id }} {
    --cols-desktop: {{ section.settings.columns_desktop | default: 4 }};
    --cols-tablet: {{ section.settings.columns_tablet | default: 2 }};
    --cols-mobile: {{ section.settings.columns_mobile | default: 1 }};
    --grid-gap: {{ section.settings.grid_gap | default: 24 }}px;
  }
  .trending-card-{{ section.id }} {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 12 }}px;
    padding: {{ section.settings.card_padding | default: 16 }}px;
  }
{%- endstyle -%}

<section id="bestsellers-{{ section.id }}" class="w-full py-space-3xl bg-surface-cream section-{{ section.id }}-settings" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-space-2xl">
      <div>
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-space-xs block">
          {{ section.settings.subheading | default: 'Salon Favorites' }}
        </span>
        <h2 class="font-headline-xl text-headline-xl text-primary">
          {{ section.settings.heading | default: 'Back in Stock & Trending Now' }}
        </h2>
      </div>
      {%- if is_carousel and section.settings.show_arrows -%}
        <div class="flex items-center gap-space-sm mt-space-sm sm:mt-0">
          <button type="button" data-carousel-prev="TrendingTrack-{{ section.id }}" aria-label="Previous" class="w-11 h-11 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">chevron_left</span>
          </button>
          <button type="button" data-carousel-next="TrendingTrack-{{ section.id }}" aria-label="Next" class="w-11 h-11 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">chevron_right</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div id="TrendingTrack-{{ section.id }}" class="{% if is_carousel %}es-carousel-track{% else %}es-collection-grid{% endif %}">
      {%- assign display_products = nil -%}
      {%- if section.settings.product_list != blank and section.settings.product_list.count > 0 -%}
        {%- assign display_products = section.settings.product_list -%}
      {%- elsif section.settings.collection != blank and collections[section.settings.collection].products_count > 0 -%}
        {%- assign display_products = collections[section.settings.collection].products -%}
      {%- endif -%}

      {%- assign max_products = section.settings.products_to_show | default: 4 -%}

      {%- if display_products != nil -%}
        {%- for product in display_products limit: max_products -%}
          <div class="group relative flex flex-col trending-card-{{ section.id }} shadow-sm hover:shadow-md transition-all">
            <div class="relative w-full {{ img_ratio_class }} rounded-lg overflow-hidden bg-surface-container mb-space-md">
              {%- if section.settings.show_badge and product.compare_at_price > product.price -%}
                <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-badge-sale text-on-error font-label-sm text-label-sm uppercase tracking-wider">
                  On Sale
                </span>
              {%- endif -%}
              <a href="{{ product.url }}" class="block w-full h-full">
                {%- if product.featured_image != blank -%}
                  <img
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    alt="{{ product.title | escape }}"
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    loading="lazy"
                  />
                {%- endif -%}
              </a>
              {%- if section.settings.show_quick_add -%}
                <form method="post" action="{{ routes.cart_add_url }}" class="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="w-full h-11 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase flex items-center justify-center gap-space-xs shadow-md hover:bg-neutral-800 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    Quick Add
                  </button>
                </form>
              {%- endif -%}
            </div>
            {%- if section.settings.show_rating -%}
              <div class="flex items-center gap-1 text-[#D4AF37] mb-1">
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="font-body-sm text-body-sm text-text-muted">4.9 (salon verified)</span>
              </div>
            {%- endif -%}
            {%- if section.settings.show_vendor -%}
              <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">
                {{ product.vendor | default: 'milk_shake®' }}
              </span>
            {%- endif -%}
            <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs line-clamp-2">
              <a href="{{ product.url }}" class="hover:text-neutral-700 transition-colors">{{ product.title }}</a>
            </h3>
            <div class="mt-auto flex items-baseline gap-space-sm">
              <span class="font-price-sale text-price-sale text-primary">
                {{ product.price | money }}
              </span>
              {%- if product.compare_at_price > product.price -%}
                <span class="font-price-regular text-price-regular line-through text-text-muted">
                  {{ product.compare_at_price | money }}
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback to exact 4 Stitch Products -->
        <!-- Product 1 -->
        <div class="group relative flex flex-col trending-card-{{ section.id }} shadow-sm hover:shadow-md transition-all">
          <div class="relative w-full {{ img_ratio_class }} rounded-lg overflow-hidden bg-surface-container mb-space-md">
            {%- if section.settings.show_badge -%}
              <span class="absolute top-3 left-3 z-10 px-space-sm py-0.5 rounded-full bg-badge-sale text-on-error font-label-sm text-label-sm uppercase tracking-wider">
