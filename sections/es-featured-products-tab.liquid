{%- comment -%}
  ES Products Tab - E-sellers One (v5.0.0)

  Tabbed product showcase: each block is one tab holding its own curated
  product list (2+ products). Tab switching reuses the theme's shared
  `window.switchEsTab(sectionId, index)` helper (see es-tabs.liquid) so only
  one copy of the logic ships regardless of how many tab sections are used.
{%- endcomment -%}

{%- liquid
  assign es_fpt_tabs = section.blocks
  assign es_fpt_cols = section.settings.columns | default: 2
-%}

{%- if es_fpt_tabs.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --es-fpt-cols: {{ es_fpt_cols }};
      padding-top: {{ section.settings.padding_top | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    }

    #shopify-section-{{ section.id }} .es-fpt__nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--es-space-2) var(--es-space-4);
      border-bottom: var(--es-rule-width) solid var(--es-rule);
      padding-bottom: var(--es-space-3);
      margin-bottom: var(--es-space-6);
      overflow-x: auto;
    }

    #shopify-section-{{ section.id }} .es-fpt__tab {
      background: none;
      border: none;
      padding: var(--es-space-2) 0;
      font-size: var(--es-text-md);
      font-weight: 650;
      color: var(--es-fg-muted);
      cursor: pointer;
      white-space: nowrap;
      position: relative;
      border-radius: 0;
    }
    #shopify-section-{{ section.id }} .es-fpt__tab:hover { opacity: 1; color: var(--es-fg); box-shadow: none; }
    #shopify-section-{{ section.id }} .es-fpt__tab.is-active { color: var(--es-fg); }
    #shopify-section-{{ section.id }} .es-fpt__tab.is-active::after {
      content: "";
      position: absolute;
      left: 0; right: 0; bottom: -13px;
      height: 2px;
      background: var(--es-fg);
    }

    #shopify-section-{{ section.id }} .es-fpt__panel { display: none; }
    #shopify-section-{{ section.id }} .es-fpt__panel.is-active { display: block; }

    #shopify-section-{{ section.id }} .es-fpt__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--es-grid-gap);
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-fpt__grid { grid-template-columns: repeat(var(--es-fpt-cols), minmax(0, 1fr)); }
    }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.heading_alignment,
        button_label: section.settings.button_label,
        button_url: section.settings.button_link -%}

    <div id="EsFpt-{{ section.id }}">
      <div class="es-fpt__nav" role="tablist">
        {%- for block in es_fpt_tabs -%}
          <button
            type="button"
            class="es-fpt__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            onclick="esFptSwitch{{ section.id | replace: '-', '' }}({{ forloop.index0 }})"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title | default: 'Tab ' | append: forloop.index | escape }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in es_fpt_tabs -%}
        <div class="es-fpt__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel">
          <div class="es-fpt__grid">
            {%- for product in block.settings.products limit: 8 -%}
              {%- render 'card-product', card_product: product -%}
            {%- else -%}
              {%- for i in (1..es_fpt_cols) -%}
                {%- render 'card-product', card_product: blank -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      window['esFptSwitch{{ section.id | replace: "-", "" }}'] = function (index) {
        var root = document.getElementById('EsFpt-{{ section.id }}');
        if (!root) return;
        var tabs = root.querySelectorAll('.es-fpt__tab');
        var panels = root.querySelectorAll('.es-fpt__panel');
        tabs.forEach(function (t, i) {
          var active = i === index;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(function (p, i) { p.classList.toggle('is-active', i === index); });
      };
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add tab blocks with products to populate this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "ES Products Tab",
  "tag": "section",
  "class": "shopify-section--es-featured-products-tab",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "button_label", "label": "Link text" },
    { "type": "url", "id": "button_link", "label": "Link URL" },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab label", "default": "Tab" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 8 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "ES Products Tab",
      "blocks": [{ "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
