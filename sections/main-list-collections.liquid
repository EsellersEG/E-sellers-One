{%- comment -%}
  Main List Collections Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
  }

  .es-collections-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .es-collections-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    margin: 0 0 10px 0;
    color: #0f172a;
    {% if section.settings.heading_gradient != blank %}
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    {% endif %}
  }

  .es-collections-subtext {
    font-size: 1rem;
    color: #64748b;
    margin: 0;
  }

  /* Grid Layout */
  .es-collections-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.collections_per_row | default: 3 }}, minmax(0, 1fr));
    gap: 28px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .es-collections-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (max-width: 640px) {
    .es-collections-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* Card */
  .es-collection-card {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: {{ section.settings.text_color | default: '#ffffff' }};
    background-color: #0f172a;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .es-collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px -4px rgba(0, 0, 0, 0.16);
  }

  .es-collection-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .es-collection-card:hover .es-collection-card__img {
    transform: scale(1.06);
  }

  .es-collection-card__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};
    pointer-events: none;
  }

  .es-collection-card__content {
    position: relative;
    z-index: 2;
    padding: 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .es-collection-card__name {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 700;
    margin: 0;
    color: inherit;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .es-collection-card__count {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: inline-block;
  }

  .es-collection-card__arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .es-collection-card:hover .es-collection-card__arrow {
    transform: scale(1.1);
    background: #ffffff;
  }
{%- endstyle -%}

<div class="page-width">
  {%- assign selected_collections = section.settings.collections -%}
  {%- if selected_collections != blank and selected_collections.count > 0 -%}
    {%- assign collection_list = selected_collections -%}
  {%- else -%}
    {%- assign collection_list = collections -%}
  {%- endif -%}

  {%- if collection_list.size == 0 -%}
    <div style="text-align: center; padding: 80px 20px; background: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0; max-width: 500px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0 0 8px 0;">
        {{ 'collection.general.no_collections' | t | default: 'No collections found' }}
      </h2>
      <p style="color: #64748b; margin: 0 0 20px 0;">Explore our full catalog to discover featured items.</p>
      <a href="{{ routes.root_url }}" style="display: inline-block; padding: 12px 28px; background: #0f172a; color: #ffffff; border-radius: 8px; font-weight: 700; text-decoration: none;">
        {{ 'collection.general.continue_shopping' | t | default: 'Start Shopping' }}
      </a>
    </div>
  {%- else -%}
    <div class="es-collections-header">
      <h1 class="es-collections-title">{{ 'collection.general.all_collections' | t | default: 'All Collections' }}</h1>
      <p class="es-collections-subtext">Browse our curated selection of categories and premium products</p>
    </div>

    {%- paginate collections by 48 -%}
      <ul class="es-collections-grid">
        {%- for collection in collection_list -%}
          <li>
            <a href="{{ collection.url }}" class="es-collection-card">
              {%- assign featured_media = collection.featured_image | default: collection.products.first.featured_media -%}
              {%- if featured_media != blank -%}
                {%- assign es_tagarg_1 = collection.title | escape -%}{{ featured_media | image_url: width: 1000 | image_tag:
                  loading: 'lazy',
                  class: 'es-collection-card__img',
                  alt: es_tagarg_1}}
              {%- else -%}
                <div style="position: absolute; inset: 0; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);"></div>
              {%- endif -%}

              <div class="es-collection-card__overlay"></div>

              <div class="es-collection-card__content">
                <h2 class="es-collection-card__name">{{ collection.title | escape }}</h2>
                <span class="es-collection-card__count">{{ collection.all_products_count }} products</span>
                <span class="es-collection-card__arrow">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if selected_collections == blank and paginate.pages > 1 -%}
        <div style="margin-top: 48px; display: flex; justify-content: center;">
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "List collections",
  "tag": "section",
  "class": "shopify-section--main-list-collections",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Custom collection selection",
      "info": "Leave empty to display all collections automatically."
    },
    {
      "type": "range",
      "id": "collections_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Collections per row (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Colors & Overlay"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Card image overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ]
}
{% endschema %}
