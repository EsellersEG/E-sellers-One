{% schema %}
{
  "name": "ES Bundles & Routines",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Maximized Efficacy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save Full Routines"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View All Bundles"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Layout & Carousel Mode"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Mode",
      "options": [
        {
          "value": "grid",
          "label": "Standard Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel / Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid / Carousel gap",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true,
      "info": "Active when Carousel mode is selected"
    },
    {
      "type": "header",
      "content": "Bundle Card Styling"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "16/10",
          "label": "Landscape (16:10)"
        },
        {
          "value": "4/3",
          "label": "Classic (4:3)"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "16/10"
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Enable image hover zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card inner padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
