                Save 54%
              </span>
            {% endif %}
            <img class="w-full h-full object-cover {% if section.settings.hover_zoom %}group-hover:scale-105 transition-transform duration-500{% endif %}" alt="Curated milk_shake super moisture bundle" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAMSItpxjuqzFjHaQ6MCgeIy_gm1NOqd70wc96T8BLa3ehS0Yk_H0ECplR8F6OZsbRUSVKlY0wPDstCVvT9SuHYAAMXnAjelr8A8RaFg_PmGvxzB8U3p-disLLllFHUmJuAo_whuVlV9KIgNrm4Ijt-dWtzlSRnd-y9vYr4MMQsZpbXlGYHasDP0ydnd-llzcpWMrf_gXBSCZ6lv6H79laW0IXY8jh6A140JTJuJcY1rBB6lPQdjI" loading="lazy"/>
