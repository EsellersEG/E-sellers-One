{% render 'es-section-style', section: section %}

{%- assign is_carousel = false -%}
{%- if section.settings.layout_type == 'carousel' -%}
  {%- assign is_carousel = true -%}
{%- endif -%}

{%- assign img_ratio_class = 'es-aspect-16-10' -%}
{%- if section.settings.image_ratio == '4/3' -%}
  {%- assign img_ratio_class = 'es-aspect-4-3' -%}
{%- elsif section.settings.image_ratio == '1/1' -%}
  {%- assign img_ratio_class = 'es-aspect-1-1' -%}
{%- elsif section.settings.image_ratio == '4/5' -%}
  {%- assign img_ratio_class = 'es-aspect-4-5' -%}
{%- endif -%}

{%- style -%}
  #es-milkshake-bundles-{{ section.id }} {
    --cols-desktop: {{ section.settings.columns_desktop | default: 3 }};
    --cols-tablet: {{ section.settings.columns_tablet | default: 2 }};
    --cols-mobile: {{ section.settings.columns_mobile | default: 1 }};
    --grid-gap: {{ section.settings.grid_gap | default: 24 }}px;
  }
  .bundle-card-{{ section.id }} {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 16 }}px;
    padding: {{ section.settings.card_padding | default: 24 }}px;
  }
{%- endstyle -%}

<section class="w-full py-space-3xl bg-surface-cream section-{{ section.id }}-settings" id="es-milkshake-bundles-{{ section.id }}">
  <div class="max-w-[1440px] mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl">
      <div>
        {% if section.settings.subtitle != blank %}
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-space-xs block">
            {{ section.settings.subtitle }}
          </span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="font-headline-xl text-headline-xl text-primary">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
      <div class="flex items-center gap-space-md mt-space-sm md:mt-0">
        {% if section.settings.view_all_text != blank %}
          <a class="font-label-lg text-label-lg uppercase tracking-wider text-primary hover:text-secondary flex items-center gap-1 transition-colors" href="{{ section.settings.view_all_link | default: '/collections/all' }}">
            {{ section.settings.view_all_text }}
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        {% endif %}
        {%- if is_carousel and section.settings.show_arrows -%}
          <div class="flex items-center gap-space-xs ml-space-sm">
            <button type="button" data-carousel-prev="BundlesTrack-{{ section.id }}" aria-label="Previous" class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm cursor-pointer border border-neutral-200">
              <span class="material-symbols-outlined text-[20px]">chevron_left</span>
            </button>
            <button type="button" data-carousel-next="BundlesTrack-{{ section.id }}" aria-label="Next" class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors shadow-sm cursor-pointer border border-neutral-200">
              <span class="material-symbols-outlined text-[20px]">chevron_right</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div id="BundlesTrack-{{ section.id }}" class="{% if is_carousel %}es-carousel-track{% else %}es-collection-grid{% endif %}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="group flex flex-col bundle-card-{{ section.id }} shadow-sm hover:shadow-md transition-shadow" {{ block.shopify_attributes }}>
            <div class="relative w-full {{ img_ratio_class }} rounded-lg overflow-hidden {{ block.settings.bg_class | default: 'bg-surface-container' }} mb-space-md">
              {% if section.settings.show_badge and block.settings.badge_text != blank %}
                <span class="absolute top-3 left-3 px-space-sm py-1 rounded-full {{ block.settings.badge_class | default: 'bg-badge-sale text-on-error' }} font-label-sm text-label-sm uppercase tracking-wider font-bold z-10">
                  {{ block.settings.badge_text }}
                </span>
              {% endif %}
              {% if block.settings.image != blank %}
                <img class="w-full h-full object-cover {% if section.settings.hover_zoom %}group-hover:scale-105 transition-transform duration-500{% endif %}" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | default: block.settings.title }}" loading="lazy">
              {% elsif block.settings.image_url != blank %}
                <img class="w-full h-full object-cover {% if section.settings.hover_zoom %}group-hover:scale-105 transition-transform duration-500{% endif %}" src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                <div class="w-full h-full flex items-center justify-center text-text-muted">No Image</div>
              {% endif %}
            </div>
            {% if block.settings.category != blank %}
              <span class="font-label-sm text-label-sm uppercase tracking-wider text-text-muted mb-1">
                {{ block.settings.category }}
              </span>
            {% endif %}
            <h3 class="font-headline-md text-headline-md text-primary mb-space-xs">
              {{ block.settings.title }}
            </h3>
            {% if block.settings.description != blank %}
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md">
                {{ block.settings.description }}
              </p>
            {% endif %}
            <div class="mt-auto pt-space-md flex items-center justify-between">
              <div>
                <span class="font-headline-sm text-headline-sm text-primary">
                  {{ block.settings.price }}
                </span>
                {% if block.settings.compare_price != blank %}
                  <span class="font-body-sm text-body-sm line-through text-text-muted ml-2">
                    {{ block.settings.compare_price }}
                  </span>
                {% endif %}
              </div>
              {% if block.settings.product != blank %}
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}" />
                  <button type="submit" class="h-11 px-space-lg rounded-full bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider hover:bg-neutral-800 transition-colors cursor-pointer">
                    {{ block.settings.button_text | default: 'Add Routine' }}
                  </button>
                </form>
              {% else %}
                <a href="{{ block.settings.link | default: '/collections/all' }}" class="h-11 px-space-lg rounded-full bg-primary text-on-primary font-label-md text-label-md uppercase tracking-wider hover:bg-neutral-800 transition-colors inline-flex items-center justify-center">
                  {{ block.settings.button_text | default: 'Add Routine' }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Bundle 1: Super Moisture (Save 54%) Fallback -->
