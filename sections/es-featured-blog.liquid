{%- comment -%}
  E-sellers Featured Blog - E-sellers One (v5.0.0)

  Grid of recent posts from a chosen blog, built on the theme's existing
  blog-post-card snippet so blog cards look identical everywhere they appear
  (this section, the blog template, related-articles, etc.).
{%- endcomment -%}

{%- liquid
  assign es_fb_blog = section.settings.blog
  assign es_fb_limit = section.settings.post_limit | default: 3
-%}

{%- if es_fb_blog != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --es-fb-cols-d: {{ section.settings.columns_desktop | default: 3 }};
      --es-fb-cols-m: {{ section.settings.columns_mobile | default: 1 }};
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #shopify-section-{{ section.id }} .es-fb__grid {
      display: grid;
      grid-template-columns: repeat(var(--es-fb-cols-m), minmax(0, 1fr));
      gap: {{ section.settings.column_gap | default: 24 }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-fb__grid { grid-template-columns: repeat(var(--es-fb-cols-d), minmax(0, 1fr)); }
    }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.heading_alignment,
        button_label: section.settings.button_label,
        button_url: section.settings.button_link -%}

    <div class="es-fb__grid">
      {%- for article in es_fb_blog.articles limit: es_fb_limit -%}
        {%- render 'blog-post-card',
            article: article,
            show_category: section.settings.show_tags,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: section.settings.show_excerpt,
            show_read_more: section.settings.show_button -%}
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Choose a blog to populate this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Featured Blog",
  "tag": "section",
  "class": "shopify-section--es-featured-blog",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "label": "Posts to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [{ "value": "start", "label": "Left" }, { "value": "center", "label": "Center" }],
      "default": "start"
    },
    { "type": "text", "id": "button_label", "label": "Link text", "default": "View all posts" },
    { "type": "url", "id": "button_link", "label": "Link URL" },
    { "type": "checkbox", "id": "show_tags", "label": "Show category/tags", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_button", "label": "Show read more link", "default": true },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "column_gap", "label": "Gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    { "name": "E-sellers Featured Blog" }
  ]
}
{% endschema %}
