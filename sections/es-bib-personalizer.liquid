{%- comment -%}
  E-sellers Baby Bib Personalizer - E-sellers Professional (v4.9.0)
  Developer: E-sellers (info@e-sellers.net)
{%- endcomment -%}

{%- assign product = section.settings.product -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Dancing+Script:wght@600&family=Great+Vibes&family=Playfair+Display:ital,wght@0,600;1,600&family=Quicksand:wght@600&display=swap');

  #shopify-section-{{ section.id }} {
    --es-bib-bg: {{ section.settings.section_background | default: '#fafafa' }};
    --es-bib-card-bg: {{ section.settings.card_background | default: '#ffffff' }};
    --es-bib-text: {{ section.settings.text_color | default: '#1e293b' }};
    --es-bib-heading: {{ section.settings.heading_color | default: '#0f172a' }};
    --es-bib-border: {{ section.settings.border_color | default: '#e2e8f0' }};
    --es-bib-primary: {{ section.settings.button_background | default: '#0f172a' }};
    --es-bib-primary-hover: {{ section.settings.button_hover_background | default: '#334155' }};
    --es-bib-primary-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --es-bib-accent: {{ section.settings.accent_color | default: '#f43f5e' }};
    --es-bib-radius: {{ section.settings.card_radius | default: 20 }}px;
    
    background-color: var(--es-bib-bg);
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    color: var(--es-bib-text);
  }

  .es-bib-section {
    width: 100%;
    box-sizing: border-box;
  }

  .es-bib-container {
    max-width: {{ section.settings.max_width | default: 1320 }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Header */
  .es-bib-header {
    text-align: {{ section.settings.header_alignment | default: 'center' }};
    margin-bottom: 40px;
  }

  .es-bib-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: {{ section.settings.badge_background | default: '#fff1f2' }};
    color: {{ section.settings.badge_text_color | default: '#e11d48' }};
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .es-bib-badge svg {
    width: 14px;
    height: 14px;
  }

  .es-bib-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--es-bib-heading);
    line-height: 1.2;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
    {% if section.settings.heading_gradient != blank %}
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    {% endif %}
  }

  .es-bib-subtitle {
    font-size: clamp(0.95rem, 1.5vw, 1.125rem);
    color: #64748b;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Main Grid */
  .es-bib-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .es-bib-grid {
      grid-template-columns: {% if section.settings.preview_position == 'left' %}1.1fr 1.3fr{% else %}1.3fr 1.1fr{% endif %};
      gap: 48px;
    }
  }

  /* Control Panels */
  .es-bib-controls {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .es-bib-card {
    background: var(--es-bib-card-bg);
    border-radius: var(--es-bib-radius);
    padding: 24px;
    border: 1px solid var(--es-bib-border);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .es-bib-step-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--es-bib-heading);
    margin: 0 0 16px 0;
  }

  .es-bib-step-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--es-bib-primary);
    color: var(--es-bib-primary-text);
    font-size: 0.75rem;
    font-weight: 800;
    margin-right: 8px;
  }

  .es-bib-step-label {
    display: flex;
    align-items: center;
  }

  .es-bib-selected-indicator {
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748b;
  }

  /* Style Selector (Bibs / Variants) */
  .es-bib-style-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 12px;
  }

  .es-bib-style-item {
    position: relative;
    border: 2px solid var(--es-bib-border);
    border-radius: 14px;
    padding: 10px;
    cursor: pointer;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .es-bib-style-item:hover {
    border-color: #cbd5e1;
    transform: translateY(-2px);
  }

  .es-bib-style-item.is-selected {
    border-color: var(--es-bib-primary);
    background: #f8fafc;
    box-shadow: 0 0 0 2px var(--es-bib-primary);
  }

  .es-bib-style-preview-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    margin-bottom: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0,0,0,0.08);
    position: relative;
  }

  .es-bib-style-preview-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .es-bib-style-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--es-bib-heading);
    margin: 0 0 2px 0;
    line-height: 1.2;
  }

  .es-bib-style-price {
    font-size: 0.8125rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Input Section */
  .es-bib-input-wrapper {
    position: relative;
  }

  .es-bib-text-input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid var(--es-bib-border);
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--es-bib-heading);
    background: #ffffff;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .es-bib-text-input:focus {
    outline: none;
    border-color: var(--es-bib-primary);
    box-shadow: 0 0 0 4px rgba(15, 23, 42, 0.08);
  }

  .es-bib-input-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    font-size: 0.8125rem;
    color: #64748b;
  }

  .es-bib-char-count {
    font-weight: 600;
  }

  .es-bib-error-msg {
    color: #e11d48;
    font-weight: 600;
    font-size: 0.85rem;
    margin-top: 6px;
    display: none;
  }

  .es-bib-error-msg.is-visible {
    display: block;
    animation: es-shake 0.4s ease;
  }

  @keyframes es-shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
    40%, 80% { transform: translateX(6px); }
  }

  /* Font Picker */
  .es-bib-font-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
  }

  .es-bib-font-btn {
    border: 2px solid var(--es-bib-border);
    border-radius: 12px;
    padding: 12px 10px;
    background: #ffffff;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
  }

  .es-bib-font-btn:hover {
    border-color: #cbd5e1;
  }

  .es-bib-font-btn.is-selected {
    border-color: var(--es-bib-primary);
    background: #f8fafc;
    box-shadow: 0 0 0 2px var(--es-bib-primary);
  }

  .es-bib-font-preview {
    font-size: 1.35rem;
    display: block;
    margin-bottom: 4px;
    line-height: 1.1;
  }

  .es-bib-font-name {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Thread Color Swatches */
  .es-bib-thread-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .es-bib-thread-swatch {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 2px var(--es-bib-border);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .es-bib-thread-swatch:hover {
    transform: scale(1.12);
  }

  .es-bib-thread-swatch.is-selected {
    box-shadow: 0 0 0 3px var(--es-bib-primary);
    transform: scale(1.1);
  }

  .es-bib-thread-swatch svg {
    width: 16px;
    height: 16px;
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .es-bib-thread-swatch.is-selected svg {
    opacity: 1;
  }

  .es-bib-thread-swatch.is-light svg {
    color: #0f172a;
  }

  /* Preview Pane */
  .es-bib-preview-pane {
    position: sticky;
    top: 32px;
  }

  .es-bib-preview-card {
    background: var(--es-bib-card-bg);
    border-radius: var(--es-bib-radius);
    padding: 30px;
    border: 1px solid var(--es-bib-border);
    box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.05);
    text-align: center;
  }

  .es-bib-preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .es-bib-preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #059669;
    background: #ecfdf5;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .es-bib-preview-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: es-pulse 2s infinite;
  }

  @keyframes es-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  /* Stage and Canvas */
  .es-bib-stage {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto 24px auto;
    aspect-ratio: 1 / 1;
    background: #f8fafc;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.03);
  }

  .es-bib-stage__canvas {
    position: relative;
    width: 85%;
    height: 85%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .es-bib-stage__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .es-bib-svg-bib {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 12px 24px rgba(0,0,0,0.08));
    z-index: 1;
    transition: all 0.3s ease;
  }

  /* Real Embroidery Text Layer */
  .es-bib-embroidery-layer {
    position: absolute;
    top: 55%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    width: 70%;
    text-align: center;
    pointer-events: none;
    line-height: 1.1;
  }

  .es-bib-embroidery-text {
    display: inline-block;
    max-width: 100%;
    word-break: break-word;
    font-size: clamp(1.5rem, 4.5vw, 2.5rem);
    font-weight: 600;
    transition: color 0.25s ease, font-family 0.25s ease;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.22), -0.5px -0.5px 0.5px rgba(255, 255, 255, 0.4);
    letter-spacing: 0.02em;
    user-select: none;
  }

  /* Preview Details Summary */
  .es-bib-summary-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #f8fafc;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 0.9rem;
    border: 1px solid #e2e8f0;
  }

  .es-bib-summary-col {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .es-bib-summary-title {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 700;
  }

  .es-bib-summary-val {
    font-weight: 700;
    color: var(--es-bib-heading);
  }

  .es-bib-price-display {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--es-bib-heading);
    text-align: right;
  }

  /* Quantity & CTA Area */
  .es-bib-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .es-bib-qty {
    display: flex;
    align-items: center;
    border: 2px solid var(--es-bib-border);
    border-radius: 12px;
    background: #ffffff;
    overflow: hidden;
  }

  .es-bib-qty-btn {
    width: 44px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--es-bib-heading);
    transition: background 0.15s ease;
  }

  .es-bib-qty-btn:hover {
    background: #f1f5f9;
  }

  .es-bib-qty-input {
    width: 44px;
    height: 52px;
    border: none;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--es-bib-heading);
    background: transparent;
    -moz-appearance: textfield;
  }

  .es-bib-qty-input::-webkit-outer-spin-button,
  .es-bib-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .es-bib-add-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--es-bib-primary);
    color: var(--es-bib-primary-text);
    border: none;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    padding: 14px 24px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.15);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .es-bib-add-btn:hover {
    background: var(--es-bib-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
  }

  .es-bib-add-btn:active {
    transform: translateY(0);
  }

  .es-bib-add-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .es-bib-add-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Guarantees / Highlights */
  .es-bib-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--es-bib-border);
  }

  .es-bib-feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #64748b;
    text-align: left;
  }

  .es-bib-feature-item svg {
    width: 16px;
    height: 16px;
    color: #10b981;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .es-bib-features {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="es-bib-section" data-section-id="{{ section.id }}">
  <div class="es-bib-container">
    
    <!-- Section Header -->
    <div class="es-bib-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="es-bib-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="es-bib-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="es-bib-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Main Builder Grid -->
    <div class="es-bib-grid">
      
      <!-- Customizer Controls -->
      <div class="es-bib-controls">
        
        <!-- Step 1: Select Bib Style -->
        <div class="es-bib-card">
          <div class="es-bib-step-title">
            <div class="es-bib-step-label">
              <span class="es-bib-step-pill">1</span>
              <span>{{ section.settings.step_1_title | default: 'Choose Bib Style' }}</span>
            </div>
            <span class="es-bib-selected-indicator" id="BibSelectedStyleName">Oatmeal Linen</span>
          </div>

          <div class="es-bib-style-list" role="radiogroup" aria-label="Bib Styles">
            {%- if product != blank and product.variants.size > 0 -%}
              {%- for variant in product.variants -%}
                <button type="button" 
                  class="es-bib-style-item {% if forloop.first %}is-selected{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-title="{{ variant.title | escape }}"
                  data-variant-price="{{ variant.price | money }}"
                  data-variant-price-raw="{{ variant.price }}"
                  data-available="{{ variant.available }}"
                  data-image="{% if variant.image %}{{ variant.image | image_url: width: 600 }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"
                  data-color-fallback="#F7F3EE">
                  <div class="es-bib-style-preview-circle">
                    {%- if variant.image -%}
                      <img src="{{ variant.image | image_url: width: 120 }}" alt="{{ variant.title | escape }}" loading="lazy" width="120" height="120">
                    {%- elsif product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ variant.title | escape }}" loading="lazy" width="120" height="120">
                    {%- else -%}
                      <div style="background: #e2e8f0; width: 100%; height: 100%;"></div>
                    {%- endif -%}
                  </div>
                  <span class="es-bib-style-title">{{ variant.title }}</span>
                  <span class="es-bib-style-price">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback High Quality Bib Presets -->
              <button type="button" class="es-bib-style-item is-selected"
                data-variant-id="demo-1"
                data-variant-title="Oatmeal Cream"
                data-variant-price="{{ 2400 | money }}"
                data-variant-price-raw="2400"
                data-available="true"
                data-color-fallback="#F6F1EA"
                data-accent-fallback="#EADFCF">
                <div class="es-bib-style-preview-circle" style="background: #F6F1EA;"></div>
                <span class="es-bib-style-title">Oatmeal Cream</span>
                <span class="es-bib-style-price">{{ 2400 | money }}</span>
              </button>

              <button type="button" class="es-bib-style-item"
                data-variant-id="demo-2"
                data-variant-title="Dusty Rose"
                data-variant-price="{{ 2400 | money }}"
                data-variant-price-raw="2400"
                data-available="true"
                data-color-fallback="#F4E3E1"
                data-accent-fallback="#E8CECC">
                <div class="es-bib-style-preview-circle" style="background: #F4E3E1;"></div>
                <span class="es-bib-style-title">Dusty Rose</span>
                <span class="es-bib-style-price">{{ 2400 | money }}</span>
              </button>

              <button type="button" class="es-bib-style-item"
                data-variant-id="demo-3"
                data-variant-title="Sage Mist"
                data-variant-price="{{ 2400 | money }}"
                data-variant-price-raw="2400"
                data-available="true"
                data-color-fallback="#E2EBE2"
                data-accent-fallback="#CEE0CF">
                <div class="es-bib-style-preview-circle" style="background: #E2EBE2;"></div>
                <span class="es-bib-style-title">Sage Mist</span>
                <span class="es-bib-style-price">{{ 2400 | money }}</span>
              </button>

              <button type="button" class="es-bib-style-item"
                data-variant-id="demo-4"
                data-variant-title="Cloud Blue"
                data-variant-price="{{ 2400 | money }}"
                data-variant-price-raw="2400"
                data-available="true"
                data-color-fallback="#E1ECF4"
                data-accent-fallback="#C9DEEE">
                <div class="es-bib-style-preview-circle" style="background: #E1ECF4;"></div>
                <span class="es-bib-style-title">Cloud Blue</span>
                <span class="es-bib-style-price">{{ 2400 | money }}</span>
              </button>
            {%- endif -%}
          </div>
        </div>

        <!-- Step 2: Personalization Name / Text -->
        <div class="es-bib-card">
          <div class="es-bib-step-title">
            <div class="es-bib-step-label">
              <span class="es-bib-step-pill">2</span>
              <span>{{ section.settings.step_2_title | default: "Enter Baby's Name or Monogram" }}</span>
