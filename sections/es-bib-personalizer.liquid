                  fill="none" 
                  stroke="#DFD3C2" 
                  stroke-width="1.8" 
                  stroke-dasharray="4 3" />

                <!-- Top Neck Opening Depth -->
                <path d="M 160 100 C 160 125 180 145 200 145 C 220 145 240 125 240 100 Z" fill="url(#bib-collar-grad)" />

                <!-- Neck Snap Buttons -->
                <circle cx="120" cy="50" r="7" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
                <circle cx="120" cy="50" r="3" fill="#cbd5e1" />
                <circle cx="280" cy="50" r="7" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
                <circle cx="280" cy="50" r="3" fill="#cbd5e1" />
