              <svg id="BibSvgGraphic" class="es-bib-svg-bib" viewBox="0 0 400 440" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Drop shadow def -->
                <defs>
                  <filter id="bib-soft-shadow" x="-10%" y="-10%" width="120%" height="125%" filterUnits="userSpaceOnUse">
                    <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#0f172a" flood-opacity="0.10" />
                  </filter>
                  <linearGradient id="bib-collar-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#000000" stop-opacity="0.06"/>
                    <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
                  </linearGradient>
                </defs>

                <!-- Bib Body Outline with realistic curves -->
                <path id="BibSvgPath" d="M 120 40 C 90 40 60 70 50 120 C 35 190 30 250 40 310 C 50 370 100 410 200 410 C 300 410 350 370 360 310 C 370 250 365 190 350 120 C 340 70 310 40 280 40 C 255 40 240 70 240 100 C 240 125 220 145 200 145 C 180 145 160 125 160 100 C 160 70 145 40 120 40 Z" 
                  fill="#F6F1EA" 
                  stroke="#EADFCF" 
                  stroke-width="4" 
                  filter="url(#bib-soft-shadow)" />

                <!-- Inner Stitched Embroidery Seam Line -->
