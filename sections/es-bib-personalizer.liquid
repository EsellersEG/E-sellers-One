    {
      "type": "header",
      "content": "Headings & Texts"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow badge",
      "default": "Custom Embroidery Studio"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Design Your Personalized Baby Bib"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Choose a gentle organic fabric, customize with baby's name or initials, and watch your embroidered heirloom come to life in real-time."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Step Titles"
    },
    {
      "type": "text",
