</div>

<script>
  (function() {
    function initBibPersonalizer(sectionContainer) {
      if (!sectionContainer) return;

      const textInput = sectionContainer.querySelector('#BibCustomText');
      const embroideryDisplay = sectionContainer.querySelector('#BibEmbroideryDisplay');
      const charCountSpan = sectionContainer.querySelector('#BibCharCount');
      const errorMsg = sectionContainer.querySelector('#BibErrorMsg');

      const styleItems = sectionContainer.querySelectorAll('.es-bib-style-item');
      const styleNameDisplay = sectionContainer.querySelector('#BibSelectedStyleName');
      const summaryNameDisplay = sectionContainer.querySelector('#BibSummaryName');
      const summaryPriceDisplay = sectionContainer.querySelector('#BibSummaryPrice');

      const fontBtns = sectionContainer.querySelectorAll('.es-bib-font-btn');
      const fontNameDisplay = sectionContainer.querySelector('#BibSelectedFontName');

      const threadSwatches = sectionContainer.querySelectorAll('.es-bib-thread-swatch');
      const threadNameDisplay = sectionContainer.querySelector('#BibSelectedThreadName');

      const svgGraphic = sectionContainer.querySelector('#BibSvgGraphic');
      const svgPath = sectionContainer.querySelector('#BibSvgPath');
      const previewImg = sectionContainer.querySelector('#BibPreviewImage');

      const qtyInput = sectionContainer.querySelector('#BibQtyInput');
      const qtyMinus = sectionContainer.querySelector('#BibQtyMinus');
      const qtyPlus = sectionContainer.querySelector('#BibQtyPlus');
      const addToCartBtn = sectionContainer.querySelector('#BibAddToCartBtn');
      const addToCartBtnText = sectionContainer.querySelector('#BibAddToCartBtnText');

      let currentVariantId = null;
      let currentVariantTitle = 'Oatmeal Cream';
      let currentFontName = 'Dancing Script';
      let currentFontFamily = "'Dancing Script', cursive";
      let currentThreadName = 'Warm Gold';
      let currentThreadColor = '#D4AF37';

      // 1. Text Typing Live Update
      if (textInput && embroideryDisplay) {
        textInput.addEventListener('input', function() {
          const val = this.value.trim();
          if (val.length > 0) {
            embroideryDisplay.textContent = this.value;
            errorMsg?.classList.remove('is-visible');
          } else {
            embroideryDisplay.textContent = 'Oliver';
          }
          if (charCountSpan) {
            charCountSpan.textContent = this.value.length;
          }

          // Responsive Font-size adjustment for longer names
          if (this.value.length > 10) {
            embroideryDisplay.style.fontSize = 'clamp(1.2rem, 3vw, 1.8rem)';
          } else if (this.value.length > 7) {
            embroideryDisplay.style.fontSize = 'clamp(1.4rem, 3.8vw, 2.1rem)';
          } else {
            embroideryDisplay.style.fontSize = 'clamp(1.5rem, 4.5vw, 2.5rem)';
          }
        });
      }

      // 2. Style / Variant Selection
      styleItems.forEach(item => {
        if (item.classList.contains('is-selected')) {
          currentVariantId = item.getAttribute('data-variant-id');
          currentVariantTitle = item.getAttribute('data-variant-title');
        }

        item.addEventListener('click', function() {
          styleItems.forEach(i => i.classList.remove('is-selected'));
          this.classList.add('is-selected');

          currentVariantId = this.getAttribute('data-variant-id');
          currentVariantTitle = this.getAttribute('data-variant-title');
          const price = this.getAttribute('data-variant-price');
          const imgSrc = this.getAttribute('data-image');
          const colorFallback = this.getAttribute('data-color-fallback');
          const accentFallback = this.getAttribute('data-accent-fallback');

          if (styleNameDisplay) styleNameDisplay.textContent = currentVariantTitle;
          if (summaryNameDisplay) summaryNameDisplay.textContent = currentVariantTitle;
          if (summaryPriceDisplay && price) summaryPriceDisplay.textContent = price;

          // Update SVG Bib color or Variant Image
          if (imgSrc && imgSrc !== '') {
            if (previewImg) {
              previewImg.src = imgSrc;
              previewImg.style.display = 'block';
            }
            if (svgGraphic) svgGraphic.style.display = 'none';
          } else {
            if (previewImg) previewImg.style.display = 'none';
            if (svgGraphic) svgGraphic.style.display = 'block';
            if (svgPath && colorFallback) {
              svgPath.setAttribute('fill', colorFallback);
              if (accentFallback) svgPath.setAttribute('stroke', accentFallback);
            }
          }
        });
      });

      // 3. Font Selection
      fontBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          fontBtns.forEach(b => b.classList.remove('is-selected'));
          this.classList.add('is-selected');

          currentFontName = this.getAttribute('data-font-name');
          currentFontFamily = this.getAttribute('data-font-family');

          if (fontNameDisplay) fontNameDisplay.textContent = currentFontName;
          if (embroideryDisplay) embroideryDisplay.style.fontFamily = currentFontFamily;
        });
      });

      // 4. Thread Color Selection
      threadSwatches.forEach(swatch => {
        swatch.addEventListener('click', function() {
          threadSwatches.forEach(s => s.classList.remove('is-selected'));
          this.classList.add('is-selected');

          currentThreadName = this.getAttribute('data-color-name');
          currentThreadColor = this.getAttribute('data-color-hex');

          if (threadNameDisplay) threadNameDisplay.textContent = currentThreadName;
          if (embroideryDisplay) embroideryDisplay.style.color = currentThreadColor;
        });
      });

      // 5. Quantity Stepper
      if (qtyMinus && qtyInput) {
        qtyMinus.addEventListener('click', () => {
          let v = parseInt(qtyInput.value, 10) || 1;
          if (v > 1) qtyInput.value = v - 1;
        });
      }

      if (qtyPlus && qtyInput) {
        qtyPlus.addEventListener('click', () => {
          let v = parseInt(qtyInput.value, 10) || 1;
          if (v < 99) qtyInput.value = v + 1;
        });
      }

      // 6. Add to Cart with Properties & Cart Drawer Integration
      if (addToCartBtn) {
        addToCartBtn.addEventListener('click', async function() {
          const personalizedText = textInput ? textInput.value.trim() : '';

          if (!personalizedText || personalizedText === '') {
            if (errorMsg) errorMsg.classList.add('is-visible');
            textInput?.focus();
            return;
          }

          const qty = parseInt(qtyInput?.value, 10) || 1;
          const origText = addToCartBtnText ? addToCartBtnText.textContent : 'Add to Cart';

          addToCartBtn.disabled = true;
          if (addToCartBtnText) addToCartBtnText.textContent = 'Personalizing & Adding...';

          try {
            // Check if variant ID is valid numeric Shopify variant
            const isNumericId = /^\d+$/.test(currentVariantId);
            
            const payload = {
              id: isNumericId ? parseInt(currentVariantId, 10) : null,
              quantity: qty,
              properties: {
                'Personalized Name': personalizedText,
                'Embroidery Font': currentFontName,
                'Thread Color': currentThreadName,
                'Bib Style': currentVariantTitle
              }
            };

            // If in Demo Mode without Shopify product selected, simulate adding to cart
            if (!isNumericId) {
              await new Promise(r => setTimeout(r, 600));
              if (addToCartBtnText) addToCartBtnText.textContent = 'Added to Cart! ✓';
              setTimeout(() => {
                addToCartBtn.disabled = false;
                if (addToCartBtnText) addToCartBtnText.textContent = origText;
              }, 2000);
              return;
            }

            const res = await fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              if (addToCartBtnText) addToCartBtnText.textContent = 'Added to Cart! ✓';
              
              // Publish Theme PubSub event
              if (window.publish && window.PUB_SUB_EVENTS) {
                window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'add' });
              }

              // Open Cart Drawer if present, otherwise fallback to cart page
              const drawer = document.querySelector('cart-drawer');
              if (drawer && typeof drawer.open === 'function') {
                drawer.open();
              } else {
                window.location.href = (window.Shopify?.routes?.root || '/') + 'cart';
              }

              setTimeout(() => {
                addToCartBtn.disabled = false;
                if (addToCartBtnText) addToCartBtnText.textContent = origText;
              }, 2500);

            } else {
              const errData = await res.json();
              throw new Error(errData.description || 'Could not add item');
            }
          } catch (err) {
            console.error('Add to cart error:', err);
            if (addToCartBtnText) addToCartBtnText.textContent = 'Failed to Add - Try Again';
            addToCartBtn.disabled = false;
            setTimeout(() => {
              if (addToCartBtnText) addToCartBtnText.textContent = origText;
            }, 3000);
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.es-bib-section').forEach(initBibPersonalizer);
    });

    document.addEventListener('shopify:section:load', (e) => {
      const section = e.target.querySelector('.es-bib-section');
      if (section) initBibPersonalizer(section);
    });
  })();
</script>

{% schema %}
{
  "name": "Baby bib personalizer",
