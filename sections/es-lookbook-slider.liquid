{%- comment -%}
  E-sellers Lookbook Slider - E-sellers One (v5.0.0)

  Rail of lifestyle images, each paired with a strip of the products featured
  in that shot. Scrolls via CSS scroll-snap; the product strip for a slide
  uses the same horizontal-product card as es-hot-spots' popovers so product
  presentation stays consistent across shoppable sections.
{%- endcomment -%}

{%- liquid
  assign es_lbs_slides = section.blocks | where: 'type', 'slide'
-%}

{%- if es_lbs_slides.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #shopify-section-{{ section.id }} .es-lbs__rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      gap: {{ section.settings.column_gap | default: 20 }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--es-space-2);
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-lbs__rail { grid-auto-columns: 38%; }
    }
    #shopify-section-{{ section.id }} .es-lbs__slide { scroll-snap-align: start; }

    #shopify-section-{{ section.id }} .es-lbs__media {
      aspect-ratio: 3/4;
      border-radius: var(--es-radius-lg);
      overflow: hidden;
      position: relative;
      margin-bottom: var(--es-space-3);
    }
    #shopify-section-{{ section.id }} .es-lbs__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    #shopify-section-{{ section.id }} .es-lbs__products { display: flex; flex-direction: column; gap: var(--es-space-2); }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        button_label: section.settings.button_label,
        button_url: section.settings.button_link -%}

    <div class="es-lbs__rail">
      {%- for block in es_lbs_slides -%}
        <div class="es-lbs__slide" {{ block.shopify_attributes }}>
          <div class="es-lbs__media">
            {%- if block.settings.image != blank -%}
              {%- assign es_lbs_alt = block.settings.image.alt | default: 'Lookbook image' | escape -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: es_lbs_alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
            {%- endif -%}
          </div>
          {%- if block.settings.product_list != blank -%}
            <div class="es-lbs__products">
              {%- for product in block.settings.product_list limit: 3 -%}
                {%- render 'horizontal-product', product: product -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add slide blocks to populate this lookbook.</div>
{%- endif -%}

{% schema %}
{
  "name": "E-sellers Lookbook Slider",
  "tag": "section",
  "class": "shopify-section--es-lookbook-slider",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The lookbook" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Link text" },
    { "type": "url", "id": "button_link", "label": "Link URL" },
    { "type": "range", "id": "column_gap", "label": "Gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product_list", "id": "product_list", "label": "Featured products", "limit": 3 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "E-sellers Lookbook Slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
