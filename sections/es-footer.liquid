{%- comment -%}
  Footer Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#121212' }};
    color: {{ section.settings.text_color | default: '#a1a1aa' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    border-top: 1px solid {{ section.settings.border_color | default: '#27272a' }};
  }

  .footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
    align-items: start;
  }

  .footer__block {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__heading {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .footer__text {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  .footer__text p {
    margin: 0 0 8px 0;
  }

  .footer__text p:last-child {
    margin-bottom: 0;
  }

  .footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__menu-link {
    color: {{ section.settings.text_color | default: '#a1a1aa' }};
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer__menu-link:hover {
    color: {{ section.settings.hover_color | default: '#ffffff' }};
    transform: translateX(3px);
  }

  /* Newsletter Form in Footer */
  .footer__newsletter-form {
    display: flex;
    gap: 8px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .footer__newsletter-input {
    flex: 1;
    min-width: 180px;
    padding: 12px 16px;
    background-color: #1c1917;
    border: 1px solid {{ section.settings.border_color | default: '#27272a' }};
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .footer__newsletter-input:focus {
    border-color: #ffffff;
  }

  .footer__newsletter-btn {
    padding: 12px 20px;
    background-color: {{ section.settings.heading_color | default: '#ffffff' }};
    color: {{ section.settings.bg_color | default: '#121212' }};
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .footer__newsletter-btn:hover {
    opacity: 0.9;
  }

  /* Footer Bottom */
  .footer__bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid {{ section.settings.border_color | default: '#27272a' }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.875rem;
  }

  .footer__copyright {
    margin: 0;
    opacity: 0.8;
  }

  .footer__payment-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 640px) {
    .footer {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
{%- endstyle -%}

<footer class="page-width">
  <!-- Footer Main Grid -->
  <div class="footer">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="footer__text">{{ block.settings.subtext }}</div>
            {%- endif -%}

          {%- when 'link_list' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu">
                {%- for link in block.settings.menu.links -%}
                  <li class="footer__menu-item">
                    <a href="{{ link.url }}" class="footer__menu-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'newsletter' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="footer__text">{{ block.settings.subtext }}</div>
            {%- endif -%}

            {% form 'customer', class: 'footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter, footer">
              <input
                type="email"
                name="contact[email]"
                class="footer__newsletter-input"
                placeholder="{{ 'sections.newsletter.email_placeholder' | t | default: 'Enter your email' }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="footer__newsletter-btn">
                {{ 'sections.newsletter.button_label' | t | default: 'Subscribe' }}
              </button>
            {% endform %}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Footer Bottom / Copyright & Payment Icons -->
  <div class="footer__bottom">
    <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payment-icons" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="footer__payment-item">
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section--footer",
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About E-sellers"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>E-sellers Professional</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe to our newsletter"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#a1a1aa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Link hover color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#27272a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ]
}
{% endschema %}
