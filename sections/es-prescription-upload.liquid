{%- comment -%}
  ES Prescription Upload - E-sellers One (v5.0.0)

  "Upload your prescription" CTA card: image, heading, two feature bullets,
  and a button that opens WhatsApp with the merchant's number - useful for
  pharmacy/medical storefronts that take prescriptions via chat rather than a
  file-upload form.

  The WhatsApp number field accepts a full URL, digits, or a number with
  spaces/dashes/+ and normalises all three to a wa.me link.
{%- endcomment -%}

{%- liquid
  assign es_pu_raw = section.settings.whatsapp_number | strip
  if es_pu_raw == blank
    assign es_pu_link = '#'
  elsif es_pu_raw contains 'http'
    assign es_pu_link = es_pu_raw
  else
    assign es_pu_digits = es_pu_raw | remove: '+' | remove: ' ' | remove: '-'
    assign es_pu_link = 'https://wa.me/' | append: es_pu_digits
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }

  #shopify-section-{{ section.id }} .es-pu {
    max-width: 1100px;
    margin: 0 auto;
    background: {{ section.settings.background | default: '#f5f8f7' }};
    border-radius: var(--es-radius-xl);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .es-pu { grid-template-columns: 1fr 1fr; align-items: center; }
  }

  #shopify-section-{{ section.id }} .es-pu__media { position: relative; aspect-ratio: 4/3; }
  #shopify-section-{{ section.id }} .es-pu__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .es-pu__content { padding: var(--es-space-7); display: flex; flex-direction: column; gap: var(--es-space-4); }
  #shopify-section-{{ section.id }} .es-pu__heading { margin: 0; }
  #shopify-section-{{ section.id }} .es-pu__desc { color: var(--es-fg-muted); }

  #shopify-section-{{ section.id }} .es-pu__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--es-space-2); }
  #shopify-section-{{ section.id }} .es-pu__feature { display: flex; align-items: flex-start; gap: var(--es-space-2); }
  #shopify-section-{{ section.id }} .es-pu__check { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--es-positive); color: #fff; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .es-pu__check svg { width: 12px; height: 12px; }

  #shopify-section-{{ section.id }} .es-pu__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--es-space-2);
    align-self: flex-start;
    padding: var(--es-space-3) var(--es-space-5);
    border-radius: var(--es-radius-md);
    background: {{ section.settings.button_background | default: '#25D366' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    font-weight: 650;
    text-decoration: none;
    transition: opacity var(--es-dur-fast) var(--es-ease);
  }
  #shopify-section-{{ section.id }} .es-pu__btn:hover { opacity: .9; }
  #shopify-section-{{ section.id }} .es-pu__btn svg { width: 16px; height: 16px; }
{%- endstyle -%}

<div class="page-width">
  <div class="es-pu">
    <div class="es-pu__media">
      {%- if section.settings.image != blank -%}
        {%- assign es_pu_alt = section.settings.heading | escape -%}
        {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', alt: es_pu_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
      {%- endif -%}
    </div>

    <div class="es-pu__content">
      {%- if section.settings.heading != blank -%}<h2 class="es-pu__heading h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<p class="es-pu__desc">{{ section.settings.description }}</p>{%- endif -%}

      {%- if section.settings.feature_1 != blank or section.settings.feature_2 != blank -%}
        <ul class="es-pu__features">
          {%- if section.settings.feature_1 != blank -%}
            <li class="es-pu__feature">
              <span class="es-pu__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>{{ section.settings.feature_1 | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.feature_2 != blank -%}
            <li class="es-pu__feature">
              <span class="es-pu__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>{{ section.settings.feature_2 | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <a href="{{ es_pu_link }}" class="es-pu__btn" {% if section.settings.whatsapp_number != blank %}target="_blank" rel="noopener noreferrer"{% endif %}>
        {{ section.settings.button_text | default: 'Upload via WhatsApp' | escape }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ES Prescription Upload",
  "tag": "section",
  "class": "shopify-section--es-prescription-upload",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upload your prescription" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Send us a photo of your prescription and our pharmacist will confirm your order.</p>" },
    { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Reviewed by a licensed pharmacist" },
    { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Delivered within 24 hours" },
    {
      "type": "header",
      "content": "WhatsApp button"
    },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number or link", "info": "A phone number (e.g. +1 555 000 1234) or a full https:// link." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Upload via WhatsApp" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#25D366" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    { "type": "color", "id": "background", "label": "Card background", "default": "#f5f8f7" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    { "name": "ES Prescription Upload" }
  ]
}
{% endschema %}
