{%- comment -%}
  ES Contact Form - E-sellers One (v5.0.0)

  Native Shopify contact form (name/email/phone/message) plus merchant-defined
  custom fields (text, textarea, select, checkbox), and an optional sidebar
  panel for support info (hours, phone, address) next to the form.
{%- endcomment -%}

{%- liquid
  assign es_cf_custom_fields = section.blocks | where: 'type', 'custom_field'
  assign es_cf_sidebar = section.blocks | where: 'type', 'sidebar' | first
  assign es_cf_form_id = 'EsContactForm-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }

  #shopify-section-{{ section.id }} .es-cf__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--es-space-7);
    max-width: {% if es_cf_sidebar %}960px{% else %}640px{% endif %};
    margin: 0 auto;
  }
  {%- if es_cf_sidebar -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-cf__layout { grid-template-columns: 1fr 300px; }
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .es-cf__form { display: flex; flex-direction: column; gap: var(--es-space-4); }
  #shopify-section-{{ section.id }} .es-cf__row { display: grid; grid-template-columns: 1fr; gap: var(--es-space-4); }
  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .es-cf__row--split { grid-template-columns: 1fr 1fr; }
  }

  #shopify-section-{{ section.id }} .es-cf__checkbox-row { display: flex; align-items: center; gap: var(--es-space-2); }
  #shopify-section-{{ section.id }} .es-cf__checkbox-row input { width: auto; }

  #shopify-section-{{ section.id }} .es-cf__banner {
    padding: var(--es-space-3) var(--es-space-4);
    border-radius: var(--es-radius-md);
    font-size: var(--es-text-sm);
  }
  #shopify-section-{{ section.id }} .es-cf__banner--success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
  #shopify-section-{{ section.id }} .es-cf__banner--error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

  #shopify-section-{{ section.id }} .es-cf__sidebar {
    background: var(--es-surface);
    border-radius: var(--es-radius-lg);
    padding: var(--es-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--es-space-3);
    align-self: start;
  }
{%- endstyle -%}

<div class="page-width">
  {%- render 'es-section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: 'center' -%}

  <div class="es-cf__layout">
    <div>
      {%- form 'contact', id: es_cf_form_id, class: 'es-cf__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="es-cf__banner es-cf__banner--success" role="status" tabindex="-1">
            {{ 'sections.contact.form.post_success' | t | default: "Thanks for reaching out. We'll be in touch soon." }}
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="es-cf__banner es-cf__banner--error" role="alert">
              <ul style="margin:0;padding-left:1.2em;">
                {%- for field in form.errors -%}
                  <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{% endif %}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="es-cf__row es-cf__row--split">
            <div class="es-field">
              <label class="es-label" for="{{ es_cf_form_id }}-name">{{ 'sections.contact.form.name' | t | default: 'Name' }}</label>
              <input class="es-field" type="text" id="{{ es_cf_form_id }}-name" name="contact[name]" value="{{ form.name }}">
            </div>
            <div class="es-field">
              <label class="es-label" for="{{ es_cf_form_id }}-email">{{ 'sections.contact.form.email' | t | default: 'Email' }} *</label>
              <input class="es-field" type="email" id="{{ es_cf_form_id }}-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required aria-required="true" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
            </div>
          </div>

          <div class="es-field">
            <label class="es-label" for="{{ es_cf_form_id }}-phone">{{ 'sections.contact.form.phone' | t | default: 'Phone' }}</label>
            <input class="es-field" type="tel" id="{{ es_cf_form_id }}-phone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          {%- for block in es_cf_custom_fields -%}
            {%- liquid
              assign es_cf_field_name = block.settings.text | default: 'Field ' | append: forloop.index
            -%}
            <div class="es-field" {{ block.shopify_attributes }}>
              <label class="es-label" for="{{ es_cf_form_id }}-{{ block.id }}">{{ es_cf_field_name }}{% if block.settings.required %} *{% endif %}</label>
              {%- case block.settings.field_type -%}
                {%- when 'textarea' -%}
                  <textarea class="es-field" id="{{ es_cf_form_id }}-{{ block.id }}" name="contact[{{ es_cf_field_name }}]" rows="4" placeholder="{{ block.settings.placeholder | escape }}" {% if block.settings.required %}required aria-required="true"{% endif %}></textarea>
                {%- when 'select' -%}
                  <select class="es-field select__select" id="{{ es_cf_form_id }}-{{ block.id }}" name="contact[{{ es_cf_field_name }}]" {% if block.settings.required %}required aria-required="true"{% endif %}>
                    {%- assign es_cf_options = block.settings.select_options | split: ',' -%}
                    {%- for opt in es_cf_options -%}<option value="{{ opt | strip | escape }}">{{ opt | strip }}</option>{%- endfor -%}
                  </select>
                {%- when 'checkbox' -%}
                  <div class="es-cf__checkbox-row">
                    <input type="checkbox" id="{{ es_cf_form_id }}-{{ block.id }}" name="contact[{{ es_cf_field_name }}]" value="{{ block.settings.checkbox_checked_value | default: 'Yes' }}">
                  </div>
                {%- else -%}
                  <input class="es-field" type="text" id="{{ es_cf_form_id }}-{{ block.id }}" name="contact[{{ es_cf_field_name }}]" placeholder="{{ block.settings.placeholder | escape }}" {% if block.settings.required %}required aria-required="true"{% endif %}>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          <div class="es-field">
            <label class="es-label" for="{{ es_cf_form_id }}-body">{{ 'sections.contact.form.comment' | t | default: 'Message' }} *</label>
            <textarea class="es-field" id="{{ es_cf_form_id }}-body" name="contact[body]" rows="6" required aria-required="true">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="es-btn">{{ section.settings.button_label | default: 'Send message' | escape }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if es_cf_sidebar -%}
      <aside class="es-cf__sidebar" {{ es_cf_sidebar.shopify_attributes }}>
        {%- if es_cf_sidebar.settings.text != blank -%}<div>{{ es_cf_sidebar.settings.text }}</div>{%- endif -%}
        {%- if es_cf_sidebar.settings.button_label != blank -%}
          {%- render 'es-button', label: es_cf_sidebar.settings.button_label, url: es_cf_sidebar.settings.button_link, style: 'secondary' -%}
        {%- endif -%}
      </aside>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ES Contact Form",
  "tag": "section",
  "class": "shopify-section--es-contact-form",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send message" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "custom_field",
      "name": "Custom field",
      "settings": [
        { "type": "text", "id": "text", "label": "Field label", "default": "Custom field" },
        {
          "type": "select",
          "id": "field_type",
          "label": "Field type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "textarea", "label": "Textarea" },
            { "value": "select", "label": "Dropdown" },
            { "value": "checkbox", "label": "Checkbox" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "placeholder", "label": "Placeholder (text/textarea)" },
        { "type": "text", "id": "select_options", "label": "Dropdown options", "info": "Comma-separated, e.g. Option A, Option B" },
        { "type": "text", "id": "checkbox_checked_value", "label": "Checkbox value when checked", "default": "Yes" },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false }
      ]
    },
    {
      "type": "sidebar",
      "name": "Support sidebar",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our team typically replies within one business day.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "ES Contact Form" }
  ]
}
{% endschema %}
