{%- comment -%}
  ES Collection Tabs - E-sellers One (v5.0.0)

  Tab bar where each tab is a whole collection (not a curated product list -
  see es-featured-products-tab for that variant). Switching tabs swaps both
  the product grid and a small collection banner image/blurb, reusing the
  theme's shared window.switchEsTab-style pattern, scoped per section.
{%- endcomment -%}

{%- liquid
  assign es_clt_tabs = section.blocks | where: 'type', 'collection'
-%}

{%- if es_clt_tabs.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #shopify-section-{{ section.id }} .es-clt__nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--es-space-2) var(--es-space-4);
      border-bottom: var(--es-rule-width) solid var(--es-rule);
      padding-bottom: var(--es-space-3);
      margin-bottom: var(--es-space-6);
    }
    #shopify-section-{{ section.id }} .es-clt__tab {
      background: none; border: none; padding: var(--es-space-2) 0;
      font-size: var(--es-text-md); font-weight: 650; color: var(--es-fg-muted);
      cursor: pointer; white-space: nowrap; position: relative;
    }
    #shopify-section-{{ section.id }} .es-clt__tab:hover { opacity: 1; color: var(--es-fg); box-shadow: none; }
    #shopify-section-{{ section.id }} .es-clt__tab.is-active { color: var(--es-fg); }
    #shopify-section-{{ section.id }} .es-clt__tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -13px; height: 2px; background: var(--es-fg); }

    #shopify-section-{{ section.id }} .es-clt__panel { display: none; }
    #shopify-section-{{ section.id }} .es-clt__panel.is-active { display: block; }

    #shopify-section-{{ section.id }} .es-clt__intro {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--es-space-5);
      margin-bottom: var(--es-space-6);
      align-items: center;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-clt__intro { grid-template-columns: 240px 1fr; }
    }
    #shopify-section-{{ section.id }} .es-clt__intro-media { aspect-ratio: 4/3; border-radius: var(--es-radius-lg); overflow: hidden; position: relative; }
    #shopify-section-{{ section.id }} .es-clt__intro-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    #shopify-section-{{ section.id }} .es-clt__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--es-grid-gap);
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-clt__grid { grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, minmax(0, 1fr)); }
    }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        alignment: 'center' -%}

    <div id="EsClt-{{ section.id }}">
      <div class="es-clt__nav" role="tablist">
        {%- for block in es_clt_tabs -%}
          <button type="button" class="es-clt__tab{% if forloop.first %} is-active{% endif %}"
                  role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  onclick="esCltSwitch{{ section.id | replace: '-', '' }}({{ forloop.index0 }})"
                  {{ block.shopify_attributes }}>
            {{ block.settings.title | default: block.settings.collection.title | escape }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in es_clt_tabs -%}
        {%- assign es_clt_collection = block.settings.collection -%}
        <div class="es-clt__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel">
          {%- if block.settings.image != blank or block.settings.text != blank -%}
            <div class="es-clt__intro">
              {%- if block.settings.image != blank -%}
                <div class="es-clt__intro-media">
                  {%- assign es_clt_alt = block.settings.title | escape -%}
                  {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: es_clt_alt }}
                </div>
              {%- endif -%}
              <div>
                {%- if block.settings.text != blank -%}<div>{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  {%- render 'es-button', label: block.settings.button_label, url: es_clt_collection.url, style: 'link' -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div class="es-clt__grid">
            {%- for product in es_clt_collection.products limit: 8 -%}
              {%- render 'card-product', card_product: product -%}
            {%- else -%}
              {%- for i in (1..4) -%}{%- render 'card-product', card_product: blank -%}{%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      window['esCltSwitch{{ section.id | replace: "-", "" }}'] = function (index) {
        var root = document.getElementById('EsClt-{{ section.id }}');
        if (!root) return;
        var tabs = root.querySelectorAll('.es-clt__tab');
        var panels = root.querySelectorAll('.es-clt__panel');
        tabs.forEach(function (t, i) {
          var active = i === index;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(function (p, i) { p.classList.toggle('is-active', i === index); });
      };
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add collection blocks to populate this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "ES Collection Tabs",
  "tag": "section",
  "class": "shopify-section--es-collection-tabs",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Tab label (optional)", "info": "Falls back to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Intro image (optional)" },
        { "type": "richtext", "id": "text", "label": "Intro text (optional)" },
        { "type": "text", "id": "button_label", "label": "Link label (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "ES Collection Tabs",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
