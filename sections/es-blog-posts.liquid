      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog feed",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Select Blog"
        },
        {
          "type": "range",
          "id": "posts_count",
          "min": 2,
          "max": 12,
          "step": 1,
          "label": "Posts to show",
          "default": 3
        }
      ]
    },
    {
      "type": "article",
      "name": "Featured post",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Featured article"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Card background"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card text color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "E-sellers Blog Posts",
      "blocks": [
        {
          "type": "blog"
        }
      ]
    },
    {
      "name": "E-sellers Featured Post",
      "settings": {
        "title": "Featured Story",
        "subheading": "Editor's Pick"
      },
      "blocks": [
        {
          "type": "article"
        }
      ]
    }
  ]
}
{% endschema %}
