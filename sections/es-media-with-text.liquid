{%- comment -%}
  E-sellers Media With Text Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
  }

  .es-media-text-list {
    display: flex;
    flex-direction: column;
    gap: {% if section.settings.spacing == 'none' %}0{% elsif section.settings.spacing == 'small' %}24px{% elsif section.settings.spacing == 'large' %}64px{% else %}40px{% endif %};
  }

  .es-media-text-item {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 32px;
    align-items: center;
    border-radius: {% if section.settings.spacing == 'none' %}0{% else %}20px{% endif %};
    overflow: hidden;
    background-color: #f8fafc;
  }

  .es-media-text-item__media-col {
    grid-column: span 6;
    height: 100%;
    min-height: 380px;
    position: relative;
    overflow: hidden;
  }

  .es-media-text-item__content-col {
    grid-column: span 6;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  /* Media Position (Left vs Right) */
  .es-media-text-item--media-end .es-media-text-item__media-col {
    order: 2;
  }

  .es-media-text-item--media-end .es-media-text-item__content-col {
    order: 1;
  }

  .es-media-text__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .es-media-text__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .es-media-text__subheading {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin: 0;
    color: #64748b;
  }

  .es-media-text__heading {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: #0f172a;
  }

  .es-media-text__body {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .es-media-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    align-self: flex-start;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .es-media-text__btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .es-media-text__icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .es-media-text-item {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .es-media-text-item__media-col {
      grid-column: 1;
      order: 1 !important;
      min-height: 280px;
      max-height: 400px;
    }

    .es-media-text-item__content-col {
      grid-column: 1;
      order: 2 !important;
      padding: 28px 20px;
    }
  }
{%- endstyle -%}

<div class="es-media-with-text-section">
  <div class="{% if section.settings.full_width %}page-width-full{% else %}page-width{% endif %}">
    <div class="es-media-text-list">
      {%- for block in section.blocks -%}
        {%- assign media_pos = block.settings.media_position | default: 'start' -%}
        <div
          class="es-media-text-item {% if media_pos == 'end' %}es-media-text-item--media-end{% endif %}"
          style="
            {% if block.settings.background != blank %}background-color: {{ block.settings.background }};{% endif %}
            {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
          "
          {{ block.shopify_attributes }}
        >
          <!-- Media Column -->
          <div class="es-media-text-item__media-col">
            {%- if block.type == 'image' -%}
              {%- if block.settings.image != blank -%}
                {%- assign es_tagarg_1 = block.settings.image.alt | default: block.settings.title | escape -%}{{ block.settings.image | image_url: width: 1600 | image_tag:
                  loading: 'lazy',
                  class: 'es-media-text__img',
                  alt: es_tagarg_1}}
              {%- else -%}
                <div style="width: 100%; height: 100%; min-height: 380px; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: #64748b;">
                  <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {%- endif -%}

            {%- elsif block.type == 'video' -%}
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag:
                  playsinline: true,
                  autoplay: block.settings.autoplay,
                  loop: block.settings.autoplay,
                  muted: block.settings.autoplay,
                  controls: true,
                  class: 'es-media-text__video'
                }}
              {%- elsif block.settings.external_video_url != blank -%}
                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; width: 100%; height: 100%;">
                  <iframe
                    src="{{ block.settings.external_video_url }}"
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <!-- Content Column -->
          <div class="es-media-text-item__content-col">
            {%- if block.settings.custom_icon != blank -%}
              <img src="{{ block.settings.custom_icon | image_url: width: 120 }}" width="{{ block.settings.custom_icon.width }}" height="{{ block.settings.custom_icon.height }}" alt="Icon" class="es-media-text__icon" loading="lazy">
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="es-media-text__subheading" style="{% if block.settings.text_color != blank %}color: inherit; opacity: 0.8;{% endif %}">
                {{ block.settings.subheading | escape }}
              </p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h2
                class="es-media-text__heading"
                style="
                  {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                  {% if block.settings.text_gradient != blank %}
                    background: {{ block.settings.text_gradient }};
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                  {% endif %}
                "
              >
                {{ block.settings.title | escape }}
              </h2>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="es-media-text__body" style="{% if block.settings.text_color != blank %}color: inherit; opacity: 0.9;{% endif %}">
                {{ block.settings.content }}
              </div>
            {%- endif -%}

            {%- if block.settings.link_text != blank -%}
              <a
                href="{{ block.settings.link_url | default: '#' }}"
                class="es-media-text__btn"
                style="
                  background-color: {{ block.settings.button_background | default: '#0f172a' }};
                  color: {{ block.settings.button_text_color | default: '#ffffff' }};
                "
              >
                {{ block.settings.link_text | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "E-sellers Media with Text",
  "class": "shopify-section--es-media-with-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
