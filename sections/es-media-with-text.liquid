          "default": "start"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Behind the Scenes"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Experience the Process"
