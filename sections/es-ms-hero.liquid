{%- comment -%}
  milk_shake Luxury Sensory Hero with Editorial Headline, Floating Glass Badges & Travertine Studio Visual
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }} {
    background: {{ section.settings.background | default: '#faf7f2' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    color: {{ section.settings.text_color | default: '#5c5248' }};
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }
  .section-{{ section.id }} .hero-heading {
    color: {{ section.settings.heading_color | default: '#2b231d' }};
    {% if section.settings.heading_gradient != blank %}
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    {% endif %}
  }
  .section-{{ section.id }} .btn-primary {
    background: {{ section.settings.btn_primary_bg | default: '#2b231d' }};
    color: {{ section.settings.btn_primary_text_color | default: '#ffffff' }};
  }
  .section-{{ section.id }} .btn-primary:hover {
    background: {{ section.settings.btn_primary_hover_bg | default: '#d48d53' }};
  }
  .section-{{ section.id }} .btn-secondary {
    background: {{ section.settings.btn_secondary_bg | default: '#ffffff' }};
    color: {{ section.settings.btn_secondary_text_color | default: '#2b231d' }};
    border: 1px solid {{ section.settings.btn_secondary_border | default: '#e8decb' }};
  }
  .section-{{ section.id }} .btn-secondary:hover {
    background: {{ section.settings.btn_secondary_hover_bg | default: '#f4ede2' }};
  }
{%- endstyle -%}

<section class="section-{{ section.id }} relative overflow-hidden">
  <!-- Subtle ambient glow circle -->
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-milkshake-butter/40 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-milkshake-rose/30 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center {% if section.settings.image_position == 'left' %}lg:flex-row-reverse{% endif %}">
      
      <!-- Left Copy Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col {% if section.settings.text_alignment == 'center' %}items-center text-center{% else %}items-start text-left{% endif %}">
        
        <!-- Botanical Origin Badge -->
        {% if section.settings.badge_text != blank %}
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-milkshake-border/80 shadow-xs mb-6 backdrop-blur-sm">
            <span class="text-sm">🌿</span>
            <span class="text-xs font-semibold uppercase tracking-wider text-milkshake-espresso">
              {{ section.settings.badge_text }}
            </span>
          </div>
        {% endif %}

        <!-- Editorial Display Headline -->
        <h1 class="hero-heading font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-normal tracking-tight leading-[1.15] mb-6">
          {{ section.settings.heading | default: 'Sensory Haircare Infused with Real Organic Milk & Fruit Extracts' }}
        </h1>

        <!-- Subheading Paragraph -->
        <p class="text-sm sm:text-base md:text-lg text-milkshake-muted max-w-2xl leading-relaxed mb-8 font-light">
          {{ section.settings.subheading | default: "Transform dry, treated or sun-stressed locks with Italy's most celebrated whipped conditioners, silver toning elixirs and moisture infusions tailored for the Egyptian climate." }}
        </p>

        <!-- Dual Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-10 w-full {% if section.settings.text_alignment == 'center' %}justify-center{% endif %}">
          {% if section.settings.btn_primary_text != blank %}
            <a href="{{ section.settings.btn_primary_url | default: routes.all_products_collection_url }}" class="btn-primary px-7 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-2.5 shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5">
              <span>{{ section.settings.btn_primary_text }}</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          {% endif %}

          {% if section.settings.btn_secondary_text != blank %}
            <a href="{{ section.settings.btn_secondary_url | default: '#hair-quiz' }}" class="btn-secondary px-7 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-2.5 shadow-xs hover:shadow-md transition-all">
              <span class="material-symbols-outlined text-sm text-milkshake-accent">auto_awesome</span>
              <span>{{ section.settings.btn_secondary_text }}</span>
            </a>
          {% endif %}
        </div>

        <!-- Social Proof Micro-Rating -->
        {% if section.settings.show_social_proof %}
          <div class="flex items-center gap-3 pt-4 border-t border-milkshake-border/60 w-full {% if section.settings.text_alignment == 'center' %}justify-center{% endif %}">
            <div class="flex text-amber-500 text-sm">
              ★★★★★
            </div>
            <p class="text-xs text-milkshake-charcoal font-medium">
              <strong class="font-bold">4.9/5</strong> {{ section.settings.social_proof_text | default: 'from 1,840+ verified salons & clients across Cairo & Alexandria' }}
            </p>
          </div>
        {% endif %}

      </div>

      <!-- Right Visual Column (5 cols) -->
      <div class="lg:col-span-5 relative flex justify-center">
        
        <!-- Ambient Glowing Aura -->
        <div class="absolute inset-0 m-auto w-72 h-72 sm:w-88 sm:h-88 rounded-full bg-gradient-to-tr from-milkshake-sand via-milkshake-butter to-milkshake-crema blur-2xl opacity-70"></div>

        <!-- Main Product Studio Image on Travertine Pedestal -->
        <div class="relative z-10 w-full max-w-sm sm:max-w-md">
          <div class="overflow-hidden rounded-3xl shadow-2xl border-4 border-white/90 bg-milkshake-crema/40 {{ section.settings.image_ratio }}">
            {% if section.settings.hero_image != blank %}
              {{ section.settings.hero_image | image_url: width: 900 | image_tag: 
                class: 'w-full h-full object-cover transition-transform duration-700 hover:scale-105', 
                alt: section.settings.heading 
              }}
            {% else %}
              <img 
                src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=900&auto=format&fit=crop" 
                alt="milk_shake Whipped Cream Studio Display" 
                width="900"
                height="900"
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              >
            {% endif %}
          </div>

          <!-- Floating Glass Tag: Whipped Cream Best Seller -->
          <div class="absolute -bottom-6 -left-4 sm:-left-8 bg-white/95 backdrop-blur-md p-4 rounded-2xl shadow-xl border border-milkshake-border flex items-center gap-3 z-20 animate-bounce-subtle">
            <div class="w-10 h-10 rounded-xl bg-milkshake-sand flex items-center justify-center text-milkshake-accent font-serif font-bold text-lg shadow-inner">
              m
            </div>
            <div>
              <div class="flex items-center gap-1">
                <span class="text-amber-500 text-xs">★★★★★</span>
                <span class="text-[10px] font-bold text-milkshake-charcoal">Best Seller</span>
              </div>
              <p class="text-xs font-serif font-semibold text-milkshake-charcoal mt-0.5">
                Whipped Cream Leave-In
              </p>
              <p class="text-[10px] text-milkshake-muted">Original Italian Mousse Formula</p>
            </div>
          </div>

          <!-- Floating Glass Tag: Organic Extracts -->
          <div class="absolute -top-4 -right-4 sm:-right-6 bg-white/90 backdrop-blur-md px-3.5 py-2 rounded-full shadow-lg border border-milkshake-border flex items-center gap-2 z-20">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px] font-semibold text-milkshake-charcoal tracking-tight">Organic Milk & Papaya</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "MS Hero",
  "settings": [
    {
      "type": "header",
      "content": "Botanical Badge & Headings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Botanical Badge Text",
      "default": "Direct from Varese, Italy • Certified Salon Grade"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Editorial Headline",
      "default": "Sensory Haircare Infused with Real Organic Milk & Fruit Extracts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Copy",
      "default": "Transform dry, treated or sun-stressed locks with Italy's most celebrated whipped conditioners, silver toning elixirs and moisture infusions tailored for the Egyptian climate."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Label",
      "default": "Take Italian Hair Quiz"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "header",
      "content": "Social Proof"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show Social Proof Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Social Proof Text",
      "default": "from 1,840+ verified salons & clients across Cairo & Alexandria"
    },
    {
      "type": "header",
      "content": "Hero Visual & Layout"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Studio Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "right", "label": "Image on Right" },
        { "value": "left", "label": "Image on Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "es-aspect-4-5", "label": "Portrait (4:5)" },
        { "value": "es-aspect-3-4", "label": "Portrait (3:4)" },
        { "value": "es-aspect-1-1", "label": "Square (1:1)" },
        { "value": "es-aspect-16-10", "label": "Landscape (16:10)" },
        { "value": "es-aspect-natural", "label": "Natural" }
      ],
      "default": "es-aspect-4-5"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section Background",
      "default": "#FAF7F2"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background Gradient"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2B231D"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading Gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#5C5248"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Primary Button Background",
      "default": "#2B231D"
    },
    {
      "type": "color",
      "id": "btn_primary_text_color",
      "label": "Primary Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_primary_hover_bg",
      "label": "Primary Button Hover Background",
      "default": "#D48D53"
    },
    {
      "type": "color",
      "id": "btn_secondary_bg",
      "label": "Secondary Button Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_secondary_text_color",
      "label": "Secondary Button Text Color",
      "default": "#2B231D"
    },
    {
      "type": "color",
      "id": "btn_secondary_border",
      "label": "Secondary Button Border",
      "default": "#E8DECB"
    },
    {
      "type": "color",
      "id": "btn_secondary_hover_bg",
      "label": "Secondary Button Hover Background",
      "default": "#F4EDE2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "MS Hero"
    }
  ]
}
{% endschema %}
