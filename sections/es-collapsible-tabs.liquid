{%- comment -%}
  ES Collapsible Tabs - E-sellers One (v5.0.0)

  Sticky image beside a native <details>/<summary> accordion - common for
  "materials & care", "sizing", "shipping" style product-adjacent content next
  to a supporting photo. Distinct from es-accordion-content (text-only, no
  image column).
{%- endcomment -%}

{%- liquid
  assign es_clp_items = section.blocks | where: 'type', 'collapsible_item'
  assign es_clp_image_position = section.settings.desktop_image_position | default: 'left'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  #shopify-section-{{ section.id }} .es-clp {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--es-space-7);
    align-items: start;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .es-clp { grid-template-columns: 1fr 1fr; }
    {%- if es_clp_image_position == 'right' -%}
      #shopify-section-{{ section.id }} .es-clp__media { order: 2; }
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .es-clp__media {
    aspect-ratio: {{ section.settings.image_ratio | default: '4/5' }};
    border-radius: var(--es-radius-lg);
    overflow: hidden;
    position: relative;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .es-clp__media { position: sticky; top: var(--es-space-6); }
  }
  #shopify-section-{{ section.id }} .es-clp__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .es-clp__item { border-bottom: var(--es-rule-width) solid var(--es-rule); }
  #shopify-section-{{ section.id }} .es-clp__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--es-space-3);
    padding: var(--es-space-4) 0;
    cursor: pointer;
    list-style: none;
    font-weight: 650;
    font-size: var(--es-text-md);
  }
  #shopify-section-{{ section.id }} .es-clp__item summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .es-clp__item .es-clp__icon { transition: transform var(--es-dur-base) var(--es-ease); flex-shrink: 0; }
  #shopify-section-{{ section.id }} .es-clp__item .es-clp__icon svg { width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .es-clp__item[open] .es-clp__icon { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .es-clp__item-body { padding-bottom: var(--es-space-4); color: var(--es-fg-muted); }
{%- endstyle -%}

<div class="page-width">
  <div class="es-clp">
    <div class="es-clp__media">
      {%- if section.settings.image != blank -%}
        {%- assign es_clp_alt = section.settings.heading | escape -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: es_clp_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
      {%- endif -%}
    </div>

    <div>
      {%- render 'es-section-heading',
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          description: section.settings.description -%}

      <div>
        {%- for block in es_clp_items -%}
          <details class="es-clp__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.heading | escape }}</span>
              <span class="es-clp__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="es-clp__item-body">
              {%- if block.settings.page != blank -%}
                {{ block.settings.page.content }}
              {%- else -%}
                {{ block.settings.content }}
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ES Collapsible Tabs",
  "tag": "section",
  "class": "shopify-section--es-collapsible-tabs",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "16/9", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Image position",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "collapsible_item",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Materials & care" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or select a page", "info": "Overrides the content above when set." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "ES Collapsible Tabs",
      "blocks": [{ "type": "collapsible_item" }, { "type": "collapsible_item" }, { "type": "collapsible_item" }]
    }
  ]
}
{% endschema %}
