            "author_location": "Cairo (Verified Client)",
            "avatar_bg_class": "bg-pastel-flower-vibes"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The Super Moisture bundle salvaged my damaged curls after a harsh summer in Sahel. It arrived in Alexandria in only 48 hours. Five stars!",
            "author_initials": "ME",
            "author_name": "Mariam E.",
            "author_location": "Alexandria (Verified Client)",
            "avatar_bg_class": "bg-pastel-moisture-plus"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Incredible Milk is literally 12 miracles in one. Heat protection, detangling, and makes my blow dry look like I stepped out of a Cleopatra salon.",
            "author_initials": "YA",
            "author_name": "Yasmine A.",
            "author_location": "Sheikh Zayed (Verified Client)",
            "avatar_bg_class": "bg-pastel-make-my-day"
          }
        },
        {
