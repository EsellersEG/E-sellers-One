{% render 'es-section-style', section: section %}
<section class="w-full py-space-3xl bg-surface section-{{ section.id }}-settings" id="es-milkshake-social-proof-{{ section.id }}">
  <div class="max-w-[1440px] mx-auto px-margin">
    <!-- Testimonials Header -->
    <div class="text-center max-w-2xl mx-auto mb-space-2xl">
      {% if section.settings.reviews_subtitle != blank %}
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-space-xs block">
          {{ section.settings.reviews_subtitle }}
        </span>
      {% endif %}
      {% if section.settings.reviews_heading != blank %}
        <h2 class="font-headline-xl text-headline-xl text-primary mb-space-sm">
          {{ section.settings.reviews_heading }}
        </h2>
      {% endif %}
      {% if section.settings.reviews_description != blank %}
        <p class="font-body-md text-body-md text-on-surface-variant">
          {{ section.settings.reviews_description }}
        </p>
      {% endif %}
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg mb-space-3xl">
      {% assign has_testimonials = false %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          {% assign has_testimonials = true %}
          <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between" {{ block.shopify_attributes }}>
            <div>
              <div class="flex text-[#D4AF37] mb-space-sm">
                {% assign rating = block.settings.rating | default: 5 %}
                {% for i in (1..rating) %}
                  <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                {% endfor %}
              </div>
              <p class="font-body-md text-body-md text-on-surface italic mb-space-md">
                "{{ block.settings.quote }}"
              </p>
            </div>
            <div class="flex items-center gap-space-sm pt-space-sm">
              <div class="w-10 h-10 rounded-full {{ block.settings.avatar_bg_class | default: 'bg-pastel-flower-vibes' }} flex items-center justify-center font-bold text-primary">
                {{ block.settings.author_initials }}
              </div>
              <div class="flex flex-col">
                <span class="font-headline-sm text-headline-sm text-primary">
                  {{ block.settings.author_name }}
                </span>
                <span class="font-body-sm text-body-sm text-text-muted">
                  {{ block.settings.author_location }}
                </span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% unless has_testimonials %}
        <!-- Fallback 1: Nour H. -->
        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex text-[#D4AF37] mb-space-sm">
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            </div>
            <p class="font-body-md text-body-md text-on-surface italic mb-space-md">
              "The smell of the whipped cream leave-in is unmatched, and my bleached blond hair never turned brassy even with Cairo water! Absolutely hooked."
            </p>
          </div>
          <div class="flex items-center gap-space-sm pt-space-sm">
            <div class="w-10 h-10 rounded-full bg-pastel-flower-vibes flex items-center justify-center font-bold text-primary">
              NH
            </div>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-primary">Nour H.</span>
              <span class="font-body-sm text-body-sm text-text-muted">Cairo (Verified Client)</span>
            </div>
          </div>
        </div>

        <!-- Fallback 2: Mariam E. -->
        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex text-[#D4AF37] mb-space-sm">
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            </div>
            <p class="font-body-md text-body-md text-on-surface italic mb-space-md">
              "The Super Moisture bundle salvaged my damaged curls after a harsh summer in Sahel. It arrived in Alexandria in only 48 hours. Five stars!"
            </p>
          </div>
          <div class="flex items-center gap-space-sm pt-space-sm">
            <div class="w-10 h-10 rounded-full bg-pastel-moisture-plus flex items-center justify-center font-bold text-primary">
              ME
            </div>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-primary">Mariam E.</span>
              <span class="font-body-sm text-body-sm text-text-muted">Alexandria (Verified Client)</span>
            </div>
          </div>
        </div>

        <!-- Fallback 3: Yasmine A. -->
        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex text-[#D4AF37] mb-space-sm">
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
              <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
            </div>
            <p class="font-body-md text-body-md text-on-surface italic mb-space-md">
              "Incredible Milk is literally 12 miracles in one. Heat protection, detangling, and makes my blow dry look like I stepped out of a Cleopatra salon."
            </p>
          </div>
          <div class="flex items-center gap-space-sm pt-space-sm">
            <div class="w-10 h-10 rounded-full bg-pastel-make-my-day flex items-center justify-center font-bold text-primary">
              YA
            </div>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-primary">Yasmine A.</span>
              <span class="font-body-sm text-body-sm text-text-muted">Sheikh Zayed (Verified Client)</span>
            </div>
          </div>
        </div>
      {% endunless %}
    </div>

    <!-- Instagram Showcase Gallery -->
    <div class="flex items-center justify-between mb-space-lg">
      <div>
        {% if section.settings.insta_handle != blank %}
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-text-muted block">
            {{ section.settings.insta_handle }}
          </span>
        {% endif %}
        {% if section.settings.insta_heading != blank %}
          <h3 class="font-headline-md text-headline-md text-primary">
            {{ section.settings.insta_heading }}
          </h3>
        {% endif %}
      </div>
      {% if section.settings.insta_link_text != blank %}
        <a class="font-label-lg text-label-lg uppercase tracking-wider text-primary hover:text-secondary flex items-center gap-1 transition-colors" href="{{ section.settings.insta_url | default: 'https://www.instagram.com/milkshakegypt' }}" target="_blank" rel="noopener">
          {{ section.settings.insta_link_text }}
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
        </a>
      {% endif %}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-md">
      {% assign has_insta = false %}
      {% for block in section.blocks %}
        {% if block.type == 'instagram_post' %}
          {% assign has_insta = true %}
          <a href="{{ block.settings.link | default: section.settings.insta_url | default: 'https://www.instagram.com/milkshakegypt' }}" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden bg-surface-container relative group block" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: 'milk_shake instagram post' }}" loading="lazy">
            {% elsif block.settings.image_url != blank %}
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="{{ block.settings.image_url }}" alt="milk_shake instagram post" loading="lazy">
            {% else %}
              <div class="w-full h-full flex items-center justify-center text-text-muted">Instagram Post</div>
            {% endif %}
            <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
              <span class="material-symbols-outlined text-[32px]">photo_camera</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}

      {% unless has_insta %}
        <!-- Instagram Fallback 1 -->
        <a href="https://www.instagram.com/milkshakegypt" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden bg-surface-container relative group block">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Customer selfie showing glossy blonde hair styled with milk_shake" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAOIoKwpGBliSXZnps-SZ1TUVkrMvD4rS1baRHXy6TV22zXKUmYNvHUdQGPuZIHUZdHbMbMToMwxkcg9lB09Fsrcj9SxO7ZLbLkyT2cvFYv64ZNK231u8TMetYbv87CqHc2BjZ7mDAL4u6tjOo9f9QRAtHTGmFCHIyfXBaZ2msQJGSCJVhLperoeMwDmNLL6nqHny1SdwERZBlt6R8pCXPWDhMId_096F8XyOpP39-6KiBcGeOok5Q" loading="lazy"/>
          <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-[32px]">photo_camera</span>
          </div>
        </a>

        <!-- Instagram Fallback 2 -->
        <a href="https://www.instagram.com/milkshakegypt" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden bg-surface-container relative group block">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Salon client receiving whipped cream treatment" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBx3kGVLEgZ4mKWZmdSBK_siP5t2Ln4bxpSoRGxpCUB2ZcY8tYA177T3mX3LgQUz_mPkJkfSieCmWTB4Qjtr4mtqtYGXfOj427yYksl1THP5lPhfgE2sGhb9kEQPv9TKIG-aMCdlCdnsO0KZ8Wy6dNhsPpXq_MiyAJRcEINY-m4Ov_ZbIS3zWk-lgQmP2nYuW-2XA1hsbEwzlc6fHJuEJGtOtrF4Jl7gt2TEXXBilXVJcf1ctdJXxg" loading="lazy"/>
          <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-[32px]">photo_camera</span>
          </div>
        </a>

        <!-- Instagram Fallback 3 -->
        <a href="https://www.instagram.com/milkshakegypt" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden bg-surface-container relative group block">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Flat lay photograph of milk_shake pastel bottles" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCYE9pKgWC0hYgf3CI76W_zasu98YJluRpAub-G5IHRozHObJBRf4thu8YNdloP6x_D3YlqQ1UnDZ-TDHReuAvIAclFRaW45YqP7yumxoFRbhI5fwDRG_4ku4mxM4uP8aHtgn9dUYN7Oh33YTzAAFHn7u-BTvKNMb2cgpGWegiwG7dEeXE6uEP-8aPpvHmYcWf-KVkCUE16EODGDCk-jEXjOy4FQD3xtNaiEOioEecTDnutEp7tBZ8" loading="lazy"/>
          <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-[32px]">photo_camera</span>
          </div>
        </a>

        <!-- Instagram Fallback 4 -->
        <a href="https://www.instagram.com/milkshakegypt" target="_blank" rel="noopener" class="aspect-square rounded-xl overflow-hidden bg-surface-container relative group block">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Model with voluminous hydrated curls holding incredible milk" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDU_EcTNLys6F4-i9nJ17zNL4WLyVAUOmWIa-jjyvKgzijzBQFNzgnM6htrE_yk4oiNjNiLYjLvoV24Y15mJF9NRPY8nUi_SHG2oNZLlUbEQNIu4padJp_RPV5T5tZJvJB0aS_cMsyx8Af6GAhWS4GYxZmqcZIdLz9wSPvxoTWCxUKPP7fNduCwjB5o2iZY0qx5oDOxzTir8JbD_7tj3XINt8InJoVRUdp_mIvu8cy_HIiLfJSEq9U" loading="lazy"/>
          <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-[32px]">photo_camera</span>
          </div>
        </a>
      {% endunless %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ES Social Proof & Insta",
  "settings": [
    {
      "type": "text",
      "id": "reviews_subtitle",
      "label": "Reviews Subtitle",
      "default": "Real Egyptian Experiences"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews Heading",
      "default": "Loved in Cairo, Alexandria & Beyond"
    },
    {
      "type": "textarea",
      "id": "reviews_description",
      "label": "Reviews Description",
      "default": "See how our natural milk protein rituals transformed damaged and color-treated locks across Egypt."
    },
    {
      "type": "text",
      "id": "insta_handle",
      "label": "Instagram Handle",
      "default": "@milkshakegypt"
    },
    {
      "type": "text",
      "id": "insta_heading",
      "label": "Instagram Heading",
      "default": "The Salon Atelier on Instagram"
    },
    {
      "type": "text",
      "id": "insta_link_text",
      "label": "Instagram Link Text",
      "default": "Follow Along"
    },
    {
      "type": "url",
      "id": "insta_url",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors and Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Border and Radius"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Desktop)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Spacing (Mobile and Tablet)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Tablet)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Responsive Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS rules",
      "info": "Write CSS targeting .section-{{ section.id }}-settings or child classes"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Client Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The smell of the whipped cream leave-in is unmatched, and my bleached blond hair never turned brassy even with Cairo water! Absolutely hooked."
        },
        {
          "type": "text",
          "id": "author_initials",
          "label": "Author Initials",
          "default": "NH"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Nour H."
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Author Location",
          "default": "Cairo (Verified Client)"
        },
        {
          "type": "text",
          "id": "avatar_bg_class",
          "label": "Avatar Background Class",
          "default": "bg-pastel-flower-vibes"
        }
      ]
    },
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (fallback)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
