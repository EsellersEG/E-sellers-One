          "default": "LE 1,150.00"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Get The Travel Size Free"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
