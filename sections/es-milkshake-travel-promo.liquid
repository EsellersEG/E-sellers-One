      "default": "Purchase the 350 ML Leave-In Conditioner in your chosen signature scent at LE 1,150.00 and receive the matching 75 ML travel edition completely complimentary (Free LE 449.00 Value)."
    }
  ],
  "blocks": [
    {
      "type": "offer",
