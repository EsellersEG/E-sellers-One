{%- comment -%}
  Main Search Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .main-search__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .main-search__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: {{ section.settings.heading_color | default: '#121212' }};
    margin: 0 0 16px;
  }

  .main-search__form {
    max-width: 540px;
    margin: 0 auto 32px;
    display: flex;
    gap: 12px;
  }

  .main-search__input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 1rem;
    outline: none;
  }

  .main-search__btn {
    background: #121212;
    color: #ffffff;
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .main-search__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
    gap: 24px;
  }

  @media screen and (max-width: 749px) {
    .main-search__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
      gap: 16px;
    }
  }
{%- endstyle -%}

<div class="main-search page-width">
  <header class="main-search__header">
    <h1 class="main-search__title">
      {%- if search.performed -%}
        Search results for "{{ search.terms }}"
      {%- else -%}
        Search our store
      {%- endif -%}
    </h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search for products, collections..."
        class="main-search__input"
      >
      <button type="submit" class="main-search__btn">Search</button>
    </form>
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.products_per_page -%}
      {%- if search.results_count > 0 -%}
        <div class="main-search__grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'card-product', card_product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- else -%}
        <p style="text-align: center; color: #64748b; padding: 40px 0;">No results found for "{{ search.terms }}". Try a different search term.</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section--main-search",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Results per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ]
}
{% endschema %}
