{%- comment -%}
  ES Scrolling Gallery Image - E-sellers One (v5.0.0)

  Infinite CSS marquee of square gallery images, each optionally tagged with a
  small social-network badge (for UGC-style "as shared on Instagram" rows).
  Same double-pass marquee technique as es-offers-banner and es-partners-carousel.
{%- endcomment -%}

{%- liquid
  assign es_sgi_images = section.blocks | where: 'type', 'gallery'
  assign es_sgi_uid = section.id | replace: '-', '_'
-%}

{%- if es_sgi_images.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --es-sgi-duration: {{ 6.0 | divided_by: section.settings.speed | default: 1.0 }}s;
      padding-top: {{ section.settings.padding_top | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .es-sgi__viewport { overflow: hidden; width: 100%; }

    #shopify-section-{{ section.id }} .es-sgi__track {
      display: flex;
      gap: {{ section.settings.column_gap | default: 16 }}px;
      width: max-content;
      animation: es-sgi-scroll-{{ es_sgi_uid }} var(--es-sgi-duration) linear infinite;
      {%- if section.settings.direction == 'right' -%}
        animation-direction: reverse;
      {%- endif -%}
    }
    {%- if section.settings.pause_on_hover -%}
      #shopify-section-{{ section.id }}:hover .es-sgi__track { animation-play-state: paused; }
    {%- endif -%}

    @keyframes es-sgi-scroll-{{ es_sgi_uid }} {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    #shopify-section-{{ section.id }} .es-sgi__item {
      position: relative;
      flex: 0 0 auto;
      width: 220px;
      aspect-ratio: 1/1;
      border-radius: var(--es-radius-lg);
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .es-sgi__item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    #shopify-section-{{ section.id }} .es-sgi__badge {
      position: absolute;
      bottom: 8px; left: 8px;
      width: 26px; height: 26px;
      border-radius: 50%;
      background: rgba(255,255,255,.92);
      color: #121212;
      display: flex; align-items: center; justify-content: center;
    }
    #shopify-section-{{ section.id }} .es-sgi__badge svg { width: 14px; height: 14px; }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .es-sgi__track { animation: none; flex-wrap: wrap; width: 100%; }
      #shopify-section-{{ section.id }} .es-sgi__item--clone { display: none; }
    }
  {%- endstyle -%}

  <div class="page-width">
    {%- render 'es-section-heading',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        button_label: section.settings.button_label,
        button_url: section.settings.button_link -%}
  </div>

  <div class="es-sgi__viewport">
    <div class="es-sgi__track">
      {%- for pass in (1..2) -%}
        {%- for block in es_sgi_images -%}
          <div class="es-sgi__item{% if pass == 2 %} es-sgi__item--clone{% endif %}" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %} {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {%- if block.settings.image != blank -%}
              {%- assign es_sgi_alt = block.settings.image.alt | default: 'Gallery image' | escape -%}
              {{ block.settings.image | image_url: width: 440 | image_tag: loading: 'lazy', widths: '220,330,440', alt: es_sgi_alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
            {%- endif -%}
            {%- if block.settings.social_media != blank and block.settings.social_media != 'none' -%}
              <span class="es-sgi__badge">{%- render 'icon', name: block.settings.social_media -%}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="text-align:center;padding:40px 0;opacity:.6;">Add gallery image blocks to populate this marquee.</div>
{%- endif -%}

{% schema %}
{
  "name": "ES Scrolling Gallery",
  "tag": "section",
  "class": "shopify-section--es-scrolling-gallery-image",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shared by our community" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Link text" },
    { "type": "url", "id": "button_link", "label": "Link URL" },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [{ "value": "left", "label": "Right to left" }, { "value": "right", "label": "Left to right" }],
      "default": "left"
    },
    { "type": "range", "id": "speed", "label": "Speed", "min": 1, "max": 5, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "range", "id": "column_gap", "label": "Gap", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 16 },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "gallery",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "social_media",
          "label": "Social badge",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "twitter", "label": "Twitter" },
            { "value": "tiktok", "label": "TikTok" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "ES Scrolling Gallery",
      "blocks": [{ "type": "gallery" }, { "type": "gallery" }, { "type": "gallery" }, { "type": "gallery" }, { "type": "gallery" }]
    }
  ]
}
{% endschema %}
