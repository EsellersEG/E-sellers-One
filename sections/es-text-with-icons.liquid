{%- comment -%}
  E-sellers Text with Icons Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    background-color: {{ section.settings.background | default: '#f8fafc' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    color: {{ section.settings.text_color | default: '#0f172a' }};
  }

  .es-twi-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: center;
  }

  .es-twi-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    margin: 0;
    text-align: center;
    color: inherit;
  }

  .es-twi-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, minmax(0, 1fr));
    gap: {% if section.settings.icon_spacing == 'small' %}20px{% elsif section.settings.icon_spacing == 'large' %}48px{% else %}32px{% endif %};
    width: 100%;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .es-twi-item {
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'start' %}flex-start{% else %}center{% endif %};
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    gap: 14px;
  }

  /* Icon Badges */
  .es-twi-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .es-twi-item:hover .es-twi-icon-badge {
    transform: translateY(-2px);
  }

  .es-twi-icon-badge--circle {
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border: 1px solid #e2e8f0;
  }

  .es-twi-icon-badge--square {
    border-radius: 12px;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border: 1px solid #e2e8f0;
  }

  .es-twi-icon-badge--none {
    background: transparent;
  }

  .es-twi-custom-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .es-twi-title {
    font-weight: 700;
    margin: 0 0 4px 0;
    color: inherit;
  }

  .es-twi-title.h1 { font-size: 1.75rem; }
  .es-twi-title.h2 { font-size: 1.5rem; }
  .es-twi-title.h3 { font-size: 1.25rem; }
  .es-twi-title.h4 { font-size: 1.1rem; }
  .es-twi-title.h5 { font-size: 1rem; }
  .es-twi-title.h6 { font-size: 0.9rem; }

  .es-twi-content {
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.85;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .es-twi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (max-width: 640px) {
    {% if section.settings.stack_on_mobile %}
      .es-twi-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    {% else %}
      .es-twi-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 12px;
        -webkit-overflow-scrolling: touch;
      }
      .es-twi-item {
        flex: 0 0 80vw;
        scroll-snap-align: start;
        padding: 0 8px;
      }
    {% endif %}
  }
{%- endstyle -%}

<div class="{% if section.settings.full_width %}page-width-full{% else %}page-width{% endif %}">
  <div class="es-twi-container">
    {%- if section.settings.title != blank -%}
      <h2 class="es-twi-heading">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <ul class="es-twi-grid">
      {%- for block in section.blocks -%}
        <li class="es-twi-item" {{ block.shopify_attributes }}>
          
          <!-- Icon -->
          {%- assign bg_type = block.settings.icon_background_type | default: 'circle' -%}
          <div
            class="es-twi-icon-badge es-twi-icon-badge--{{ bg_type }}"
            style="
              {% if block.settings.icon_background != blank %}background-color: {{ block.settings.icon_background }};{% endif %}
              {% if block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% endif %}
            "
          >
            {%- if block.settings.custom_icon != blank -%}
              <img
                src="{{ block.settings.custom_icon | image_url: width: 120 }}"
                width="{{ block.settings.custom_icon.width }}"
                height="{{ block.settings.custom_icon.height }}"
                alt="{{ block.settings.title | default: 'Icon' | escape }}"
                class="es-twi-custom-icon"
                loading="lazy"
              >
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'picto-truck' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                {%- when 'picto-shield' or 'picto-lock' or 'picto-secure-profile' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {%- when 'picto-customer-support' or 'picto-chat' or 'picto-phone' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                {%- when 'picto-return' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                {%- when 'picto-star' or 'picto-award-gift' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                {%- when 'picto-leaf' or 'picto-recycle' or 'picto-earth' -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>

          <!-- Text -->
          <div>
            {%- if block.settings.title != blank -%}
              <h3 class="es-twi-title {{ section.settings.heading_tag | default: 'h5' }}">
                {{ block.settings.title | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="es-twi-content">
                {{ block.settings.content }}
              </div>
            {%- endif -%}
          </div>

        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Text with icons",
  "tag": "section",
  "class": "shopify-section--text-with-icons",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width layout",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack vertically on mobile",
      "default": false,
      "info": "If unchecked, icons scroll smoothly on mobile."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Item heading size",
      "options": [
        { "value": "h4", "label": "Large (H4)" },
        { "value": "h5", "label": "Medium (H5)" },
        { "value": "h6", "label": "Small (H6)" }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "icon_spacing",
      "label": "Icon column gap",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#f8fafc"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Value proposition",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Predefined icon",
          "options": [
            { "value": "picto-truck", "label": "Free Express Shipping" },
            { "value": "picto-shield", "label": "Secure Encrypted Checkout" },
            { "value": "picto-customer-support", "label": "24/7 Dedicated Support" },
            { "value": "picto-return", "label": "30-Day Hassle-Free Returns" },
            { "value": "picto-leaf", "label": "100% Sustainable & Eco-Friendly" },
            { "value": "picto-star", "label": "Top Rated Quality" }
          ],
          "default": "picto-truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Or upload custom icon"
        },
        {
          "type": "select",
          "id": "icon_background_type",
          "label": "Icon badge shape",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Rounded Square" }
          ],
          "default": "circle"
        },
        {
          "type": "color",
          "id": "icon_background",
          "label": "Badge background color"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Free Worldwide Shipping"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Description",
          "default": "<p>Complimentary tracked delivery and free returns on all orders over $75.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text with icons",
      "blocks": [
        { "type": "item", "settings": { "icon": "picto-truck", "title": "Free Global Shipping", "content": "<p>Fast express delivery on all orders over $75.</p>" } },
        { "type": "item", "settings": { "icon": "picto-shield", "title": "Secure Checkout", "content": "<p>Bank-grade 256-bit SSL encrypted transactions.</p>" } },
        { "type": "item", "settings": { "icon": "picto-return", "title": "30-Day Guarantee", "content": "<p>Not completely in love? Return hassle-free.</p>" } }
      ]
    }
  ]
}
{% endschema %}
