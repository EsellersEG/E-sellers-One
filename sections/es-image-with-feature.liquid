{%- comment -%}
  E-sellers Image With Feature - E-sellers One (v5.0.0)

  Sticky image beside a stacked list of icon + title + text feature rows.
  Common for "why choose us" / spec-highlight panels next to a hero product
  shot. The image can optionally stick in view while the feature list scrolls.
{%- endcomment -%}

{%- liquid
  assign es_iwf_features = section.blocks | where: 'type', 'feature'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  #shopify-section-{{ section.id }} .es-iwf {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--es-space-7);
    align-items: start;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .es-iwf { grid-template-columns: 1fr 1fr; }
  }

  #shopify-section-{{ section.id }} .es-iwf__media {
    aspect-ratio: {{ section.settings.image_ratio | default: '4/5' }};
    border-radius: var(--es-radius-lg);
    overflow: hidden;
    position: relative;
  }
  {%- if section.settings.enable_sticky -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .es-iwf__media { position: sticky; top: var(--es-space-6); }
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} .es-iwf__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  #shopify-section-{{ section.id }} .es-iwf__list { display: flex; flex-direction: column; gap: var(--es-space-6); }
  #shopify-section-{{ section.id }} .es-iwf__row { display: flex; gap: var(--es-space-3); }
  #shopify-section-{{ section.id }} .es-iwf__icon { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .es-iwf__icon svg { width: 24px; height: 24px; }
  #shopify-section-{{ section.id }} .es-iwf__title { margin: 0 0 var(--es-space-1); font-size: var(--es-text-lg); }
  #shopify-section-{{ section.id }} .es-iwf__text { color: var(--es-fg-muted); }
{%- endstyle -%}

<div class="page-width">
  <div class="es-iwf">
    <div class="es-iwf__media">
      {%- if section.settings.image != blank -%}
        {%- assign es_iwf_alt = section.settings.heading | escape -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: es_iwf_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
      {%- endif -%}
    </div>

    <div>
      {%- render 'es-section-heading',
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          description: section.settings.description,
          highlight_style: section.settings.highlight_style -%}

      <div class="es-iwf__list">
        {%- for block in es_iwf_features -%}
          <div class="es-iwf__row" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="es-iwf__icon" aria-hidden="true">{%- render 'icon', name: block.settings.icon -%}</span>
            {%- endif -%}
            <div>
              {%- if block.settings.title != blank -%}<h3 class="es-iwf__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="es-iwf__text">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "E-sellers Image With Feature",
  "tag": "section",
  "class": "shopify-section--es-image-with-feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "16/9", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    { "type": "checkbox", "id": "enable_sticky", "label": "Stick image while scrolling", "default": true },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to perform" },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Heading emphasis style",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "circle", "label": "Circle" },
        { "value": "color", "label": "Color" }
      ],
      "default": "underline"
    },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "header",
      "content": "Spacing"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this feature.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "E-sellers Image With Feature",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
