{%- comment -%}
  Main Customer Addresses Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
  }

  .es-addresses-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .es-addresses-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .es-addresses-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
  }

  .es-addresses-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .es-addresses-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .es-btn-add-address {
    padding: 10px 20px;
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .es-btn-add-address:hover {
    background-color: #1e293b;
  }

  .es-link-return {
    font-size: 0.9rem;
    font-weight: 600;
    color: #475569;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Address Form Drawer / Box */
  .es-address-form-box {
    display: none;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 36px;
  }

  .es-address-form-box.is-open {
    display: block;
  }

  .es-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media screen and (max-width: 640px) {
    .es-form-grid {
      grid-template-columns: 1fr;
    }
  }

  .es-form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .es-form-field--full {
    grid-column: 1 / -1;
  }

  .es-form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
  }

  .es-form-input, .es-form-select {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #0f172a;
    background: #ffffff;
    outline: none;
    box-sizing: border-box;
  }

  .es-form-input:focus, .es-form-select:focus {
    border-color: #0f172a;
  }

  .es-form-buttons {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

  /* Address Cards Grid */
  .es-addresses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .es-address-card {
    padding: 24px;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .es-address-card--default {
    border-color: #0f172a;
  }

  .es-default-pill {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .es-address-card__content {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
  }

  .es-address-card__actions {
    display: flex;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
  }

  .es-address-card__btn-edit, .es-address-card__btn-delete {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .es-address-card__btn-edit { color: #0f172a; }
  .es-address-card__btn-delete { color: #ef4444; }
{%- endstyle -%}

<div class="page-width">
  <div class="es-addresses-header">
    <div class="es-addresses-title-wrap">
      <h1 class="es-addresses-title">{{ 'customer.addresses.title' | t | default: 'Saved Addresses' }}</h1>
      <span class="es-addresses-count">{{ customer.addresses_count }}</span>
    </div>

    <div class="es-addresses-actions">
      <a href="{{ routes.account_url }}" class="es-link-return">
        &larr; {{ 'customer.account.return' | t | default: 'Back to account' }}
      </a>
      <button type="button" class="es-btn-add-address" onclick="document.getElementById('AddAddressForm').classList.toggle('is-open')">
        {{ 'customer.addresses.add_new' | t | default: '+ Add new address' }}
      </button>
    </div>
  </div>

  <!-- Add New Address Form -->
  <div id="AddAddressForm" class="es-address-form-box">
    <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 20px 0; color: #0f172a;">
      {{ 'customer.addresses.add_new' | t | default: 'Add a new address' }}
    </h2>

    {%- form 'customer_address', customer.new_address, class: 'es-form-grid' -%}
      <div class="es-form-field">
        <label class="es-form-label" for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t | default: 'First name' }}</label>
        <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" class="es-form-input" autocomplete="given-name">
      </div>

      <div class="es-form-field">
        <label class="es-form-label" for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t | default: 'Last name' }}</label>
        <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" class="es-form-input" autocomplete="family-name">
      </div>

      <div class="es-form-field es-form-field--full">
        <label class="es-form-label" for="AddressCompanyNew">{{ 'customer.addresses.company' | t | default: 'Company' }}</label>
        <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" class="es-form-input" autocomplete="organization">
      </div>

      <div class="es-form-field es-form-field--full">
        <label class="es-form-label" for="AddressAddress1New">{{ 'customer.addresses.address1' | t | default: 'Address line 1' }}</label>
        <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" class="es-form-input" autocomplete="address-line1" required>
      </div>

      <div class="es-form-field es-form-field--full">
        <label class="es-form-label" for="AddressAddress2New">{{ 'customer.addresses.address2' | t | default: 'Apartment, suite, etc.' }}</label>
        <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" class="es-form-input" autocomplete="address-line2">
      </div>

      <div class="es-form-field">
        <label class="es-form-label" for="AddressCityNew">{{ 'customer.addresses.city' | t | default: 'City' }}</label>
        <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" class="es-form-input" autocomplete="address-level2" required>
      </div>

      <div class="es-form-field">
        <label class="es-form-label" for="AddressCountryNew">{{ 'customer.addresses.country' | t | default: 'Country' }}</label>
        <select id="AddressCountryNew" name="address[country]" class="es-form-select" autocomplete="country">
          {{ all_country_option_tags }}
        </select>
      </div>

      <div class="es-form-field">
        <label class="es-form-label" for="AddressZipNew">{{ 'customer.addresses.zip' | t | default: 'Postal / ZIP code' }}</label>
        <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" class="es-form-input" autocomplete="postal-code" required>
      </div>

      <div class="es-form-field">
        <label class="es-form-label" for="AddressPhoneNew">{{ 'customer.addresses.phone' | t | default: 'Phone' }}</label>
        <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" class="es-form-input" autocomplete="tel">
      </div>

      <div class="es-form-field es-form-field--full" style="flex-direction: row; align-items: center; gap: 8px; margin-top: 8px;">
        {{ form.set_as_default_checkbox }}
        <label for="address_default_address_new" class="es-form-label" style="margin: 0; cursor: pointer;">
          {{ 'customer.addresses.set_default' | t | default: 'Set as default address' }}
        </label>
      </div>

      <div class="es-form-field es-form-field--full es-form-buttons">
        <button type="submit" class="es-btn-add-address">{{ 'customer.addresses.add' | t | default: 'Add address' }}</button>
        <button type="button" style="padding: 10px 18px; border: 1px solid #cbd5e1; background: transparent; border-radius: 8px; font-weight: 600; cursor: pointer;" onclick="document.getElementById('AddAddressForm').classList.remove('is-open')">
          {{ 'customer.addresses.cancel' | t | default: 'Cancel' }}
        </button>
      </div>
    {%- endform -%}
  </div>

  {%- paginate customer.addresses by 16 -%}
    {%- if customer.addresses_count == 0 -%}
      <div style="text-align: center; padding: 60px 20px; background: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0;">
        <p style="font-size: 1.15rem; font-weight: 600; color: #0f172a; margin: 0 0 8px 0;">{{ 'customer.addresses.no_addresses' | t | default: 'No saved addresses yet.' }}</p>
        <button type="button" class="es-btn-add-address" onclick="document.getElementById('AddAddressForm').classList.add('is-open')">
          {{ 'customer.addresses.add_new' | t | default: 'Add your first address' }}
        </button>
      </div>
    {%- else -%}
      <div class="es-addresses-grid">
        {%- for address in customer.addresses -%}
          <div class="es-address-card {% if address == customer.default_address %}es-address-card--default{% endif %}">
            {%- if address == customer.default_address -%}
              <span class="es-default-pill">Default</span>
            {%- endif -%}

            <div class="es-address-card__content">
              <strong style="display: block; font-size: 1.05rem; color: #0f172a; margin-bottom: 6px;">
                {{ address.name }}
              </strong>
              {{ address | format_address }}
            </div>

            <div class="es-address-card__actions">
              <button type="button" class="es-address-card__btn-edit" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.toggle('is-open')">
                {{ 'customer.addresses.edit' | t | default: 'Edit' }}
              </button>

              <form method="post" action="{{ address.url }}" onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t | default: 'Are you sure you want to delete this address?' | escape }}');" style="display: inline;">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="es-address-card__btn-delete">
                  {{ 'customer.addresses.delete' | t | default: 'Delete' }}
                </button>
              </form>
            </div>

            <!-- Edit Address Inline Form -->
            <div id="EditAddress_{{ address.id }}" class="es-address-form-box" style="margin-top: 16px; padding: 20px;">
              {%- form 'customer_address', address, class: 'es-form-grid' -%}
                <div class="es-form-field">
                  <label class="es-form-label">{{ 'customer.addresses.first_name' | t | default: 'First name' }}</label>
                  <input type="text" name="address[first_name]" value="{{ form.first_name }}" class="es-form-input">
                </div>
                <div class="es-form-field">
                  <label class="es-form-label">{{ 'customer.addresses.last_name' | t | default: 'Last name' }}</label>
                  <input type="text" name="address[last_name]" value="{{ form.last_name }}" class="es-form-input">
                </div>
                <div class="es-form-field es-form-field--full">
                  <label class="es-form-label">{{ 'customer.addresses.address1' | t | default: 'Address' }}</label>
                  <input type="text" name="address[address1]" value="{{ form.address1 }}" class="es-form-input">
                </div>
                <div class="es-form-field">
                  <label class="es-form-label">{{ 'customer.addresses.city' | t | default: 'City' }}</label>
                  <input type="text" name="address[city]" value="{{ form.city }}" class="es-form-input">
                </div>
                <div class="es-form-field">
                  <label class="es-form-label">{{ 'customer.addresses.zip' | t | default: 'Zip' }}</label>
                  <input type="text" name="address[zip]" value="{{ form.zip }}" class="es-form-input">
                </div>
                <div class="es-form-field es-form-field--full es-form-buttons">
                  <button type="submit" class="es-btn-add-address">{{ 'customer.addresses.update' | t | default: 'Update' }}</button>
                  <button type="button" style="padding: 8px 14px; border: 1px solid #cbd5e1; background: transparent; border-radius: 6px; font-weight: 600; cursor: pointer;" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.remove('is-open')">
                    {{ 'customer.addresses.cancel' | t | default: 'Cancel' }}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="margin-top: 36px;">
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Customer addresses",
  "tag": "section",
  "class": "shopify-section--main-customers-addresses",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
