      "label": "Fallback Logo URL",
      "default": "https://lh3.googleusercontent.com/aida/AEtjO1XNNPRURg6MR48HImWpxsI-9cjqNEsjGxeMnZXbXF2fqIvIuZVFGBhr7I9jJbHvnrp5uA5cz5r9jmTgCzACZIz1_av9v4MAjuzA9IQj1CfsChgxCdKRgk5G-f0EjDuOEJQXHMpVQzaJb8Iqw3hmRI1K_tCi6OQL0_IDh2AeeMBx6cQroO8vk7cF7iIenOqUrVpXOHxyY0IvvCjurFokAg0dTNZgYQ2ujfhMzD9nN-3anKFveXQTmWDYjg"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Brand Name",
      "default": "milk_shake"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search haircare..."
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist Page URL"
    },
    {
      "type": "header",
      "content": "Layout and Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Standard Container (1440px)"
        },
        {
          "value": "narrow",
          "label": "Narrow Container (1000px)"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Colors and Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
