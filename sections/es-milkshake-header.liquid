{% render 'es-section-style', section: section %}
<header class="bg-surface-cream/90 backdrop-blur-xl sticky top-0 z-40 shadow-[0_1px_8px_rgba(0,0,0,0.04)] section-{{ section.id }}-settings">
  <div class="h-20 max-w-[1440px] mx-auto px-margin flex items-center justify-between gap-space-lg">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-space-lg">
      <a class="flex items-center gap-space-sm" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            class="h-8 w-auto object-contain"
            src="{{ section.settings.logo | image_url: width: 200 }}"
            width="80"
            height="32"
            loading="eager"
          />
        {%- elsif section.settings.logo_image_url != blank -%}
          <img
            alt="{{ shop.name }}"
            class="h-8 w-auto object-contain"
            src="{{ section.settings.logo_image_url }}"
            width="80"
            height="32"
            loading="eager"
          />
        {%- endif -%}
        <span class="font-headline-md text-headline-md tracking-tight uppercase text-primary">
          {{ section.settings.logo_text | default: 'milk_shake' }}
        </span>
      </a>
    </div>

    <!-- Navigation Menu -->
    <nav class="hidden xl:flex items-center gap-space-md font-label-md text-label-md tracking-wider uppercase">
      {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <a
            class="{% if link.active %}transition-colors bg-primary-container text-on-primary-container rounded-full px-space-md py-space-xs font-semibold{% else %}text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors{% endif %}"
            href="{{ link.url }}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors" href="#bestsellers">Best Sellers</a>
        <a class="text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors" href="#bundles">Hair Routines</a>
        <a class="text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors" href="#hair-concerns">Hair Type</a>
        <a class="text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors" href="#collections">Collections</a>
        <a aria-current="page" class="transition-colors bg-primary-container text-on-primary-container rounded-full px-space-md py-space-xs font-semibold" href="{{ routes.all_products_collection_url }}">All Products</a>
        <a class="text-on-surface-variant hover:text-on-surface px-space-sm py-space-xs transition-colors" href="#footer">About Us</a>
      {%- endif -%}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-space-sm md:gap-space-md">
      <!-- Search Form -->
      <form action="{{ routes.search_url }}" method="get" role="search" class="relative hidden md:block w-48 lg:w-60">
        <input
          class="w-full bg-surface-container-lowest text-on-surface rounded-full pl-space-md pr-space-xl py-space-xs font-body-sm text-body-sm focus:outline-none border border-transparent focus:border-outline-variant transition-all"
          placeholder="{{ section.settings.search_placeholder | default: 'Search haircare...' }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
        />
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center p-0 bg-transparent border-0 cursor-pointer" aria-label="Search">
          <span class="material-symbols-outlined text-[18px]">search</span>
        </button>
      </form>

      <!-- Mobile Search Button -->
      <a href="{{ routes.search_url }}" class="md:hidden w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" aria-label="Search">
        <span class="material-symbols-outlined text-[20px]">search</span>
      </a>

      <!-- Wishlist Link -->
      <a class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" href="{{ section.settings.wishlist_url | default: '#wishlist' }}" aria-label="Wishlist">
        <span class="material-symbols-outlined text-[20px]">favorite</span>
      </a>

      <!-- Cart Button with Dynamic Badge -->
      <a class="relative w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" href="{{ routes.cart_url }}" aria-label="Cart">
        <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
        {%- if cart.item_count > 0 -%}
          <span class="absolute -top-1 -right-1 bg-badge-sale text-on-error font-label-sm text-label-sm w-4 h-4 rounded-full flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {%- else -%}
          <span class="absolute -top-1 -right-1 bg-badge-sale text-on-error font-label-sm text-label-sm w-4 h-4 rounded-full flex items-center justify-center">
            0
          </span>
        {%- endif -%}
      </a>

      <!-- Account Button -->
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="w-8 h-8 rounded-full bg-primary flex items-center justify-center hover:opacity-90 transition-opacity" aria-label="Account">
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Milkshake Header",
  "tag": "section",
  "class": "es-milkshake-header-wrapper",
  "settings": [
    {
