{% render 'es-section-style', section: section %}

<style>
  #Header-{{ section.id }} {
    --hdr-bg: {{ section.settings.header_bg | default: '#fcf9f4' }};
    --hdr-bg-opacity: {{ section.settings.header_bg_opacity | default: 90 }}%;
    --hdr-h-desktop: {{ section.settings.header_height_desktop | default: 80 }}px;
    --hdr-h-mobile: {{ section.settings.header_height_mobile | default: 64 }}px;
    --hdr-logo-w-desktop: {{ section.settings.logo_width_desktop | default: 80 }}px;
    --hdr-logo-w-mobile: {{ section.settings.logo_width_mobile | default: 64 }}px;
    --hdr-logo-color: {{ section.settings.logo_color | default: '#1f1d1b' }};
    --hdr-nav-text: {{ section.settings.nav_text_color | default: '#53433e' }};
    --hdr-nav-hover: {{ section.settings.nav_hover_color | default: '#1f1d1b' }};
    --hdr-nav-active-bg: {{ section.settings.nav_active_bg | default: '#f4ede4' }};
    --hdr-nav-active-text: {{ section.settings.nav_active_text | default: '#2d1600' }};
    --hdr-cart-badge-bg: {{ section.settings.cart_badge_bg | default: '#ba1a1a' }};
    --hdr-cart-badge-text: {{ section.settings.cart_badge_text | default: '#ffffff' }};
    --hdr-search-width: {{ section.settings.search_width | default: 240 }}px;
    background-color: color-mix(in srgb, var(--hdr-bg) var(--hdr-bg-opacity), transparent);
    {% if section.settings.show_bottom_border %}
      border-bottom: 1px solid {{ section.settings.bottom_border_color | default: 'rgba(0,0,0,0.06)' }};
    {% else %}
      border-bottom: none;
    {% endif %}
  }

  #Header-{{ section.id }} .hdr-inner {
    height: var(--hdr-h-desktop);
  }
  @media (max-width: 768px) {
    #Header-{{ section.id }} .hdr-inner {
      height: var(--hdr-h-mobile);
    }
  }

  #Header-{{ section.id }} .hdr-logo-img {
    width: var(--hdr-logo-w-desktop);
    height: auto;
  }
  @media (max-width: 768px) {
    #Header-{{ section.id }} .hdr-logo-img {
      width: var(--hdr-logo-w-mobile);
    }
  }

  #Header-{{ section.id }} nav a {
    color: var(--hdr-nav-text);
  }
  #Header-{{ section.id }} nav a:hover {
    color: var(--hdr-nav-hover);
  }

  {% if section.settings.nav_active_style == 'pill' %}
    #Header-{{ section.id }} nav a.is-active {
      background-color: var(--hdr-nav-active-bg);
      color: var(--hdr-nav-active-text);
      border-radius: 9999px;
      padding: 0.35rem 1rem;
      font-weight: 600;
    }
  {% elsif section.settings.nav_active_style == 'underline' %}
    #Header-{{ section.id }} nav a.is-active {
      color: var(--hdr-nav-active-text);
      font-weight: 600;
      border-bottom: 2px solid var(--hdr-nav-hover);
      padding-bottom: 4px;
    }
  {% else %}
    #Header-{{ section.id }} nav a.is-active {
      color: var(--hdr-nav-active-text);
      font-weight: 700;
    }
  {% endif %}
</style>

<header id="Header-{{ section.id }}" class="{% if section.settings.enable_sticky %}sticky top-0 z-40{% endif %} {% if section.settings.enable_blur %}backdrop-blur-xl{% endif %} {% if section.settings.shadow_style == 'subtle' %}shadow-[0_1px_8px_rgba(0,0,0,0.04)]{% elsif section.settings.shadow_style == 'medium' %}shadow-md{% elsif section.settings.shadow_style == 'floating' %}shadow-lg rounded-b-2xl{% endif %} section-{{ section.id }}-settings transition-all">
  <div class="hdr-inner {% if section.settings.container_width == 'full' %}w-full px-4 sm:px-6 lg:px-8{% elsif section.settings.container_width == 'narrow' %}max-w-[1000px] mx-auto px-margin{% else %}max-w-[1440px] mx-auto px-margin{% endif %} flex items-center justify-between gap-space-lg">
    
    <!-- Brand / Logo -->
    <div class="flex items-center gap-space-lg shrink-0">
      <a class="flex items-center gap-space-sm" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            class="hdr-logo-img object-contain"
            src="{{ section.settings.logo | image_url: width: 400 }}"
            width="80"
            height="32"
            loading="eager"
          />
        {%- elsif section.settings.logo_image_url != blank -%}
          <img
            alt="{{ shop.name }}"
            class="hdr-logo-img object-contain"
            src="{{ section.settings.logo_image_url }}"
            width="80"
            height="32"
            loading="eager"
          />
        {%- endif -%}
        {% if section.settings.show_logo_text %}
          <span class="font-headline-md {{ section.settings.logo_font_size | default: 'text-headline-md' }} tracking-tight uppercase text-[var(--hdr-logo-color)]">
            {{ section.settings.logo_text | default: 'milk_shake' }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Navigation Menu -->
    <nav class="hidden xl:flex items-center gap-space-md font-label-md {% if section.settings.nav_font_size == 'xs' %}text-xs{% elsif section.settings.nav_font_size == 'base' %}text-sm{% else %}text-label-md{% endif %} tracking-wider {% if section.settings.nav_text_transform == 'uppercase' %}uppercase{% elsif section.settings.nav_text_transform == 'none' %}normal-case{% endif %} {% if section.settings.nav_alignment == 'left' %}mr-auto ml-space-lg{% elsif section.settings.nav_alignment == 'right' %}ml-auto mr-space-lg{% else %}mx-auto{% endif %}">
      {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <a
            class="{% if link.active %}is-active transition-colors px-space-md py-space-xs{% else %}px-space-sm py-space-xs transition-colors{% endif %}"
            href="{{ link.url }}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="px-space-sm py-space-xs transition-colors" href="#bestsellers">Best Sellers</a>
        <a class="px-space-sm py-space-xs transition-colors" href="#bundles">Hair Routines</a>
        <a class="px-space-sm py-space-xs transition-colors" href="#hair-concerns">Hair Type</a>
        <a class="px-space-sm py-space-xs transition-colors" href="#collections">Collections</a>
        <a aria-current="page" class="is-active px-space-md py-space-xs transition-colors" href="{{ routes.all_products_collection_url }}">All Products</a>
        <a class="px-space-sm py-space-xs transition-colors" href="#footer">About Us</a>
      {%- endif -%}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-space-sm md:gap-space-md shrink-0 ml-auto xl:ml-0">
      <!-- Search Form -->
      {% if section.settings.show_search %}
        <form action="{{ routes.search_url }}" method="get" role="search" class="relative hidden md:block w-[var(--hdr-search-width)]">
          <input
            class="w-full bg-surface-container-lowest text-on-surface rounded-full pl-space-md pr-space-xl py-space-xs font-body-sm text-body-sm focus:outline-none border border-transparent focus:border-outline-variant transition-all"
            placeholder="{{ section.settings.search_placeholder | default: 'Search haircare...' }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
          />
          <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center p-0 bg-transparent border-0 cursor-pointer" aria-label="Search">
            <span class="material-symbols-outlined text-[18px]">search</span>
          </button>
        </form>

        <!-- Mobile Search Button -->
        <a href="{{ routes.search_url }}" class="md:hidden w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" aria-label="Search">
          <span class="material-symbols-outlined text-[20px]">search</span>
        </a>
      {% endif %}

      <!-- Wishlist Link -->
      {% if section.settings.show_wishlist %}
        <a class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" href="{{ section.settings.wishlist_url | default: '#wishlist' }}" aria-label="Wishlist">
          <span class="material-symbols-outlined text-[20px]">favorite</span>
        </a>
      {% endif %}

      <!-- Cart Button with Dynamic Badge -->
      {% if section.settings.show_cart %}
        <a class="relative w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors" href="{{ routes.cart_url }}" aria-label="Cart">
          <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
          <span class="absolute -top-1 -right-1 bg-[var(--hdr-cart-badge-bg)] text-[var(--hdr-cart-badge-text)] font-label-sm w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold leading-none">
            {{ cart.item_count | default: 0 }}
          </span>
        </a>
      {% endif %}

      <!-- Account Button -->
      {% if section.settings.show_account %}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="w-8 h-8 rounded-full {% if section.settings.account_style == 'neutral_circle' %}bg-surface-container text-on-surface hover:bg-surface-container-high{% elsif section.settings.account_style == 'plain_icon' %}bg-transparent text-on-surface hover:text-primary{% else %}bg-primary text-on-primary hover:opacity-90{% endif %} flex items-center justify-center transition-all" aria-label="Account">
          <span class="material-symbols-outlined text-[18px]">person</span>
        </a>
      {% endif %}
    </div>

  </div>
</header>

