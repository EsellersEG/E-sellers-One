{%- comment -%}
  E-sellers Collection Icons / Brand Grid - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_background | default: '#ffffff' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
  }

  .es-ci-container {
    width: {{ section.settings.container_width | default: 90 }}%;
    max-width: 1440px;
    margin-inline: auto;
  }

  /* Desktop Grid */
  .es-ci-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 5 }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap | default: 12 }}px;
    align-items: stretch;
  }

  .es-ci-card {
    display: block;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.card_background | default: '#ffffff' }};
    border: {{ section.settings.card_border_width | default: 1 }}px solid {{ section.settings.card_border_color | default: '#e2e8f0' }};
    border-radius: {{ section.settings.card_border_radius | default: 10 }}px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .es-ci-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
  }

  .es-ci-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--es-card-aspect-ratio, 16 / 9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .es-ci-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .es-ci-card:hover .es-ci-card__image {
    transform: scale(1.04);
  }

  .es-ci-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    color: #94a3b8;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .es-ci-card__label {
    padding: 8px 12px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
    border-top: 1px solid #f1f5f9;
  }

  /* Hide mobile paired layout on desktop */
  .es-ci-mobile-paired {
    display: none;
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .es-ci-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 4 }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top | default: 28 }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 28 }}px;
    }

    .es-ci-container {
      width: {{ section.settings.mobile_container_width | default: 95 }}%;
    }

    {% if section.settings.enable_paired_mobile %}
      .es-ci-grid {
        display: none;
      }
      .es-ci-mobile-paired {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: {{ section.settings.mobile_card_gap | default: 8 }}px;
      }
    {% else %}
      .es-ci-grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
        gap: {{ section.settings.mobile_card_gap | default: 8 }}px;
      }
    {% endif %}
  }
{%- endstyle -%}

<div class="es-collection-icons-section">
  <div class="es-ci-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      {% render 'section-header',
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_color: section.settings.heading_color,
        content: section.settings.content,
        link_text: section.settings.link_text,
        link_url: section.settings.link_url,
        alignment: section.settings.header_alignment
      %}
    {%- endif -%}

    {%- comment -%} Standard Grid (Desktop & Regular Mobile) {%- endcomment -%}
    <div class="es-ci-grid" style="--es-card-aspect-ratio: {{ section.settings.aspect_ratio | default: '16 / 9' }};">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="es-ci-card"
          {{ block.shopify_attributes }}
        >
          <div class="es-ci-card__media">
            {%- if block.settings.image != blank -%}
              {%- assign es_tagarg_1 = block.settings.image.alt | default: block.settings.title | escape -%}{{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                class: 'es-ci-card__image',
                alt: es_tagarg_1}}
            {%- else -%}
              <div class="es-ci-card__placeholder">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span>{{ block.settings.title | default: 'Add Icon' }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank and section.settings.show_labels -%}
            <div class="es-ci-card__label">
              {{ block.settings.title | escape }}
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%} Paired Mobile Grid Layout (if enabled) {%- endcomment -%}
    {%- if section.settings.enable_paired_mobile -%}
      {%- assign total_blocks = section.blocks.size -%}
      {%- assign half = total_blocks | divided_by: 2 -%}
      {%- assign half_minus_one = half | minus: 1 -%}

      <div class="es-ci-mobile-paired" style="--es-card-aspect-ratio: {{ section.settings.aspect_ratio | default: '16 / 9' }};">
        {%- for j in (0..half_minus_one) -%}
          {%- assign row1_idx = j -%}
          {%- assign row2_idx = j | plus: half -%}

          {%- if row1_idx < total_blocks -%}
            {%- assign block1 = section.blocks[row1_idx] -%}
            {%- assign b1_alt = block1.settings.image.alt | default: 'Icon' | escape -%}
            <a href="{{ block1.settings.link | default: '#' }}" class="es-ci-card" {{ block1.shopify_attributes }}>
              <div class="es-ci-card__media">
                {%- if block1.settings.image != blank -%}
                  {{ block1.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'es-ci-card__image', alt: b1_alt }}
                {%- else -%}
                  <div class="es-ci-card__placeholder"><span>{{ block1.settings.title | default: 'Icon' }}</span></div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}

          {%- if row2_idx < total_blocks -%}
            {%- assign block2 = section.blocks[row2_idx] -%}
            {%- assign b2_alt = block2.settings.image.alt | default: 'Icon' | escape -%}
            <a href="{{ block2.settings.link | default: '#' }}" class="es-ci-card" {{ block2.shopify_attributes }}>
              <div class="es-ci-card__media">
                {%- if block2.settings.image != blank -%}
                  {{ block2.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'es-ci-card__image', alt: b2_alt }}
                {%- else -%}
                  <div class="es-ci-card__placeholder"><span>{{ block2.settings.title | default: 'Icon' }}</span></div>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ES Collection Icons",
  "class": "shopify-section--es-collection-icons",
  "tag": "section",
  "disabled_on": {
    "groups": [
