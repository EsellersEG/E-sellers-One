{%- comment -%}
  Renders an SVG icon.
  Accepts:
  - name: {String} The name of the icon (e.g. 'cart', 'search', 'account', 'close', etc.)
  - class: {String} Optional custom CSS classes

  Usage:
  {% render 'icon', name: 'cart', class: 'icon-cart' %}
{%- endcomment -%}

{%- case name -%}
  {%- when 'cart' -%}
    <svg class="{{ class | default: 'icon icon-cart' }}" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>

  {%- when 'search' -%}
