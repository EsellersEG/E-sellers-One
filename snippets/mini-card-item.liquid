{%- comment -%}
  Travel Mini Card Item Snippet
  Accepts: block, section
{%- endcomment -%}

{%- liquid
  assign b = block.settings
  assign mini_image = b.image
  assign image_url = b.fallback_image_url
  if mini_image != blank
    assign image_url = mini_image | image_url: width: 600
  endif

  assign clamp_class = 'line-clamp-' | append: section.settings.title_max_lines
-%}

<div class="es-card-luxury flex flex-col h-full bg-[var(--card-bg)] text-[var(--card-text)] border border-[var(--card-border)] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all">
  <!-- Top Visual -->
  <div class="relative overflow-hidden {{ section.settings.image_ratio }}">
    {%- if image_url != blank -%}
      <img 
        src="{{ image_url }}" 
        alt="{{ b.title | escape }}" 
        loading="lazy" 
        width="400"
        height="400"
        class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 {% if b.is_sold_out %}grayscale-[30%]{% endif %}"
      >
    {%- else -%}
      <div class="w-full h-full bg-[#EFE8DF] flex items-center justify-center text-[#A89F91]">
        <span class="material-symbols-outlined text-4xl">flight</span>
      </div>
    {%- endif -%}

    {%- if b.badge != blank -%}
      <div class="absolute top-3 left-3 z-10">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase {% if b.is_sold_out %}bg-[#2D2825] text-white{% else %}bg-[var(--badge-bg)] text-[var(--badge-text)]{% endif %} shadow-sm">
          {{ b.badge }}
        </span>
      </div>
    {%- endif -%}

    {%- if b.is_sold_out -%}
      <div class="absolute inset-0 bg-black/20 backdrop-blur-[1px] flex items-center justify-center pointer-events-none">
        <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-white/90 text-[#2D2825] shadow">
          Sold Out
        </span>
      </div>
    {%- endif -%}
  </div>

  <!-- Content Body -->
  <div class="p-5 flex flex-col flex-grow">
    <h3 class="text-base font-serif font-medium text-[var(--card-text)] mb-1.5 {{ clamp_class }}">
      {{ b.title }}
    </h3>

    {%- if b.description != blank -%}
      <p class="text-xs text-[var(--card-text)] opacity-70 mb-4 line-clamp-2 font-light leading-relaxed">
        {{ b.description }}
      </p>
    {%- endif -%}

    <!-- Price and Action Trigger -->
    <div class="mt-auto pt-3 border-t border-[var(--card-border)] flex items-center justify-between gap-2">
      <div class="text-base font-serif font-bold text-[var(--card-text)]">
        {{ b.price }}
      </div>

      {%- if b.is_sold_out -%}
        <button 
          type="button" 
          class="inline-flex items-center px-3.5 py-2 rounded-full text-xs font-medium border border-[#2D2825] text-[#2D2825] hover:bg-[#2D2825] hover:text-white transition-colors"
          data-notify-trigger
          data-notify-modal-trigger
          data-product-title="{{ b.title | escape }}"
        >
          <span class="material-symbols-outlined text-sm mr-1">notifications</span>
          <span>Notify Me</span>
        </button>
      {%- elsif b.product != blank and b.product.available -%}
        <button 
          type="button" 
          class="es-quick-add-btn inline-flex items-center px-4 py-2 rounded-full text-xs font-medium transition-all"
          style="background-color: var(--btn-bg); color: var(--btn-text);"
          data-product-id="{{ b.product.selected_or_first_available_variant.id }}"
        >
          <span class="material-symbols-outlined text-sm mr-1">add_shopping_cart</span>
          <span>Add</span>
        </button>
      {%- else -%}
        <button 
          type="button" 
          class="es-quick-add-btn inline-flex items-center px-4 py-2 rounded-full text-xs font-medium transition-all hover:opacity-90"
          style="background-color: var(--btn-bg); color: var(--btn-text);"
          data-product-id="dummy-mini-{{ block.id }}"
        >
          <span class="material-symbols-outlined text-sm mr-1">add_shopping_cart</span>
          <span>Add</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
