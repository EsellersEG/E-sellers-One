{%- comment -%}
  Product Card Snippet - E-sellers Professional (v4.9.0)
  Accepts:
  - card_product: {Object} Shopify Product Liquid object
  - show_vendor: {Boolean}
  - show_rating: {Boolean}
  - show_quick_add: {Boolean}
  - section_id: {String} Section ID for unique form scoping

  Usage:
  {% render 'card-product', card_product: product, show_vendor: true, show_quick_add: true %}
{%- endcomment -%}

{%- liquid
  assign ratio = 1
  if settings.card_image_ratio == 'portrait'
    assign ratio = 0.75
  elsif settings.card_image_ratio == 'landscape'
    assign ratio = 1.33
  elsif settings.card_image_ratio == 'square'
    assign ratio = 1
  elsif settings.card_image_ratio == 'natural' and card_product.featured_media
    assign ratio = card_product.featured_media.aspect_ratio | default: 1
  endif
-%}

<div class="card-product group" style="position: relative; display: flex; flex-direction: column; height: 100%;">
  <!-- Product Media Container -->
  <div class="card-product__media media" style="padding-bottom: {{ 1 | divided_by: ratio | times: 100 }}%; position: relative; overflow: hidden; background: #f4f4f5; border-radius: var(--card-radius, 12px);">
    <a href="{{ card_product.url }}" class="card-product__link" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_media -%}
        <img
          srcset="
            {{ card_product.featured_media | image_url: width: 360 }} 360w,
            {{ card_product.featured_media | image_url: width: 533 }} 533w,
            {{ card_product.featured_media | image_url: width: 720 }} 720w
          "
          src="{{ card_product.featured_media | image_url: width: 533 }}"
          sizes="(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw"
          alt="{{ card_product.featured_media.alt | default: card_product.title | escape }}"
          class="card-product__img card-product__img--primary"
          loading="lazy"
          width="{{ card_product.featured_media.width }}"
          height="{{ card_product.featured_media.height }}"
        >

        {%- if card_product.media[1] != blank and settings.show_secondary_image -%}
          <img
            srcset="
              {{ card_product.media[1] | image_url: width: 360 }} 360w,
              {{ card_product.media[1] | image_url: width: 533 }} 533w,
              {{ card_product.media[1] | image_url: width: 720 }} 720w
            "
            src="{{ card_product.media[1] | image_url: width: 533 }}"
            sizes="(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw"
            alt="{{ card_product.media[1].alt | default: card_product.title | escape }}"
            class="card-product__img card-product__img--secondary"
            loading="lazy"
            width="{{ card_product.media[1].width }}"
            height="{{ card_product.media[1].height }}"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="card-product__badges" style="position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2;">
      {%- if card_product.available == false and settings.show_sold_out_badge -%}
        <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif card_product.compare_at_price > card_product.price and settings.show_sale_badge -%}
        {%- assign discount = card_product.compare_at_price | minus: card_product.price -%}
        {%- assign percent_off = discount | times: 100 | divided_by: card_product.compare_at_price -%}
        <span class="badge badge--sale">
          {%- if settings.sale_badge_type == 'percentage' -%}
            -{{ percent_off }}%
          {%- elsif settings.sale_badge_type == 'amount' -%}
            {{ 'products.product.save_html' | t: amount: discount | money }}
          {%- else -%}
            {{ 'products.product.on_sale' | t }}
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>

    <!-- Quick Add Button Overlay -->
    {%- if settings.enable_quick_add and card_product.available -%}
      <div class="card-product__quick-add" style="position: absolute; bottom: 12px; left: 12px; right: 12px; z-index: 3;">
        {%- if card_product.has_only_default_variant -%}
          <product-form>
            {%- form 'product', card_product, class: 'product-form' -%}
              <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                name="add"
                class="button button--primary button--full-width card-quick-add-btn"
                style="padding: 10px 16px; font-size: 1.3rem; box-shadow: 0 4px 14px rgba(0,0,0,0.15);"
              >
                <span>{{ 'products.product.add_to_cart' | t }}</span>
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a
            href="{{ card_product.url }}"
            class="button button--secondary button--full-width"
            style="padding: 10px 16px; font-size: 1.3rem; background: #ffffff; color: #121212; border: none; box-shadow: 0 4px 14px rgba(0,0,0,0.15);"
          >
            {{ 'products.product.choose_options' | t }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Product Details -->
  <div class="card-product__info" style="padding-top: 14px; display: flex; flex-direction: column; flex-grow: 1; gap: 6px;">
    {%- if settings.show_vendor and card_product.vendor != blank -%}
      <div class="card-product__vendor" style="font-size: 1.2rem; color: #71717a; text-transform: uppercase; letter-spacing: 0.05em;">
        {{ card_product.vendor }}
      </div>
    {%- endif -%}

    <h3 class="card-product__title" style="font-size: 1.5rem; font-weight: 600; margin: 0; line-height: 1.3; min-height: 2.6em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-word;">
      <a href="{{ card_product.url }}" style="color: inherit; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-word;">
        {{ card_product.title | escape }}
      </a>
    </h3>

    <!-- Star Rating -->
    {%- if settings.show_rating -%}
      <div class="card-product__rating" style="display: flex; align-items: center; gap: 4px; color: #f59e0b; font-size: 1.2rem;">
        {% render 'icon', name: 'star' %}
        {% render 'icon', name: 'star' %}
        {% render 'icon', name: 'star' %}
        {% render 'icon', name: 'star' %}
        {% render 'icon', name: 'star' %}
        <span style="color: #71717a; margin-left: 2px;">(5.0)</span>
      </div>
    {%- endif -%}

    <!-- Color Swatches Preview -->
    {%- if settings.enable_color_swatches -%}
      {%- for option in card_product.options_with_values -%}
        {%- assign opt_name = option.name | downcase -%}
        {%- if opt_name contains 'color' or opt_name contains 'colour' -%}
          <div class="card-product__swatches" style="display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap;">
            {%- for value in option.values limit: 5 -%}
              <span
                class="card-product__swatch"
                title="{{ value | escape }}"
                style="width: 14px; height: 14px; border-radius: 50%; border: 1px solid #d4d4d8; background-color: {{ value | downcase | remove: ' ' }}; display: inline-block;"
              ></span>
            {%- endfor -%}
            {%- if option.values.size > 5 -%}
              <span style="font-size: 1.1rem; color: #71717a;">+{{ option.values.size | minus: 5 }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    <!-- Price -->
    <div style="margin-top: auto; padding-top: 4px;">
      {% render 'price', product: card_product, show_badges: false %}
    </div>
  </div>
</div>

<style>
  .card-product__img--secondary {
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-product:hover .card-product__img--secondary {
    opacity: 1;
  }
  .card-product__quick-add {
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-product:hover .card-product__quick-add,
  .card-product:focus-within .card-product__quick-add {
    opacity: 1;
    transform: translateY(0);
  }
</style>
