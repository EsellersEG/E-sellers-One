{%- comment -%}
  Blog Post Card Snippet - E-sellers Professional (v4.9.0)
  Accepts:
  - article: {Object} Shopify Article Liquid object (optional, renders placeholder if blank)
  - featured: {Boolean} If true, applies featured card layout/styles
  - show_image: {Boolean} default: true
  - image_ratio: {String} 'natural' | 'portrait' | 'square' | 'landscape' (default: 'landscape')
  - show_category: {Boolean} default: true
  - show_date: {Boolean} default: true
  - show_author: {Boolean} default: false
  - show_comments_count: {Boolean} default: false
  - show_read_time: {Boolean} default: true
  - show_excerpt: {Boolean} default: true
  - excerpt_length: {Number} default: 24
  - show_read_more: {Boolean} default: true
  - read_more_text: {String} default: 'Read more'
  - card_style: {String} 'boxed' | 'flat' (default: 'boxed')
  - background: {Color} Card background (optional)
  - text_color: {Color} Card text color (optional)
  - sizes: {String} Image sizes attribute
{%- endcomment -%}

{%- liquid
  assign show_image = show_image | default: true, allow_false: true
  assign image_ratio = image_ratio | default: 'landscape'
  assign card_style = card_style | default: 'boxed'
  assign read_more_text = read_more_text | default: 'Read article'

  comment
    aspect-ratio carries the sizing on its own; no padding-top hack needed.
  endcomment
  case image_ratio
    when 'portrait'
      assign aspect_ratio = '3 / 4'
    when 'square'
      assign aspect_ratio = '1 / 1'
    when 'landscape'
      assign aspect_ratio = '16 / 9'
    else
      if article.image
        assign aspect_ratio = article.image.aspect_ratio
      else
        assign aspect_ratio = '16 / 9'
      endif
  endcase

  if article != blank
    assign words = article.content | strip_html | split: ' ' | size
    assign read_time = words | divided_by: 200 | at_least: 1
  else
    assign read_time = 3
  endif
-%}

<article
  class="es-blog-card es-blog-card--{{ card_style }}{% if featured %} es-blog-card--featured{% endif %}"
  {% if background != blank or text_color != blank %}
    style="{% if background != blank %}--es-card-bg: {{ background }};{% endif %}{% if text_color != blank %}--es-card-text: {{ text_color }};{% endif %}"
  {% endif %}
>
  {%- if show_image -%}
    <div class="es-blog-card__media-wrapper" style="--es-aspect-ratio: {{ aspect_ratio }};">
      <a href="{{ article.url | default: '#' }}" class="es-blog-card__media-link" aria-label="{{ article.title | default: 'Blog post title' | escape }}" tabindex="-1">
        {%- if article.image != blank -%}
          {%- assign es_tagarg_1 = sizes | default: '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 100vw' -%}{{- article.image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            sizes: es_tagarg_1,
            widths: '300, 400, 500, 600, 800, 1000, 1200',
            class: 'es-blog-card__image'
          -}}
        {%- else -%}
          <div class="es-blog-card__placeholder">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
        {%- endif -%}
      </a>

      {%- if show_category and article.tags.size > 0 -%}
        <div class="es-blog-card__badges">
          <span class="es-blog-card__badge">{{ article.tags.first | escape }}</span>
        </div>
      {%- elsif show_category and article == blank -%}
        <div class="es-blog-card__badges">
          <span class="es-blog-card__badge">Articles</span>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="es-blog-card__content">
    {%- if show_date or show_author or show_read_time or show_comments_count -%}
      <div class="es-blog-card__meta">
        {%- if show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="es-blog-card__meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{{ article.published_at | default: 'now' | date: format: 'abbreviated_date' }}</span>
          </time>
        {%- endif -%}

        {%- if show_read_time -%}
          <span class="es-blog-card__meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{{ read_time }} min read</span>
          </span>
        {%- endif -%}

        {%- if show_author -%}
          <span class="es-blog-card__meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>{{ article.author | default: shop.name }}</span>
          </span>
        {%- endif -%}

        {%- if show_comments_count and article.comments_count > 0 -%}
          <span class="es-blog-card__meta-item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>{{ article.comments_count }}</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <h3 class="es-blog-card__title">
      <a href="{{ article.url | default: '#' }}" class="es-blog-card__title-link">
        {%- if article.title != blank -%}
          {{ article.title | escape }}
        {%- else -%}
          Sample blog post title showcasing your store stories
        {%- endif -%}
      </a>
    </h3>

    {%- if show_excerpt -%}
      <div class="es-blog-card__excerpt">
        {%- if article.excerpt_or_content != blank -%}
          {{ article.excerpt_or_content | strip_html | truncatewords: excerpt_length | default: 24 }}
        {%- else -%}
          Share news, product updates, how-to guides, and stories directly with your customers.
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_read_more -%}
      <div class="es-blog-card__action">
        <a href="{{ article.url | default: '#' }}" class="es-blog-card__read-more">
          <span>{{ read_more_text }}</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</article>
