{%- comment -%}
  Universal Section Style Helper Snippet (es-section-style.liquid)
  Generates responsive scoped CSS rules and variables for sections.
  Supports:
    - Backgrounds (Solid color, gradients, opacity, image)
    - Responsive Spacing (Padding top/bottom/left/right desktop, tablet, mobile)
    - Borders & Corner Radii
    - Shadows
    - Responsive Visibility (Hide on desktop, tablet, mobile)
    - Custom CSS injection
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings

  # Background options
  assign bg_color = s.bg_color | default: 'transparent'
  assign bg_gradient = s.bg_gradient | default: ''
  assign text_color = s.text_color | default: ''

  # Spacing Desktop
  assign pt_desktop = s.padding_top | default: 0
  assign pb_desktop = s.padding_bottom | default: 0
  assign mt_desktop = s.margin_top | default: 0
  assign mb_desktop = s.margin_bottom | default: 0

  # Spacing Tablet
  assign pt_tablet = s.padding_top_tablet | default: pt_desktop
  assign pb_tablet = s.padding_bottom_tablet | default: pb_desktop

  # Spacing Mobile
  assign pt_mobile = s.padding_top_mobile | default: pt_desktop
  assign pb_mobile = s.padding_bottom_mobile | default: pb_desktop
  assign mt_mobile = s.margin_top_mobile | default: mt_desktop
  assign mb_mobile = s.margin_bottom_mobile | default: mb_desktop

  # Border & Radius
  assign border_color = s.border_color | default: 'transparent'
  assign border_width = s.border_width | default: 0
  assign border_radius = s.border_radius | default: 0

  # Container Max Width
  assign container_width = s.container_width | default: 'container'
-%}

<style>
  #shopify-section-{{ sid }} {
    {%- if s.hide_on_desktop -%}
      @media screen and (min-width: 1025px) {
        display: none !important;
      }
    {%- endif -%}
    {%- if s.hide_on_tablet -%}
      @media screen and (min-width: 768px) and (max-width: 1024px) {
        display: none !important;
      }
    {%- endif -%}
    {%- if s.hide_on_mobile -%}
      @media screen and (max-width: 767px) {
        display: none !important;
      }
    {%- endif -%}
  }

  .section-{{ sid }}-settings {
    /* Backgrounds & Colors */
    {%- if bg_gradient != blank -%}
      background: {{ bg_gradient }};
    {%- elsif bg_color != blank and bg_color != 'transparent' -%}
      background-color: {{ bg_color }};
    {%- endif -%}

    {%- if text_color != blank -%}
      color: {{ text_color }};
      --color-text-custom: {{ text_color }};
    {%- endif -%}

    /* Borders & Radius */
    {%- if border_width > 0 -%}
      border-top: {{ border_width }}px solid {{ border_color }};
      border-bottom: {{ border_width }}px solid {{ border_color }};
    {%- endif -%}
    {%- if border_radius > 0 -%}
      border-radius: {{ border_radius }}px;
    {%- endif -%}

    /* Desktop Spacing */
    padding-top: {{ pt_desktop }}px;
    padding-bottom: {{ pb_desktop }}px;
    margin-top: {{ mt_desktop }}px;
    margin-bottom: {{ mb_desktop }}px;
  }

  /* Tablet Spacing */
  @media screen and (max-width: 1024px) {
    .section-{{ sid }}-settings {
      padding-top: {{ pt_tablet }}px;
      padding-bottom: {{ pb_tablet }}px;
    }
  }

  /* Mobile Spacing */
  @media screen and (max-width: 767px) {
    .section-{{ sid }}-settings {
      padding-top: {{ pt_mobile }}px;
      padding-bottom: {{ pb_mobile }}px;
      margin-top: {{ mt_mobile }}px;
      margin-bottom: {{ mb_mobile }}px;
    }
  }

  /* Custom Section CSS */
  {%- if s.custom_css != blank -%}
    {{ s.custom_css }}
  {%- endif -%}
</style>
