{%- comment -%}
  Horizontal Product Snippet - E-sellers Professional (v4.9.0)

  Compact product row: thumbnail, title, price, chevron. Used by overlay
  surfaces such as shop-the-look hot spots and quick-view panels.

  Accepts:
  - product: {Object} Shopify Product Liquid object
  - size: {String} 'sm' | 'md' (default: 'sm')
  - output_link: {Boolean} wrap the row in a link to the product (default: true)
{%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign hp_size = size | default: 'sm'
    assign hp_thumb = 50
    if hp_size == 'md'
      assign hp_thumb = 64
    endif

    comment
      image_tag named arguments cannot take piped filters, so the alt text is
      resolved up front rather than inline.
    endcomment
    assign hp_alt = product.featured_image.alt | default: product.title | escape

    assign hp_tag = 'div'
    assign hp_href = ''
    unless output_link == false
      assign hp_tag = 'a'
      assign hp_href = product.url
    endunless
  -%}

  <{{ hp_tag }}
    {% if hp_href != blank %}href="{{ hp_href }}"{% endif %}
    class="es-horizontal-product es-horizontal-product--{{ hp_size }}"
    style="display:flex;align-items:center;gap:12px;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);padding:10px 14px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.12);color:#0f172a;text-decoration:none;"
  >
    <span
      class="es-horizontal-product__image-wrapper"
      style="width:{{ hp_thumb }}px;height:{{ hp_thumb }}px;border-radius:8px;overflow:hidden;background:#f1f5f9;flex-shrink:0;display:block;"
    >
      {%- if product.featured_image != blank -%}
        {{ product.featured_image
          | image_url: width: 160
          | image_tag:
            loading: 'lazy',
            alt: hp_alt,
            style: 'width:100%;height:100%;object-fit:cover;'
        }}
      {%- endif -%}
    </span>

    <span class="es-horizontal-product__details" style="flex:1;min-width:0;display:block;">
      <span
        class="es-horizontal-product__title"
        style="display:block;font-size:1.4rem;font-weight:600;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:inherit;"
      >
        {{- product.title | escape -}}
      </span>
      <span
        class="es-horizontal-product__price"
        style="display:block;font-size:1.3rem;font-weight:700;color:#0f172a;margin-top:2px;"
      >
        {{ product.price | money }}
        {%- if product.compare_at_price > product.price -%}
          <s style="color:#94a3b8;font-size:1.2rem;margin-left:4px;">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
    </span>

    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      style="color:#64748b;flex-shrink:0;"
      aria-hidden="true"
    >
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </{{ hp_tag }}>
{%- endif -%}
