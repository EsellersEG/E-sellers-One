{%- comment -%}
  Cart Icon Bubble Snippet - E-sellers Professional (v4.9.0)
{%- endcomment -%}

<span class="header__cart-icon-wrapper" style="position: relative; display: inline-flex; align-items: center; justify-content: center;">
  {%- if cart == empty -%}
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-cart-empty">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon icon-cart-full">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
      <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
    </svg>
  {%- endif -%}

  <span class="visually-hidden">{{ 'templates.cart.cart' | t | default: 'Cart' }}</span>

  {%- if cart.item_count > 0 -%}
    <span class="cart-count-bubble" aria-label="{{ cart.item_count }} items in cart">
      {%- if cart.item_count < 100 -%}
        <span aria-hidden="true">{{ cart.item_count }}</span>
      {%- else -%}
        <span aria-hidden="true">99+</span>
      {%- endif -%}
      <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count | default: cart.item_count }}</span>
    </span>
  {%- endif -%}
</span>
