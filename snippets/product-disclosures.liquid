{%- comment -%}
  Product Disclosures / Accordion Snippet - E-sellers Professional (v4.9.0)
  Accepts:
  - product: {Object} Shopify Product Liquid object
  - heading: {String}
  - heading_size: {String}
  - open_by_default: {Boolean}
  - blocks: {Array} Blocks list (optional)
{%- endcomment -%}

<div class="es-product-disclosures">
  {%- if heading != blank -%}
    <h2 class="es-product-disclosures__heading {{ heading_size | default: 'h2' }}" style="font-weight: 700; margin-bottom: 24px; font-size: clamp(1.4rem, 2.5vw, 2rem);">
      {{ heading | escape }}
    </h2>
  {%- endif -%}

  <div class="es-product-disclosures__list" style="display: flex; flex-direction: column; gap: 12px;">
    {%- if blocks.size > 0 -%}
      {%- for block in blocks -%}
        {%- assign tab_title = block.settings.heading | default: block.settings.title | default: 'Product details' -%}
        {%- assign tab_content = block.settings.content | default: block.settings.page.content -%}

        {%- if tab_title != blank and tab_content != blank -%}
          <details
            class="es-disclosure-item"
            {% if forloop.first and open_by_default %}open{% endif %}
            style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff; transition: box-shadow 0.2s ease;"
            {{ block.shopify_attributes }}
          >
            <summary class="es-disclosure-item__summary" style="padding: 16px 20px; font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; user-select: none; background: #fafbfd;">
              <span style="display: flex; align-items: center; gap: 10px;">
                {%- if block.settings.icon != blank -%}
                  <span class="es-disclosure-item__icon">{{ block.settings.icon }}</span>
                {%- endif -%}
                {{ tab_title | escape }}
              </span>
              <svg class="es-disclosure-item__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.25s ease;">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="es-disclosure-item__content" style="padding: 20px; font-size: 0.95rem; line-height: 1.6; color: #334155; border-top: 1px solid #f1f5f9;">
              {{ tab_content }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Default fallback tabs using product details {%- endcomment -%}
      {%- if product.description != blank -%}
        <details class="es-disclosure-item" {% if open_by_default %}open{% endif %} style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff;">
          <summary class="es-disclosure-item__summary" style="padding: 16px 20px; font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; user-select: none; background: #fafbfd;">
            <span>Description</span>
            <svg class="es-disclosure-item__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="es-disclosure-item__content" style="padding: 20px; font-size: 0.95rem; line-height: 1.6; color: #334155; border-top: 1px solid #f1f5f9;">
            {{ product.description }}
          </div>
        </details>
      {%- endif -%}

      <details class="es-disclosure-item" style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff;">
        <summary class="es-disclosure-item__summary" style="padding: 16px 20px; font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; user-select: none; background: #fafbfd;">
          <span>Shipping & Returns</span>
          <svg class="es-disclosure-item__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="es-disclosure-item__content" style="padding: 20px; font-size: 0.95rem; line-height: 1.6; color: #334155; border-top: 1px solid #f1f5f9;">
          <p>Orders are dispatched within 24-48 business hours. We offer hassle-free 30-day returns on all unused items in original packaging.</p>
        </div>
      </details>

      <details class="es-disclosure-item" style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff;">
        <summary class="es-disclosure-item__summary" style="padding: 16px 20px; font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; user-select: none; background: #fafbfd;">
          <span>Materials & Care</span>
          <svg class="es-disclosure-item__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="es-disclosure-item__content" style="padding: 20px; font-size: 0.95rem; line-height: 1.6; color: #334155; border-top: 1px solid #f1f5f9;">
          <p>Crafted with premium grade components designed for durability. Wipe clean with a soft damp cloth.</p>
        </div>
      </details>
    {%- endif -%}
  </div>
</div>
