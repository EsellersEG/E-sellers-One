{%- comment -%}
  Testimonial Card Item Snippet
  Accepts: block, section
{%- endcomment -%}

{%- liquid
  assign b = block.settings
-%}

<div class="es-card-luxury flex flex-col h-full bg-[var(--card-bg)] text-[var(--card-text)] border border-[var(--card-border)] rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
  <!-- Star Rating -->
  <div class="flex items-center gap-1 mb-4 text-[var(--star-color)]">
    {%- for i in (1..b.stars) -%}
      <span class="material-symbols-outlined text-base fill-1" style="font-variation-settings: 'FILL' 1;">star</span>
    {%- endfor -%}
  </div>

  <!-- Review Quote -->
  <blockquote class="text-sm md:text-base text-[var(--card-text)] opacity-90 leading-relaxed font-light mb-6 flex-grow italic">
    “{{ b.review_text }}”
  </blockquote>

  <!-- Author Info -->
  <div class="pt-4 border-t border-[var(--card-border)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <div class="font-serif font-medium text-sm text-[var(--card-text)]">
        {{ b.author }}
      </div>
      {%- if b.location != blank -%}
        <div class="text-xs text-[var(--card-text)] opacity-60">
          {{ b.location }}
        </div>
      {%- endif -%}
    </div>

    {%- if b.verified_badge != blank -%}
      <div class="self-start sm:self-auto">
        <span class="inline-flex items-center gap-1 text-[11px] font-medium text-[#7A3E2D] bg-[#F2E8DC] px-2.5 py-1 rounded-full">
          <span class="material-symbols-outlined text-xs">verified</span>
          {{ b.verified_badge }}
        </span>
      </div>
    {%- endif -%}
  </div>
</div>
