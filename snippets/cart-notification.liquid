{%- comment -%}
  Cart Notification Modal / Toast Snippet - E-sellers Professional (v4.9.0)
{%- endcomment -%}

<cart-notification id="cart-notification" class="cart-notification" aria-modal="true" role="dialog" tabindex="-1" style="display: none;">
  <div class="cart-notification__wrapper" style="position: fixed; top: 20px; right: 20px; z-index: 1000; width: 100%; max-width: 400px; background: #ffffff; border-radius: 12px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); border: 1px solid #e2e8f0; padding: 20px; overflow: hidden;">
    <div class="cart-notification__header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <h3 class="cart-notification__heading" style="font-size: 0.95rem; font-weight: 700; color: #059669; display: flex; align-items: center; gap: 6px; margin: 0;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Item added to your cart
      </h3>
      <button type="button" class="cart-notification__close" aria-label="Close" style="background: none; border: none; cursor: pointer; color: #64748b; padding: 4px;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="cart-notification-product" class="cart-notification__body">
      {% render 'cart-notification-product' %}
    </div>

    <div class="cart-notification__actions" style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px;">
      <a href="{{ routes.cart_url }}" class="btn btn--secondary" style="display: block; text-align: center; padding: 10px 16px; border: 1px solid #cbd5e1; border-radius: 6px; text-decoration: none; font-weight: 600; color: #0f172a;">
        {{ 'general.cart.view' | t: count: cart.item_count | default: 'View cart' }}
      </a>
      <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form">
        <button type="submit" name="checkout" class="btn btn--primary" style="width: 100%; padding: 12px 16px; background: #0f172a; color: #ffffff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer;">
          {{ 'sections.cart.checkout' | t | default: 'Check out' }}
        </button>
      </form>
    </div>
  </div>
</cart-notification>
