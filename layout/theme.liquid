    </script>
    {{ 'es-milkshake.css' | asset_url | stylesheet_tag }}
    {%- if settings.cart_type == 'drawer' -%}
      {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: '{{ routes.root_url }}',
          cart: '{{ routes.cart_url }}',
          cart_add: '{{ routes.cart_add_url }}',
          cart_change: '{{ routes.cart_change_url }}',
          cart_update: '{{ routes.cart_update_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        },
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }}
      };
    </script>

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {%- comment -%}
      Single source of JSON-LD for the whole storefront. The snippet branches on
      request.page_type internally and covers Organization, WebSite, Product and
      Article, so nothing else should emit those entities.
    {%- endcomment -%}
    {% render 'schema-structured-data' %}

    {{ content_for_header }}
  </head>

  {%- comment -%}
    These attributes drive the design system's global scales. Changing one
    retunes spacing, geometry, depth or motion across every section at once.
  {%- endcomment -%}
  <body
    class="template-{{ template.name | handle }}"
    data-es-density="{{ settings.es_density | default: 'comfortable' }}"
    data-es-geometry="{{ settings.es_geometry | default: 'soft' }}"
    data-es-elevation="{{ settings.es_elevation | default: 'raised' }}"
    data-es-motion="{{ settings.es_motion | default: 'subtle' }}"
  >
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_text' | t }}
    </a>

    {%- comment -%}
      The overlay header is only appropriate where the first section is a
      full-bleed hero, so it is opt-in per theme settings and limited to the
      templates chosen there. Everything else uses the standard header group.
    {%- endcomment -%}
    {%- liquid
      assign use_overlay_header = false
      if settings.overlay_header_templates != blank
        assign overlay_templates = settings.overlay_header_templates | split: ','
        for overlay_template in overlay_templates
          assign wanted = overlay_template | strip
          if wanted != blank and template.name == wanted
            assign use_overlay_header = true
            break
          endif
        endfor
      endif
    -%}

    {%- unless template.name == 'index' -%}
      {%- if use_overlay_header -%}
        {% section 'es-header-home' %}
      {%- else -%}
        {% sections 'header-group' %}
      {%- endif %}
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- unless template.name == 'index' -%}
      {% sections 'footer-group' %}
    {%- endunless -%}
    {% sections 'overlay-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.loading' | t }}</li>
    </ul>
  </body>
</html>
